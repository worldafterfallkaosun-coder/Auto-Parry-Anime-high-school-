-- uji tiap jalur cap dengan render 3D dimatikan sementara (biar GPU tidak jadi penghambat)
function K.capProbe()
    if BOOST.probing then return end
    BOOST.probing = true
    say("warn", "Uji cap FPS: layar hitam sebentar (sekitar 15 dtk)")
    task.spawn(function()
        pcall(function() RunService:Set3dRenderingEnabled(false) end)
        local list = { "setfpscap", "fflag", "setelan" }
        local function measure()
            task.wait(1.2)
            FT.buf, FT.n = {}, 0
            task.wait(2.3)
            local st = K.fpsStats()
            return st and st.hi or 0
        end
        for _, m in ipairs(list) do K.capMethod(m, 60) end
        local res = { base = measure() }
        for _, m in ipairs(list) do
            if K.capAvail(m) then
                K.capMethod(m, 240)
                res[m] = measure()
                K.capMethod(m, 60)
            end
        end
        pcall(function() RunService:Set3dRenderingEnabled(not BOOST.render3d) end)
        BOOST.probe, BOOST.probing = res, false
        if S.bst.unlock then K.setCap() end
        local best, bv = nil, res.base
        for _, m in ipairs(list) do
            if res[m] and res[m] > bv * 1.15 and res[m] > 66 then best, bv = m, res[m] end
        end
        BOOST.best = best
        if best then
            say("ok", "Uji cap: jalur " .. best .. " berhasil membuka batas (" .. math.floor(bv + 0.5) .. " FPS)")
        else
            say("err", "Uji cap: semua jalur tertahan ~" .. math.floor(res.base + 0.5) .. " FPS. Batas ini dari perangkat atau Roblox, bukan dari script.")
        end
    end)
end
