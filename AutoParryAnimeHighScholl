local function optAutoStep(v)
    if v == math.floor(v) and math.abs(v) >= 2 then return 1 end
    local a = math.abs(v)
    if a >= 1 then return 0.1 elseif a >= 0.1 then return 0.01 elseif a >= 0.02 then return 0.005 end
    return 0.001
end
function K.optRange(def)
    local a = math.abs(def)
    local hi
    if def == math.floor(def) and a >= 2 then hi = math.max(10, a * 3)
    elseif a < 0.05 then hi = 0.25
    elseif a < 0.5 then hi = 1
    elseif a < 5 then hi = math.max(5, a * 2)
    else hi = a * 3 end
    return (def < 0) and -hi or 0, hi, optAutoStep(def)
end
function K.optItem(parent, k)
    local def = AP.Store.defaults[k]
    local t = type(def)
    local hint = OPT_DESC[k]
    if t == "boolean" then
        W.toggle(parent, k, hint, K.pbool(k))
    elseif t == "number" then
        local mn, mx, step = K.optRange(def)
        W.slider(parent, k, mn, mx, step, "", K.pnum(k))
        if hint then
            local l = label(parent, hint, 10.5, TH.mute, FS, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, LayoutOrder = nextLO() })
            padd(l, 0, 0, 6, 0)
        end
    elseif t == "string" then
        local labels = OPT_ENUM[k]
        if labels then
            W.row(parent, k, hint)
            W.seg(parent, labels, K.pstr(k, labels))
        end
    end
end


