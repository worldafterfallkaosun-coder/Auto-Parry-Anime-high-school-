function SK.live(now)
    local gl = gameLock()
    local rdy = math.max(readyAt, lockedUntil, dodgeBlockUntil, gl or -math.huge) - now
    local r1 = ("block %s · tunggu %.2fs · parry-cd %.2fs"):format(
        blockHeld and "NYALA" or "mati", math.max(rdy, 0), math.max(parriedAt + SR.ParryCooldown - now, 0)
    )
    local r2 = ("dodge siap %.1fs · rtt %.0f±%.0fms · %.0ffps p90 %.0fms"):format(
        dodgeWait(now), net.rtt * 1000, net.var * 1000, frame.fps, frame.p90 * 1000
    )
    local w = whyLog[#whyLog]
    local r3 = "kena terakhir: belum ada"
    if w then
        r3 = ("kena %.0fs lalu: %s · %s · %s %s"):format(
            now - w.t, w.kind, tostring(w.why), tostring(w.st or "?"), w.dist and ("%.0fst"):format(w.dist) or ""
        )
    end
    local e = EV.count > 0 and EV.ring[(EV.head - 1) % EV.cap + 1] or nil
    local r4 = e and ("event %.1fs lalu: %s · %s"):format(now - e.t, e.kind, e.text) or "event: -"
    return r1, r2, r3, r4, (w and (now - w.t) < 3) and true or false
end

-- v11.3: semuanya jadi satu teks buat disalin
function SK.dump()
    local now = os.clock()
    local out = {}
    local function add(s)
        out[#out + 1] = s
    end
    add("== AutoParry live dump · v13.6 ==")
    add(summaryText())
    local r1, r2 = SK.live(now)
    add(r1)
    add(r2)
    add("-- STYLE (pengenal v12) --")
    for ch, st in pairs(SK.iqState) do
        if typeof(ch) == "Instance" and ch.Parent and st.name ~= nil then
            add(("%s: %s [%s] atribut=%s bukti=%.1f"):format(ch.Name, tostring(st.name), tostring(st.src), tostring(st.raw), st.bestS or 0))
        end
    end
    for name, s in pairs(SK.m2s) do
        add(("M2 %s: parry %.0f/%.0f dodge %.0f/%.0f"):format(name, s.pOk, s.pN, s.dOk, s.dN))
    end
    add("-- KENA: " .. #whyLog .. " terakhir (paling baru di bawah) --")
    for i = 1, #whyLog do
        local w = whyLog[i]
        add(
            ("%.1fs lalu | %s dari %s combo %d | alasan: %s | style %s jarak %s event %s | rtt %.0fms fps %.0f | block %s kunci %.2fs stun %.2fs sent %s slack %.2f%s"):format(
                now - w.t, w.kind, w.who, w.combo, tostring(w.why), tostring(w.st or "?"),
                w.dist and ("%.1f"):format(w.dist) or "?", w.sw and ("%.2fs lalu"):format(w.sw) or "nggak ada",
                w.rtt * 1000, w.fps, w.held and "nyala" or "mati", w.locked, w.stun, tostring(w.sent), w.slack,
                (w.pa and w.pa < 2.0) and (" | %.2fs abis LU parry"):format(w.pa)
                    or ((w.bp and w.bp < 2.0) and (" | %.2fs abis LU ke-parry"):format(w.bp) or "")
            )
        )
    end
    add("-- EVENT: " .. EV.count .. " terakhir (paling baru di bawah) --")
    for age = EV.count - 1, 0, -1 do
        local e = EV.ring[(EV.head - age - 1) % EV.cap + 1]
        if e then
            add(("%.1fs lalu | %s | %s"):format(now - e.t, e.kind, e.text))
        end
    end
    local names = {}
    for k in pairs(skips) do
        names[#names + 1] = k
    end
    table.sort(names)
    local parts = {}
    for _, k in ipairs(names) do
        parts[#parts + 1] = k .. "=" .. tostring(skips[k])
    end
    add("-- SKIP: " .. (#parts > 0 and table.concat(parts, " ") or "-"))
    return table.concat(out, "\n")
end

