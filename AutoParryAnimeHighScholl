local frameErrShown = false -- v5: error per-frame cuma di-print sekali (biar console nggak banjir)
-- v5: dipanggil tiap frame lewat pcall(frameTick, ...) -> nggak bikin closure baru tiap frame
local lastPush = -math.huge
local function frameTick(dt, now)
	trackFrame(dt)
	sampleNet(now)
	if not CFG.Enabled then
		return
	end

	-- riwayat posisi (dicatat cuma pas script ON, max ~125x per detik)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp ~= histOwner then
		histOwner = hrp
		hCount = 0
	end
	if hrp and now - lastPush >= 0.008 then
		if now - lastPush > 0.5 then
			hCount = 0 -- riwayat lama (script baru nyala lagi) jangan dipakai
		end
		lastPush = now
		pushPos(now, hrp.Position)
	end

	-- v6: samain status block lokal sama server (10x per detik, cuma kalau block lagi nyala)
	if blockHeld and now - lastSync >= 0.1 then
		lastSync = now
		syncBlock(now, char)
	end
end

