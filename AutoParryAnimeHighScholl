	end
end

local function fireDodge(attacker, plan)
	local now = os.clock()
	local char = LocalPlayer.Character
	if not char then
		return false
	end
	if dodgeWait(now) > 0.02 then
		trace("dodge gagal: belum siap (cooldown/busy/stun)")
		return false
	end
	if not blockHeld and char:GetAttribute("Blocking") == true and (now - lastOwnOff) > net.rtt + 0.2 then
		trace("dodge gagal: lu lagi nahan block manual")
		return false
	end
	local d = dashOf()

	-- server nolak Dodge kalau masih Blocking -> lepas block kita dulu (OFF sampai duluan, urutan remote terjaga)
	if blockHeld then
		cancel(releaseHandle)
		sendBlock(false)
		blockHeld = false
		readyAt = now + SR.BlockCooldown
		counters.released += 1
		trace("block dilepas buat dodge")
	end

	-- v12: pilih arah dodge (ikut arah gerak lu / arah aman terbaik), dipaksakan ke TryDodge lewat SK.ddCall
	local choice = nil
	if CFG.DodgeDir and CFG.DodgeDirMode ~= "Game" then
		local okP, res = pcall(SK.ddPick, attacker, plan, char)
		if okP then
			choice = res
		else
			trace("ddPick error:", tostring(res))
		end
	end

	local fired = false
	local h, L = dodgeLocal()
	if h then
		-- pakai fungsi dodge asli game: animasi + dorongan + state lokal ikut bener
		local before = L.DodgeReadyAt
		local ok, err = SK.ddCall(choice, h.TryDodge, h)
		if not ok then
			trace("TryDodge error:", tostring(err))
		elseif L.DodgeReadyAt ~= before then
			fired = true
		end
	else
		local dirName = CFG.DodgeDirection
		if choice and choice.relName and SK.dd.seen[choice.relName] then
			dirName = choice.relName -- cuma nama yang pernah dikirim game sendiri
		end
		Combat:FireServer({ Info = "Dodge", Direction = dirName, T = workspace:GetServerTimeNow() })
		fired = true
	end

	if not fired then
		trace("dodge ditolak game lokal")
		return false
	end
	dodgeSentAt = now
	dodgeReadyAt = now + d.Cooldown - 0.05
	dodgeBusyUntil = now + d.Duration
	lockedUntil = math.max(lockedUntil, now + d.Duration) -- Block ON ditolak server selama Busy
	counters.dodgesent += 1
	if choice then
		evt("info", ("dodge arah %s · %s"):format(tostring(choice.relName), tostring(choice.why)))
	end
	trace((h and "DODGE dikirim (game TryDodge)" or "DODGE dikirim (remote langsung)"))
	return true
end

-- v5: hitung kemungkinan dodge tanpa jadwalin apa-apa. hasil: ok, sendIn, age, wait, dashInfo
local function dodgeProbe(lead, now, rtt, fl)
	local d = dashOf()
	-- v12: paket telat lebih sering daripada kecepetan -> target umur iframe digeser sedikit ke belakang sebanding noise
	local target = math.clamp(d.IFrames * CFG.DodgeAgeFrac + CFG.DodgeLateBias * sigmaNow(), 0.04, math.max(d.IFrames - 0.06, 0.05))
	local wait = dodgeWait(now, true)
	local sendIn = lead - target - rtt - fl + (math.random() * 2 - 1) * CFG.Jitter
	if sendIn < wait then
		sendIn = wait
	end
	if sendIn < 0 then
		sendIn = 0
	end
	local age = lead - rtt - fl - sendIn -- berapa lama IFrames udah jalan pas hit mendarat
	local ok = age >= CFG.DodgeMinAge and age <= d.IFrames - CFG.DodgeEdge
	return ok, sendIn, age, wait, d
end

-- jadwalin dodge supaya hit mendarat di tengah IFrames. true = urusan hit ini udah ditangani
local function planDodge(attacker, plan, lead, now, rtt, fl, tag, why)
	if not (alive and CFG.DodgeEnabled) then
		return false
	end
	if plan.kind == "M2" and not CFG.DodgeForM2 then
		return false
	end
	if plan.kind == "M1" and not CFG.DodgeForM1 then
		return false
	end
	-- v5: dodge itu jatah langka (cd 2.25s) -> cuma dipakai buat ancaman yang pasti masuk hitbox
	if CFG.SmartMode and not reactSure then
		skip("dodge-unsure")
		return false
	end
	local ok, sendIn, age, wait, d = dodgeProbe(lead, now, rtt, fl)
	if not ok then
		if CFG.Trace then trace(
			("%s: dodge nggak mungkin (%s) age %.3f iframe %.2f tunggu %.2fs"):format(
				tag, tostring(why), age, d.IFrames, wait
			)
		) end
		skip(age < CFG.DodgeMinAge and "dodge-late" or "dodge-early")
		return false
	end

	local hitAt = now + lead
	local verdict = arbitrate(plan.kind, hitAt, now)
	if verdict ~= "ok" then
		skip(verdict)
		return true -- hit ini udah ditutup rencana lain
	end

	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	counters.dodgeplanned += 1
	if CFG.LogEvents then
		pushEv("plan", ("%s %s -> dodge lead %.2f kirim +%.2f"):format(tag, nameOf(attacker), lead, sendIn))
	end
	dodgePlannedUntil = now + sendIn + d.Cooldown - 0.05
	dodgeBlockUntil = math.max(dodgeBlockUntil, now + sendIn + d.Duration)
	noteExpected(attacker, hitAt, now, "DODGE")
	guardSwing(attacker, now + sendIn, hitAt)
	if CFG.Trace then trace(
		("%s dari %s: DODGE (%s) lead %.3f rtt %.3f -> kirim %.3fs lagi (umur iframe %.3f)"):format(
			tag, attacker.Name, tostring(why), lead, rtt, sendIn, age
		)
	) end
	local rec = { kind = "DODGE", hit = hitAt, done = false }
	pending[#pending + 1] = rec
	rec.handle = schedule(now + sendIn, function()
		rec.done = true
		if not alive or not CFG.Enabled then
			return
		end
		if planToken[attacker] ~= tok then
			counters.cancelled += 1
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
			return
		end
		-- v9: attacker udah mati / knocked -> jatah dodge (cd 2.25s) jangan dibuang
		if CFG.RecheckAttacker and attackerGone(attacker) then
			counters.cancelled += 1
			counters.recheck += 1
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
			skip("attacker-gone")
			return
		end
		-- v5: cek ulang sebelum buang jatah dodge: attacker masih ngincer lu?
		if CFG.SmartMode then
			local c2, h2 = myState()
			if c2 and h2 then
				-- v11.4: batalin dodge cuma kalau attacker beneran udah jauh. Dulu cek hitbox sempit -> M2 yang tetap mendarat
				-- (dump: "dodge-recheck" lalu KENA M2 Toji) lolos tanpa dodge DAN tanpa parry.
				local okT, dT = threatens(attacker, h2, plan, math.max(hitAt - os.clock(), 0))
				if not okT and dT > CFG.DodgeRecheckDist then
					counters.cancelled += 1
					dodgePlannedUntil = 0
					dodgeBlockUntil = 0
					skip("dodge-recheck")
					return
				end
			end
		end
		if not fireDodge(attacker, plan) then
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
		end
	end)
	return true
end

