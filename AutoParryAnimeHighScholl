					UI.gui:Destroy()
				end)
				UI.gui = nil
			end
		end,
	}

	task.spawn(loadSpecs)
	task.spawn(function()
		for _ = 1, 60 do
			if not alive or installSwingHook() then
				return
			end
			task.wait(0.5)
		end
	end)

	if CFG.UI then
		task.spawn(function()
			local okUI, errUI = pcall(buildUI)
			if not okUI then
				print("[AutoParry] UI gagal dibuat:", errUI)
			end
		end)
	end

	notify("v9.0 loaded - tekan " .. CFG.ToggleKey.Name .. " buat toggle")
	log("loaded v9.0. toggle:", CFG.ToggleKey.Name, "| panel:", CFG.UIKey.Name, "| getgenv().__NyxAutoParry.Report() buat ringkasan")
end
