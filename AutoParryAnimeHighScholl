        TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true }, hold)
    corner(box, 10); stroke(box, WHITE, 1, 0.9); padd(box, 0, 10, 0, 10)

    W.seg(p, { "Semua", "Diubah", "Aktif" }, function() return st.mode end, function(i) st.mode = i; st.cap = 30; K.optRebuild() end)
    local info = label(p, "", 11, TH.mute, FS, { Size = UDim2.new(1, 0, 0, 14), LayoutOrder = nextLO() })
    local lst = W.card(p)
    local more = W.btn(p, "", "norm", function() st.cap = st.cap + 30; K.optRebuild() end,
        { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = nextLO(), TextSize = 12, Visible = false })

    local built, rstart = false, nil
    function K.optRebuild()
        if rstart then
            for i = #REF, rstart, -1 do table.remove(REF, i) end
        end
        for _, ch in ipairs(lst:GetChildren()) do
            if ch:IsA("GuiObject") then ch:Destroy() end
        end
        lst:SetAttribute("n", 0)
        rstart = #REF + 1
        local oldBT = BT
        BT = "opt"
        local q = st.q:lower()
        local shown, total = 0, 0
        local ok, err = pcall(function()
            if MOD.par.state ~= "ready" or not (AP and AP.Store) then return end
            local keys = {}
            for k, def in pairs(AP.Store.defaults) do
                local t = type(def)
                if not OPT_HIDE[k] and (t == "boolean" or t == "number" or (t == "string" and OPT_ENUM[k])) then keys[#keys + 1] = k end
            end
            table.sort(keys)
            for _, k in ipairs(keys) do
                local cur, def, hint = CFG13[k], AP.Store.defaults[k], OPT_DESC[k]
                local match = true
                if q ~= "" then
                    match = (k:lower():find(q, 1, true) ~= nil) or (hint ~= nil and hint:lower():find(q, 1, true) ~= nil)
                end
                if match and st.mode == 2 then match = cur ~= def end
                if match and st.mode == 3 then match = cur == true end
                if match then
                    total = total + 1
                    if shown < st.cap then shown = shown + 1; K.optItem(lst, k) end
                end
            end
        end)
        BT = oldBT
        if not ok then log("Opsi: " .. tostring(err):sub(1, 80), "err") end
        info.Text = string.format("%d opsi cocok · tampil %d", total, shown)
        more.Visible = total > shown
        more.Text = string.format("Tampilkan lebih banyak (+30) · sisa %d", total - shown)
    end

    track(box:GetPropertyChangedSignal("Text"):Connect(function()
        st.tok = st.tok + 1
        local my = st.tok
        task.delay(0.3, function()
            if alive and st.tok == my then st.q = box.Text; st.cap = 30; K.optRebuild() end
        end)
    end))
    reg(function()
        if not built and MOD.par.state == "ready" then built = true; K.optRebuild() end
    end)
end

