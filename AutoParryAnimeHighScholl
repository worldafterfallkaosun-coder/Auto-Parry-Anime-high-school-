-- statistik frame time: rata-rata, 1% low, terendah, tertinggi
function K.fpsStats()
    local c = #FT.buf
    if c < 30 then return nil end
    local arr, sum = {}, 0
    for i = 1, c do local d = FT.buf[i]; arr[i] = d; sum = sum + d end
    table.sort(arr)
    local lowN = math.max(1, math.floor(c * 0.01))
    local ls = 0
    for i = c - lowN + 1, c do ls = ls + arr[i] end
    local k10 = math.max(1, math.ceil(c * 0.1))
    return { avg = c / sum, min = 1 / math.max(arr[c], 1e-4), max = 1 / math.max(arr[1], 1e-4), low1 = lowN / math.max(ls, 1e-4), hi = 1 / math.max(arr[k10], 1e-4) }
end

