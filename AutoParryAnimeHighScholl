		if type(cs.BackHit) == "table" then
			SR.BackHit = {
				Enabled = cs.BackHit.Enabled == true,
				Angle = type(cs.BackHit.Angle) == "number" and cs.BackHit.Angle or 100,
			}
		end
		if type(cs.Dash) == "table" then
			SR.Dash.IFrames = type(cs.Dash.IFrames) == "number" and cs.Dash.IFrames or SR.Dash.IFrames
			SR.Dash.Duration = type(cs.Dash.Duration) == "number" and cs.Dash.Duration or SR.Dash.Duration
			SR.Dash.Cooldown = type(cs.Dash.Cooldown) == "number" and cs.Dash.Cooldown or SR.Dash.Cooldown
		end
	end

	local stat = tryRequire(gs:FindFirstChild("StatSettings"))
	if stat and type(stat.ReachInfluence) == "number" then
		Specs.reachInfl = stat.ReachInfluence
	end

	local fs = gs:FindFirstChild("FightingStyles")
	if fs then
		for _, child in ipairs(fs:GetChildren()) do
			local t = tryRequire(child)
			if t then
				Specs.styles[child.Name] = t
				Specs.count += 1
				local m1 = t.M1
				local sw = type(m1) == "table" and m1.Swings
				if type(sw) == "table" then
					for _, s in ipairs(sw) do
						if type(s) == "table" and type(s.Sound) == "string" then
							Specs.swingSound[s.Sound] = true
						end
					end
				end
			end
		end
	end
	-- v10: skill multi-hit (barrage). Stats.Hits / Stats.Interval / Stats.RequiredStyle / Stats.BreaksBlock
	if CFG.SkillAware then
		local sk = tryRequire(gs:FindFirstChild("Skills"))
		if sk then
			for name, def in pairs(sk) do
				local st = type(def) == "table" and def.Stats
				if type(st) == "table" and type(st.Hits) == "number" and st.Hits >= 2 and type(st.Interval) == "number" and st.Interval > 0 then
					Specs.barrages[#Specs.barrages + 1] = {
						name = tostring(name),
						style = st.RequiredStyle,
						hits = st.Hits,
						interval = st.Interval,
						breaks = st.BreaksBlock == true,
					}
				end
			end
		end
	end
	if CFG.Debug then log(("spec kebaca: %d style | parryWindow %.2f | blockCooldown %.2f"):format(Specs.count, SR.ParryWindow, SR.BlockCooldown)) end
end

local function styleOf(char)
	local name = char:GetAttribute("Style")
	if type(name) ~= "string" then
		name = SR.DefaultStyle
	end
	return Specs.styles[name] or Specs.styles[SR.DefaultStyle]
end

----------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------
local function myState()
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then
		return nil
	end
	return char, hrp
end

-- Server NGGAK nolak Block pas stamina abis, jadi StaminaExhausted sengaja nggak dicek.
local function cannotAct(char, attacker)
	if char:GetAttribute("InCombat") == false then
		-- v6: flag InCombat lu bisa telat nyala di awal fight; kalau attacker-nya aktif, tetap proses
		if not (CFG.IgnoreMyCombatFlag and typeof(attacker) == "Instance" and attacker:GetAttribute("InCombat") == true) then
			return "notincombat"
		end
	end
	if char:GetAttribute("Knocked") or char:GetAttribute("Ragdolled") or char:GetAttribute("Grappled") then
		return "ko"
	end
	return nil
end

-- v9: attacker udah nggak mungkin nge-hit lagi (mati / knocked / ragdoll / dicengkram / hilang)
local function attackerGone(a)
	if typeof(a) ~= "Instance" or not a.Parent then
		return true
	end
	local hum = a:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return true
	end
	if a:GetAttribute("Knocked") or a:GetAttribute("Ragdolled") or a:GetAttribute("Grappled") then
		return true
	end
	return false
end

local function holdAfter()
	return math.clamp(CFG.HoldAfterHit + 2 * net.var + frame.p90, 0.05, 0.30)
end

-- v11: tambahan pad (detik) buat kondisi jelek. 0 di ping <= 80ms + 60fps + jitter kecil; naik pelan kalau ping tinggi,
-- jitter gede, atau frame time jelek. Dipakai di ChainHold, tail abis parry, hold guard.
function SK.lagPad()
	if not CFG.LagAdaptive then
		return 0
	end
	local p = math.clamp((net.rtt - 0.08) * 0.5, 0, 0.18)
	local f = math.clamp((frame.avg - 1 / 60) * 3, 0, 0.10)
	local j = math.clamp((net.var - 0.012) * 1.5, 0, 0.08)
	return p + f + j
end

-- v11: ResultPad ikut melebar kalau jitter ping gede (event hasil hit nyampe telat -> block dulu keburu lepas sebelum hasilnya tau)
function SK.resPad()
	if not CFG.LagAdaptive then
		return 0
	end
	return math.min(net.var * 2, 0.06)
end

-- v5: estimasi noise timing (detik): jitter ping + kuantisasi frame + ketidakpastian asimetri jalur
local function sigmaNow()
	local v = net.var * 1.25
	local f = frame.avg * 0.45
	return math.sqrt(v * v + f * f + 0.012 * 0.012)
end

-- CDF normal baku (aproksimasi erf Abramowitz-Stegun 7.1.26)
local function cdf(z)
	local x = math.abs(z) / 1.41421356
	local t = 1 / (1 + 0.3275911 * x)
	local poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
	local e = 1 - poly * math.exp(-x * x)
	return z >= 0 and 0.5 * (1 + e) or 0.5 * (1 - e)
end

-- peluang umur block/iframe pas hit mendarat jatuh di dalam [0, width], kalau noise ~ N(0, sigma)
local function confWindow(age, width, sigma)
	sigma = math.max(sigma, 0.004)
	return cdf((width - age) / sigma) - cdf((0 - age) / sigma)
end

-- target umur block pas hit mendarat. M1: telat = kena damage, kecepetan = cuma Blocked,
-- jadi geser ke arah "lebih awal" sebanding noise. M2: tengah window (dua-duanya jelek).
local function targetAgeFor(isM2)
	local base = isM2 and CFG.TargetAgeM2 or CFG.TargetAgeM1
	if not CFG.SmartMode or isM2 then
		return base
	end
	local skew = math.min(sigmaNow() * 0.8, 0.04)
	return math.clamp(base + skew, 0.06, SR.ParryWindow - 0.07)
end

----------------------------------------------------------------------
-- BLOCK
----------------------------------------------------------------------
-- v7: lewat SetLocalBlocking asli game (Local.Blocking, animasi, walkspeed, BlockReadyAt lokal ikut bener; game juga
-- ngecek stun/busy/cooldown/InCombat pakai state-nya sendiri). Return false kalau game nolak ON secara lokal.
local function sendBlock(on)
	if not on then
		lastOwnOff = os.clock()
	end
	if CFG.UseGameBlock then
		local h = getHandler()
		local L = h and h.Local
		if type(L) == "table" and type(h.SetLocalBlocking) == "function" then
			if pcall(h.SetLocalBlocking, h, on) then
				if on then
					local L2 = h.Local
					if type(L2) ~= "table" or L2.Blocking ~= true then
						-- v8: cek lokal game nolak (state stun/busy lokalnya telat), padahal model kita (stun/cooldown/busy
						-- udah lewat) bilang server bakal nerima -> kirim remote langsung. Kalau server nolak, BlockRefused ngurus.
						if CFG.RawOnLocalRefuse then
							rawOn = true
							Combat:FireServer({ Info = "Block", On = true })
							return true
						end
						return false
					end
					rawOn = false
				elseif rawOn then
					rawOn = false
					Combat:FireServer({ Info = "Block", On = false })
				end
				return true
			end
		end
	end
	rawOn = false
	Combat:FireServer({ Info = "Block", On = on })
	return true
end

local function scheduleRelease(at)
	releaseAt = at
	cancel(releaseHandle)
	releaseHandle = schedule(at, function()
		if not blockHeld then
			return
		end
		sendBlock(false)
		blockHeld = false
		-- server: BlockReadyAt = waktu Block OFF + BlockCooldown
		readyAt = os.clock() + SR.BlockCooldown
	end)
end

local function pressBlock(hold)
	local now = os.clock()
	if blockHeld then
		trace("block gagal: block masih nyala")
		return false
	end
	if now < readyAt - 0.005 then
		if CFG.Trace then trace(("block gagal: cooldown block (sisa %.2fs)"):format(readyAt - now)) end
		return false
	end
	if now < lockedUntil then
		if CFG.Trace then trace(("block gagal: lagi kekunci stun/refuse (sisa %.2fs)"):format(lockedUntil - now)) end
		return false
	end
	local gl = gameLock()
	if gl and now < gl - 0.01 then
		if CFG.Trace then trace(("block gagal: state game bilang belum boleh (sisa %.2fs)"):format(gl - now)) end
		return false
	end
	-- lu lagi nahan block manual -> jangan diganggu (OFF kita bakal ngelepas block lu)
	local char = LocalPlayer.Character
	-- v5: atribut Blocking yang cuma telat ke-replicate abis OFF dari script sendiri bukan block manual
	if char and char:GetAttribute("Blocking") == true and (now - lastOwnOff) > net.rtt + 0.2 then
		trace("block gagal: lu lagi nahan block manual")
		return false
	end
	if CFG.Trace then trace(("BLOCK ON dikirim (hold %.3f)"):format(hold)) end
	blockHeld = true
	blockOnAt = now
	-- v8: block ini dikirim persis pas stun hit baru lepas -> hasilnya (diterima / ditolak) jadi bahan belajar stunSlack
	if CFG.FastUnlock and now - stunSrcUntil >= -0.01 and now - stunSrcUntil < 0.15 then
		stunProbeAt = now
	end
	if sendBlock(true) == false then
		blockHeld = false
		if CFG.Trace then trace("block ditolak cek lokal game (stun/busy/cooldown/InCombat)") end
		skip("local-refuse")
		return false
	end
	counters.fired += 1
	scheduleRelease(now + hold)
	return true
end

-- v11: ada attacker (bukan lu) yang ngayun dalam HotWindow terakhir dan masih di deket lu?
function SK.hot(now)
	local char, hrp = myState()
	if not hrp then
		return false
	end
	for a, t in pairs(lastSwingSeen) do
		if now - t < CFG.HotWindow and typeof(a) == "Instance" and a ~= char and a.Parent then
			local ah = a:FindFirstChild("HumanoidRootPart")
			if ah and (ah.Position - hrp.Position).Magnitude <= CFG.HotRadius then
				return true
			end
		end
	end
	return false
end

-- pastikan block yang lagi nyala masih nyala sampai `untilClock`
local function extendHoldTo(untilClock)
	if not blockHeld then
		return false
	end
	local cap = CFG.MaxHold
	-- v11: selama masih ada attacker aktif di deket lu, jangan lepas block di tengah combo (lepas = 0.75s nggak bisa block)
	if CFG.PostParryHold and SK.hot(os.clock()) then
		cap = math.max(cap, CFG.MaxHoldActive)
	end
	local want = math.min(untilClock, blockOnAt + cap)
	if want > releaseAt then
		scheduleRelease(want)
	end
	return true
end

local function releaseBefore(t)
	if not blockHeld or releaseAt <= t then
		return
	end
	scheduleRelease(math.max(t, os.clock()))
	counters.released += 1
end

-- server udah nolak / matiin block kita -> batalin rencana release, jangan kirim OFF sia-sia
local function dropLocalBlock()
	cancel(releaseHandle)
	blockHeld = false
	rawOn = false
	-- v7: Local.Blocking game jangan nyangkut true (ON berikutnya jadi no-op, nggak ngirim apa-apa)
	if CFG.UseGameBlock then
		local h = getHandler()
		if h and type(h.Local) == "table" and h.Local.Blocking == true and type(h.DropLocalGuard) == "function" then
			pcall(h.DropLocalGuard, h, workspace:GetServerTimeNow())
		end
	end
end

-- v6: samain status block lokal sama server (atribut Blocking). Server bisa ngelepas block kita (stun dll)
-- tanpa script tau -> blockHeld nyangkut true -> semua rencana berikutnya dikira "udah nyala" padahal nggak.
local function syncBlock(now, char)
	if not (CFG.BlockResync and blockHeld and char) then
		return
	end
	if char:GetAttribute("Blocking") == true then
		blockAttrSeen = true
		return
	end
	if blockAttrSeen and (now - blockOnAt) > net.rtt * 1.5 + 0.25 then
		trace("resync: server nggak lagi nge-block, status lokal direset")
		dropLocalBlock()
		readyAt = math.max(readyAt, now)
	end
end

----------------------------------------------------------------------
-- v7: PRIORITAS BLOCK vs SWING
-- Server nolak Block ON selama BusyUntil (lu lagi nyerang) dan HoldToSwing game ngayun lagi di frame pertama
-- setelah busy abis. Jadi pas ada hit yang lagi ditunggu, TrySwing game ditahan di jendela
-- [waktu kirim block - lama swing, hit mendarat + ResultPad].
----------------------------------------------------------------------
local swingGuards = {}
local origTrySwing = nil
local hookedHandler = nil

local function guardSwing(atk, sendAt, hitAt)
	if not CFG.GuardPriority then
		return
	end
	local now = os.clock()
	for i = #swingGuards, 1, -1 do
		if swingGuards[i].to < now then
			table.remove(swingGuards, i)
		end
	end
	if #swingGuards >= 12 then
		table.remove(swingGuards, 1)
	end
	swingGuards[#swingGuards + 1] = { atk = atk, from = sendAt - CFG.SwingBusyEst - 0.02, to = hitAt + CFG.ResultPad }
end

local function clearGuards(atk)
	for i = #swingGuards, 1, -1 do
		if swingGuards[i].atk == atk then
			table.remove(swingGuards, i)
		end
	end
end

local function swingBlocked(now)
	for i = 1, #swingGuards do
		local g = swingGuards[i]
		if now >= g.from and now <= g.to then
			return true
		end
	end
	return false
end

local function installSwingHook()
	if origTrySwing then
		return true
	end
	local h = getHandler()
	if not (h and type(h.Local) == "table" and type(h.TrySwing) == "function") then
		return false
	end
	local orig = h.TrySwing
	pcall(function()
		if setreadonly then
			pcall(setreadonly, h, false)
		end
		h.TrySwing = function(self, ...)
			if alive and CFG.Enabled and CFG.GuardPriority then
				local now = os.clock()
				if swingBlocked(now) then
					counters.swingheld += 1
					return
				end
				if blockHeld then
					-- lu mau nyerang dan nggak ada hit yang ditunggu: lepas block script dulu (OFF nyampe duluan)
					releaseBefore(now)
				end
			end
			return orig(self, ...)
		end
	end)
	if h.TrySwing == orig then
		return false
	end
	origTrySwing, hookedHandler = orig, h
	return true
end

local function uninstallSwingHook()
	if origTrySwing and hookedHandler then
		pcall(function()
			hookedHandler.TrySwing = origTrySwing
		end)
	end
	origTrySwing, hookedHandler = nil, nil
end

----------------------------------------------------------------------
-- PREDIKSI WAKTU HIT & ANCAMAN
----------------------------------------------------------------------
local function timeScale(char, style, spec)
	local sf = numAttr(char, "SwingFactor", 1)
	local sp = ((style and style.Speed) or 1) * ((spec and spec.SwingSpeed) or 1)
	if sp <= 0 then
		sp = 1
	end
	return sf / sp
end

local function reachOf(char, style)
	local r = numAttr(char, "ReachFactor", 1)
	if style and style.ReachInfluence and Specs.reachInfl and Specs.reachInfl ~= 0 then
		r = 1 + (r - 1) / Specs.reachInfl * style.ReachInfluence
	end
	return r
end

-- tiru NextCombo server: reset ke 1 kalau kelamaan / abis stun, selain itu maju terus
local function nextCombo(char, style, now)
	local swings = style.M1.Swings
	local st = combo[char]
	local idx
	if not st or st.idx <= 0 then
		idx = 1
	else
		local prev = swings[st.idx]
		local window = (style.M1.ComboWindow or 0.8) + ((prev and prev.Endlag) or 0)
		if now - st.at > window then
			idx = 1
		else
			idx = st.idx % #swings + 1
		end
	end
	combo[char] = { idx = idx, at = now }
	return idx
end

local function m1Plan(attacker, now)
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local swings = type(m1) == "table" and m1.Swings
	if type(swings) ~= "table" or #swings == 0 then
		return {
			kind = "M1",
			lead = CFG.DefaultM1Lead * numAttr(attacker, "SwingFactor", 1),
			reach = numAttr(attacker, "ReachFactor", 1),
		}
	end
	local idx = nextCombo(attacker, style, now)
	local spec = swings[idx]
	if type(spec) ~= "table" then
		spec = swings[1]
		idx = 1
	end
	return {
		kind = "M1",
		lead = (spec.Windup or CFG.DefaultM1Lead) * timeScale(attacker, style, spec),
		reach = reachOf(attacker, style),
		spec = spec,
		height = spec.Height or m1.Height,
		idx = idx,
		key = attacker.Name .. ":" .. idx,
		learn = true,
	}
end

-- hold = Hold dari Flash (nil kalau datang dari Sound HeavySwing)
local function m2Plan(attacker, hold)
	local style = styleOf(attacker)
	local spec = style and style.M2
	if type(spec) ~= "table" then
		return {
			kind = "M2",
			lead = math.max(hold or CFG.HeavyMin, CFG.HeavyMin),
			reach = numAttr(attacker, "ReachFactor", 1),
		}
	end

	local k = timeScale(attacker, style, spec)
	local windup = (spec.Windup or hold or CFG.HeavyMin) * k
	local lunge = spec.Lunge
	if type(lunge) == "table" and (lunge.Speed or 0) > 0 and not spec.Sweep then
		local lw = (lunge.Time or 0) + (lunge.Settle or 0)
		if lw > windup then
			windup = lw
		end
	end

	local lead = windup
	local followUps = spec.FollowUps
	if type(followUps) == "table" and #followUps > 0 then
		-- cuma hit PERTAMA yang penting: parry dia = attacker stun = sisanya batal
		for _, f in ipairs(followUps) do
			local at = ((type(f) == "table" and f.At) or 0) * k
			if at < lead then
				lead = at
			end
		end
	elseif hold then
		local fromHold = hold - (spec.FlashTail or 0)
		if math.abs(lead - fromHold) > 0.12 then
			lead = fromHold -- spec nggak nyambung sama yang dikirim server -> percaya server
		end
	end

	return {
		kind = "M2",
		lead = lead,
		reach = reachOf(attacker, style),
		spec = spec,
		height = spec.Height,
		multi = type(followUps) == "table" and #followUps > 0,
		key = attacker.Name .. ":M2",
		-- jarak-dependen (sweep/projectile/throw/dash/teleport) nggak ikut dipelajari
		learn = not (spec.Sweep or spec.Projectile or spec.Throw or spec.Dash or spec.Teleport),
	}
end

-- sweep / projectile / throw: hit pertama tergantung jarak
local function refineLead(plan, dist)
	local spec = plan.spec
	if type(spec) ~= "table" then
		return plan.lead
	end
	local lead = plan.lead
	local reachEff = (spec.Range or 6) * plan.reach + SR.RangeTolerance + SR.TargetRadius

	if type(spec.Sweep) == "table" then
		local first = spec.Sweep.Start or 0
		local l = spec.Lunge
		if type(l) == "table" and (l.Speed or 0) > 0 then
			local t = (l.Delay or 0) + math.max(0, dist - reachEff) / l.Speed
			first = math.max(first, t)
		end
		return first
	end
	if type(spec.Projectile) == "table" and (spec.Projectile.Speed or 0) > 0 then
		return lead + math.max(0, dist - (spec.Projectile.Forward or 0)) / spec.Projectile.Speed
	end
	if type(spec.Throw) == "table" and (spec.Throw.OutTime or 0) > 0 then
		local speed = (spec.Throw.Distance or 24) / spec.Throw.OutTime
		local travel = math.max(0, dist - (spec.Throw.Forward or 0)) / math.max(speed, 1)
		return lead + math.min(travel, spec.Throw.OutTime)
	end
	return lead
end

local function extraReach(spec)
	if type(spec) ~= "table" then
		return 0
	end
	local e = 0
	local l = spec.Lunge
	if type(l) == "table" and (l.Speed or 0) > 0 then
		e = math.max(e, (l.Speed or 0) * (l.Time or 0))
	end
	if type(spec.Pull) == "table" then
		e = math.max(e, spec.Pull.Range or 12)
	end
	if type(spec.Teleport) == "table" then
		e = math.max(e, spec.Teleport.Range or 0)
	end
	if type(spec.Dash) == "table" then
		e = math.max(e, spec.Dash.Distance or 0)
	end
	if type(spec.Projectile) == "table" then
		e = math.max(e, spec.Projectile.Distance or 0)
	end
	if type(spec.Throw) == "table" then
		e = math.max(e, spec.Throw.Distance or 0)
	end
	return e
end

-- tiru InReach server: kotak di depan attacker (Range + toleransi, lebar Radius, tinggi Height)
-- boost = margin ekstra (stud) karena ping
local function inVolume(ahrp, pos, plan, boost, apos)
	local spec, reach = plan.spec, plan.reach or 1
	local d = pos - (apos or ahrp.Position)
	local flat = Vector3.new(d.X, 0, d.Z)
	local mag = flat.Magnitude

	if not (CFG.UseVolume and type(spec) == "table" and type(spec.Range) == "number") then
		if mag > CFG.FallbackRange * reach + boost then
			return false
		end
		if mag > 0.5 and CFG.FallbackFacingDot > -1 then
			local look = ahrp.CFrame.LookVector
			local fl = Vector3.new(look.X, 0, look.Z)
			if fl.Magnitude > 0 and fl.Unit:Dot(flat.Unit) < CFG.FallbackFacingDot then
				return false
			end
		end
		return true
	end

	local height = (plan.height or SR.HitHeight) + 2
	if math.abs(d.Y) > height then
		return false
	end
	local range = spec.Range * reach + SR.RangeTolerance + SR.TargetRadius + CFG.RangeMargin + boost + extraReach(spec)
	if spec.MinRange and mag < spec.MinRange * reach - 1 then
		return false
	end
	if spec.Radial then
		return mag <= range
	end
	if mag < 0.5 then
		return true
	end
	local look = ahrp.CFrame.LookVector
	local fl = Vector3.new(look.X, 0, look.Z)
	if fl.Magnitude < 0.01 then
		return mag <= range
	end
	fl = fl.Unit
	local fwd = flat:Dot(fl)
	if fwd < -CFG.BackMargin or fwd > range then
		return false
	end
	local lat = (flat - fl * fwd).Magnitude
	local half = (spec.Radius or 2.5)
		+ SR.TargetRadius
		+ CFG.WidthMargin
		+ boost * 0.5
		+ math.min(math.max(fwd, 0), 8) * CFG.ConeSlack
	return lat <= half
end

local OFFS = { 0, -1, 1, -2, 2 }

-- hasil: ancaman?, jarak datar, pasti? (pasti = masuk volume hitbox; false = cuma "deket banget")
local function threatens(attacker, myHrp, plan, lead)
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not ahrp then
		return false, 0, false
	end
	local d = myHrp.Position - ahrp.Position
	local dist = Vector3.new(d.X, 0, d.Z).Magnitude
	local boost = math.clamp(net.rtt * CFG.PingMargin, 0, CFG.MaxPingMargin)
	-- v6: lagi lari -> posisi lu di server bisa jauh beda dari yang kerasa di client, range ikut melebar
	local mv = myHrp.AssemblyLinearVelocity
	boost += math.min(math.sqrt(mv.X * mv.X + mv.Z * mv.Z) * CFG.RunMargin, CFG.RunMarginMax)

	if inVolume(ahrp, myHrp.Position, plan, boost) then
		return true, dist, true
	end

	-- v5: attacker juga gerak selama windup (maju / nge-lunge) -> coba posisi dia di masa depan
	local apos = nil
	if CFG.AttackerVelPredict then
		local av = ahrp.AssemblyLinearVelocity
		local t = math.clamp(lead - 0.05, 0, 0.35)
		apos = ahrp.Position + Vector3.new(av.X, 0, av.Z) * t * 0.7
		if inVolume(ahrp, myHrp.Position, plan, boost, apos) then
			return true, dist, true
		end
	end

	-- server ngecek posisi lu yang di-rewind (bisa di masa lalu) + gerak lu selama windup.
	-- Coba beberapa horizon: kena di salah satu = anggap ancaman.
	local h = lead - CFG.AttackerLag - net.rtt
	for _, o in ipairs(OFFS) do
		local hh = math.clamp(h + o * CFG.LagSpread, -0.5, 0.45)
		local p = posAtRel(myHrp, hh)
		if inVolume(ahrp, p, plan, boost) then
			return true, dist, true
		end
		if apos and inVolume(ahrp, p, plan, boost, apos) then
			return true, dist, true
		end
	end

	-- v5: deket banget = tetap dianggap ancaman buat BLOCK/PARRY (attacker bisa muter / maju pas windup)
	if CFG.CloseAlways > 0 and math.abs(d.Y) < 8 and dist <= CFG.CloseAlways * (plan.reach or 1) + boost then
		return true, dist, false
	end
	-- v11.4: telegraf M2 dari attacker yang MADEP ke lu di jarak jauh (M2 Reaper 14-24 stud dulu kebaca "range" -> lolos tanpa rencana).
	-- sure=false, jadi yang dipilih parry (dodge tetap butuh ancaman pasti)
	if plan.kind == "M2" and CFG.M2CloseAlways > CFG.CloseAlways and math.abs(d.Y) < 8
		and dist <= CFG.M2CloseAlways * (plan.reach or 1) + boost then
		local look = ahrp.CFrame.LookVector
		local lk = Vector3.new(look.X, 0, look.Z)
		local flat = Vector3.new(d.X, 0, d.Z)
		if lk.Magnitude > 0.01 and flat.Magnitude > 0.5 and lk.Unit:Dot(flat.Unit) > 0.35 then
			return true, dist, false
		end
	end
	return false, dist, false
end

----------------------------------------------------------------------
-- ARBITRASE RENCANA (satu parry per jendela cooldown, M2 menang atas M1)
----------------------------------------------------------------------
local function arbitrate(kind, hitAt, now)
	for i = #pending, 1, -1 do
		local p = pending[i]
		if p.done or p.hit < now - 0.2 then
			table.remove(pending, i)
		end
	end
	for i = #pending, 1, -1 do
		local p = pending[i]
		local gap = math.abs(hitAt - p.hit)
		if p.kind == "DODGE" and gap < 0.18 then
			return "dup" -- iframe dodge yang udah dijadwalin nutup hit ini juga
		end
		if gap < CFG.ConflictWindow then
			if kind == "M2" and p.kind == "M1" then
				-- M2 = GuardBroken kalau nggak diparry, M1 cukup ke-Block -> M2 yang diprioritaskan
				cancel(p.handle)
				table.remove(pending, i)
				counters.cancelled += 1
			elseif gap < CFG.DedupeWindow or (kind == "M1" and p.kind == "M2") then
				if gap >= CFG.DedupeWindow then
					-- hit ini tetap perlu dijaga: jangan sampai block keburu dilepas abis parry
					noteExpected(false, hitAt, now, kind)
				end
				return "dup"
			end
		end
	end
	return "ok"
end

----------------------------------------------------------------------
-- DODGE (v4)
-- Server: Dodge = Info "Dodge". Syarat: InCombat, TIDAK lagi Blocking, nggak stun, DodgeReadyAt lewat,
-- nggak Busy. Dapat IFrames (0.26s default) mulai dari saat paket NYAMPE di server. Hit yang mendarat
-- pas IFrames aktif = "Dodged" (nol damage, M2 juga). Cooldown dash 2.25s, Block ON ditolak selama Busy (0.4s).
----------------------------------------------------------------------
local function dashOf()
	local d = { IFrames = SR.Dash.IFrames, Duration = SR.Dash.Duration, Cooldown = SR.Dash.Cooldown }
	local char = LocalPlayer.Character
	local style = char and styleOf(char)
	local o = style and style.Dash
	if type(o) == "table" then
		d.IFrames = type(o.IFrames) == "number" and o.IFrames or d.IFrames
		d.Duration = type(o.Duration) == "number" and o.Duration or d.Duration
		d.Cooldown = type(o.Cooldown) == "number" and o.Cooldown or d.Cooldown
	end
	return d
end

local function dodgeLocal()
	if not CFG.DodgeViaGame then
		return nil
	end
	local h = getHandler()
	local L = h and h.Local
	if h and type(L) == "table" and type(h.TryDodge) == "function" then
		return h, L
	end
	return nil
end

local DODGE_KEYS = { "DodgeReadyAt", "BusyUntil", "StunnedUntil" } -- v6: nggak alokasi tabel tiap panggil

-- berapa detik lagi dodge baru bisa dikirim (0 = siap). forPlan = ikut hitung dodge yang udah dijadwalin
local function dodgeWait(now, forPlan)
	local w = math.max(dodgeReadyAt - now, dodgeBusyUntil - now, stunUntil - now, 0)
	if forPlan then
		w = math.max(w, dodgePlannedUntil - now)
	end
	local h, L = dodgeLocal()
	if L then
		local ok, res = pcall(function()
			local sn = workspace:GetServerTimeNow()
			local m = 0
			for _, k in ipairs(DODGE_KEYS) do
				local v = L[k]
				if type(v) == "number" and v > sn then
					m = math.max(m, v - sn)
				end
			end
			return m
		end)
		if ok and type(res) == "number" and res < 4 then
			w = math.max(w, res)
		end
	end
	return w
end

local function fireDodge()
	local now = os.clock()
	local char = LocalPlayer.Character
	if not char then
		return false
	end
	if dodgeWait(now) > 0.02 then
		trace("dodge gagal: belum siap (cooldown/busy/stun)")
		return false
	end
	if not blockHeld and char:GetAttribute("Blocking") == true and (now - lastOwnOff) > net.rtt + 0.2 then
		trace("dodge gagal: lu lagi nahan block manual")
		return false
	end
	local d = dashOf()

	-- server nolak Dodge kalau masih Blocking -> lepas block kita dulu (OFF sampai duluan, urutan remote terjaga)
	if blockHeld then
		cancel(releaseHandle)
		sendBlock(false)
		blockHeld = false
		readyAt = now + SR.BlockCooldown
		counters.released += 1
		trace("block dilepas buat dodge")
	end

	local fired = false
	local h, L = dodgeLocal()
	if h then
		-- pakai fungsi dodge asli game: animasi + dorongan + state lokal ikut bener
		local before = L.DodgeReadyAt
		local ok, err = pcall(h.TryDodge, h)
		if not ok then
			trace("TryDodge error:", tostring(err))
		elseif L.DodgeReadyAt ~= before then
			fired = true
		end
	else
		Combat:FireServer({ Info = "Dodge", Direction = CFG.DodgeDirection, T = workspace:GetServerTimeNow() })
		fired = true
	end

	if not fired then
		trace("dodge ditolak game lokal")
		return false
	end
	dodgeSentAt = now
	dodgeReadyAt = now + d.Cooldown - 0.05
	dodgeBusyUntil = now + d.Duration
	lockedUntil = math.max(lockedUntil, now + d.Duration) -- Block ON ditolak server selama Busy
	counters.dodgesent += 1
	trace((h and "DODGE dikirim (game TryDodge)" or "DODGE dikirim (remote langsung)"))
	return true
end

-- v5: hitung kemungkinan dodge tanpa jadwalin apa-apa. hasil: ok, sendIn, age, wait, dashInfo
local function dodgeProbe(lead, now, rtt, fl)
	local d = dashOf()
	local target = math.clamp(d.IFrames * CFG.DodgeAgeFrac, 0.04, math.max(d.IFrames - 0.06, 0.05))
	local wait = dodgeWait(now, true)
	local sendIn = lead - target - rtt - fl + (math.random() * 2 - 1) * CFG.Jitter
	if sendIn < wait then
		sendIn = wait
	end
	if sendIn < 0 then
		sendIn = 0
	end
	local age = lead - rtt - fl - sendIn -- berapa lama IFrames udah jalan pas hit mendarat
	local ok = age >= CFG.DodgeMinAge and age <= d.IFrames - CFG.DodgeEdge
	return ok, sendIn, age, wait, d
end

-- jadwalin dodge supaya hit mendarat di tengah IFrames. true = urusan hit ini udah ditangani
local function planDodge(attacker, plan, lead, now, rtt, fl, tag, why)
	if not (alive and CFG.DodgeEnabled) then
		return false
	end
	if plan.kind == "M2" and not CFG.DodgeForM2 then
		return false
	end
	if plan.kind == "M1" and not CFG.DodgeForM1 then
		return false
	end
	-- v5: dodge itu jatah langka (cd 2.25s) -> cuma dipakai buat ancaman yang pasti masuk hitbox
	if CFG.SmartMode and not reactSure then
		skip("dodge-unsure")
		return false
	end
	local ok, sendIn, age, wait, d = dodgeProbe(lead, now, rtt, fl)
	if not ok then
		if CFG.Trace then trace(
			("%s: dodge nggak mungkin (%s) age %.3f iframe %.2f tunggu %.2fs"):format(
				tag, tostring(why), age, d.IFrames, wait
			)
		) end
		skip(age < CFG.DodgeMinAge and "dodge-late" or "dodge-early")
		return false
	end

	local hitAt = now + lead
	local verdict = arbitrate(plan.kind, hitAt, now)
	if verdict ~= "ok" then
		skip(verdict)
		return true -- hit ini udah ditutup rencana lain
	end

	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	counters.dodgeplanned += 1
	if CFG.LogEvents then
		pushEv("plan", ("%s %s -> dodge lead %.2f kirim +%.2f"):format(tag, nameOf(attacker), lead, sendIn))
	end
	dodgePlannedUntil = now + sendIn + d.Cooldown - 0.05
	dodgeBlockUntil = math.max(dodgeBlockUntil, now + sendIn + d.Duration)
	noteExpected(attacker, hitAt, now, "DODGE")
	guardSwing(attacker, now + sendIn, hitAt)
	if CFG.Trace then trace(
		("%s dari %s: DODGE (%s) lead %.3f rtt %.3f -> kirim %.3fs lagi (umur iframe %.3f)"):format(
			tag, attacker.Name, tostring(why), lead, rtt, sendIn, age
		)
	) end
	local rec = { kind = "DODGE", hit = hitAt, done = false }
	pending[#pending + 1] = rec
	rec.handle = schedule(now + sendIn, function()
		rec.done = true
		if not alive or not CFG.Enabled then
			return
		end
		if planToken[attacker] ~= tok then
			counters.cancelled += 1
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
			return
		end
		-- v9: attacker udah mati / knocked -> jatah dodge (cd 2.25s) jangan dibuang
		if CFG.RecheckAttacker and attackerGone(attacker) then
			counters.cancelled += 1
			counters.recheck += 1
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
			skip("attacker-gone")
			return
		end
		-- v5: cek ulang sebelum buang jatah dodge: attacker masih ngincer lu?
		if CFG.SmartMode then
			local c2, h2 = myState()
			if c2 and h2 then
				-- v11.4: batalin dodge cuma kalau attacker beneran udah jauh. Dulu cek hitbox sempit -> M2 yang tetap mendarat
				-- (dump: "dodge-recheck" lalu KENA M2 Toji) lolos tanpa dodge DAN tanpa parry.
				local okT, dT = threatens(attacker, h2, plan, math.max(hitAt - os.clock(), 0))
				if not okT and dT > CFG.DodgeRecheckDist then
					counters.cancelled += 1
					dodgePlannedUntil = 0
					dodgeBlockUntil = 0
					skip("dodge-recheck")
					return
				end
			end
		end
		if not fireDodge() then
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
		end
	end)
	return true
end

----------------------------------------------------------------------
-- REACT
----------------------------------------------------------------------
local function corrFor(attacker, plan)
	if plan.nocorr then
		return 0 -- v10: plan skill nggak ikut koreksi lead M1
	end
	if plan.key then
		local c = leadCorr[plan.key]
		if c then
			return c
		end
	end
	if plan.kind == "M1" then
		return leadAll[attacker.Name] or 0
	end
	return 0
end

-- block yang udah nyala dipertahanin sampai hit ini ketutup (block biasa / chain guard)
local function guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, note)
	local verdict = arbitrate(plan.kind, now + lead, now)
	if verdict ~= "ok" then
		return skip(verdict)
	end
	pending[#pending + 1] = { kind = plan.kind, hit = now + lead, done = false }
	noteExpected(attacker, now + lead, now, plan.kind)
	local rp = CFG.ResultPad + SK.resPad()
	guardSwing(attacker, now, now + lead + rp)
	local coverTo = math.max(now + lead - rtt - fl + ha, now + lead + rp)
	if extendHoldTo(coverTo) then
		counters.chained += 1
		if CFG.Trace then trace(("%s dari %s: block ditahan terus (%s), cover sampai +%.3fs"):format(tag, attacker.Name, note, coverTo - now)) end
	else
		if CFG.Trace then trace(("%s dari %s: block udah lepas, nggak bisa ditahan lagi (%s)"):format(tag, attacker.Name, note)) end
	end
end

-- v7: rencana yang diprediksi (swing berikutnya belum kelihatan) dicek ulang sebelum block dikirim
local function predictedStillValid(attacker, plan, hitAt)
	if not attacker.Parent then
		return false
	end
	local ahum = attacker:FindFirstChildOfClass("Humanoid")
	if ahum and ahum.Health <= 0 then
		return false
	end
	local c, h = myState()
	if not (c and h) then
		return false
	end
	local ok, dist = threatens(attacker, h, plan, math.max(hitAt - os.clock(), 0))
	if ok then
		return true
	end
	-- v8: rencana dari reflex combo: attacker masih di sekitar lu dan combo-nya masih jalan -> tetap kirim
	if plan.reflex and CFG.ComboKeep then
		local cv = comboVictim[attacker]
		if cv and os.clock() - cv.at < CFG.ComboKeepTime + 0.5 and dist <= CFG.ComboKeepRange then
			return true
		end
	end
	return false
end

-- v7: Block ON gagal gara-gara kekunci (stun abis kena hit / busy / cooldown) tapi masih sempat nyampe
-- sebelum hit mendarat -> coba lagi begitu kunci kebuka
local function retryAfterUnlock(attacker, tok, hitAt, rtt, fl, ha, mode)
	if not CFG.RetryAfterUnlock or blockHeld then
		return
	end
	local t = os.clock()
	local gl = gameLock()
	local unlock = math.max(readyAt - 0.005, lockedUntil, dodgeBlockUntil, gl and (gl - 0.01) or -math.huge)
	if unlock <= t or unlock + 0.012 > hitAt - rtt - fl + CFG.LateTolerance then
		return
	end
	counters.retried += 1
	schedule(unlock + 0.012 + frame.avg * CFG.FireEarly, function()
		if not alive or not CFG.Enabled or blockHeld or planToken[attacker] ~= tok then
			return
		end
		if pressBlock(math.max(hitAt - os.clock(), 0) + CFG.ResultPad + ha) then
			pressMode = mode
			blockFor = attacker
		end
	end)
end

-- Block ON baru dijadwalin. mode "parry" = ngincer window parry, "plain" = cukup block nyala pas hit
local function scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, mode, bound)
	local hitAt = now + lead
	local verdict = arbitrate(plan.kind, hitAt, now)
	if verdict ~= "ok" then
		return skip(verdict)
	end

	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	local resultAt = hitAt + CFG.ResultPad + SK.resPad()
	local hold = math.max(age, 0) + ha
	-- v4: hold minimal sampai event hasil hit nyampe, biar Blocked bisa disambung chain guard
	-- (kalau hasilnya Parried, block langsung dilepas lagi di onHit)
	if now + sendIn + hold < resultAt then
		hold = resultAt - (now + sendIn)
	end
	local coverTo = math.max(now + lead - rtt - fl + ha, resultAt) -- block harus tetap nyala sampai jam ini biar hit ini ketutup
	counters.planned += 1
	if CFG.LogEvents then
		pushEv("plan", ("%s %s -> %s lead %.2f kirim +%.2f"):format(tag, nameOf(attacker), mode, lead, sendIn))
	end
	noteExpected(attacker, hitAt, now, plan.kind)
	if CFG.DebugPlan then
		if CFG.Debug then log(
			("%s plan[%s]: lead %.3f rtt %.3f±%.3f fps %.0f sendIn %.3f age %.3f hold %.3f tune %+.3f"):format(
				tag, mode, lead, rtt, net.var, frame.fps, sendIn, age, hold, tune[plan.kind]
			)
		) end
	end

	if CFG.Trace then trace(
		("%s dari %s [%s]: lead %.3f rtt %.3f fps %.0f -> kirim %.3fs lagi (umur block %.3f)"):format(
			tag, attacker.Name, mode, lead, rtt, frame.fps, sendIn, age
		)
	) end
	local rec = { kind = plan.kind, hit = hitAt, done = false }
	pending[#pending + 1] = rec
	guardSwing(attacker, now + sendIn, hitAt)
	-- v6: kalau waktunya ditentuin kunci (cooldown block / busy / stun), jangan kirim lebih awal dari kunci kebuka.
	-- Dulu FireEarly bikin paket keluar setengah frame sebelum kunci kebuka -> ditolak pengecekan sendiri -> hit lolos.
	rec.handle = schedule(now + sendIn + (bound and frame.avg * CFG.FireEarly or 0), function()
		rec.done = true
		if not alive or not CFG.Enabled then
			return
		end
		if planToken[attacker] ~= tok then
			counters.cancelled += 1
			return
		end
		if CFG.RecheckAttacker and attackerGone(attacker) then
			counters.cancelled += 1
			counters.recheck += 1
			skip("attacker-gone")
			return
		end
		if plan.predicted and not predictedStillValid(attacker, plan, hitAt) then
			counters.cancelled += 1
			skip("predict-recheck")
			return
		end
		if pressBlock(hold) then
			pressMode = mode
			blockFor = attacker
		elseif plan.kind == "M1" and CFG.ChainGuard and extendHoldTo(coverTo) then
			-- block udah nyala (rencana sebelumnya / chain): M1 cukup ditutup pakai perpanjangan hold
			counters.chained += 1
		else
			retryAfterUnlock(attacker, tok, hitAt, rtt, fl, ha, mode)
		end
	end)
end

-- terlalu mepet / kekunci: jalur lama v3.1 (LateMode)
local function lateFallback(plan, tag, lead, rtt, fl, bound, wait)
	if bound then
		counters.locked += 1
		skip("locked")
		if CFG.Debug then log(("%s kekunci cooldown block (sisa %.2fs, lead %.3f)"):format(tag, wait, lead)) end
	else
		counters.late += 1
		skip("late")
		if CFG.Debug then log(("%s terlalu cepat buat di-react (lead %.3f <= rtt %.3f + frame %.3f)"):format(tag, lead, rtt, fl)) end
	end
	local mode = plan.kind == "M2" and CFG.LateModeM2 or CFG.LateModeM1
	if mode == "block" then
		if pressBlock(CFG.LateHold) then
			pressMode = "plain"
		elseif plan.kind == "M1" and CFG.ChainGuard then
			extendHoldTo(os.clock() + CFG.LateHold)
		end
	end
end

-- v11.4: sumber kunci block yang lagi paling nahan (buat dump: locked/cd, locked/ke-parry, locked/busy, dst)
function SK.whyLock(now, earliest)
	if earliest == readyAt then
		return "cd" -- BlockCooldown abis Block OFF (block dilepas / ke-lepas)
	elseif earliest == dodgeBlockUntil then
		return "dodge"
	elseif earliest == lockedUntil then
		return (now - (SK.bpAt or -math.huge) < 1.0) and "ke-parry" or "stun"
	end
	local busy = false
	local h = getHandler()
	local L = h and h.Local
	if type(L) == "table" and type(L.BusyUntil) == "number" then
		local okS, sn = pcall(function()
			return workspace:GetServerTimeNow()
		end)
		busy = okS and L.BusyUntil > sn + 0.02
	end
	return busy and "busy" or "game"
end

-- v10: sama persis kayak CombatHandler.FromBehind (server): penyerang di belakang lu = block lu dipecahin + damage penuh
function SK.behind(attacker, hrp, angleDeg)
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not ahrp then
		return false
	end
	local d = (ahrp.Position - hrp.Position) * Vector3.new(1, 0, 1)
	local lk = hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
	if d.Magnitude < 0.001 or lk.Magnitude < 0.001 then
		return false
	end
	return d.Unit:Dot(lk.Unit) < math.cos(math.rad(angleDeg or 100))
end

--[[
	Keputusan per hit (v4):
	  M1: parry (block baru / block lama yang masih di window)
		  -> kalau parry nggak mungkin (parry cd, unparryable, block lama): BLOCK BIASA, ditahan nyambung
		  -> kalau block juga nggak sempat / kekunci: DODGE
	  M2: parry
		  -> kalau parry nggak mungkin (parry cd, unparryable, block lama, kekunci, kecepetan): DODGE
		  -> (opsional) kalau parry M2 dari attacker itu sebelumnya miss: dodge DULUAN
]]
local function react(attacker, plan, tag)
	if not alive or not CFG.Enabled or typeof(attacker) ~= "Instance" then
		return
	end
	local char, hrp = myState()
	if not char or attacker == char then
		return
	end
	local why = cannotAct(char, attacker)
	if why then
		return skip(why)
	end
	local ahum = attacker:FindFirstChildOfClass("Humanoid")
	if ahum and ahum.Health <= 0 then
		return
	end

	local now = os.clock()
	sampleNet(now)
	syncBlock(now, char)
	local rtt = net.rtt
	local fl = frameLag()
	local sigma = sigmaNow()
	local corr = corrFor(attacker, plan)
	local unparry = (plan.spec and plan.spec.Unparryable) and true or false

	-- v7: plan prediksi leadnya jauh (~0.9s) -> cek ancaman pakai horizon pendek, posisi 0.9s ke depan nggak bisa ditebak
	local isThreat, dist, sure =
		threatens(attacker, hrp, plan, plan.predicted and math.min(plan.lead + corr, 0.35) or (plan.lead + corr))
	-- v8: attacker ini lagi nge-combo lu (hit/block barusan) -> tetap ancaman walau cek hitbox meleset (knockback, ping, lunge)
	if (not isThreat or not sure) and plan.kind == "M1" and CFG.ComboKeep then
		local cv = comboVictim[attacker]
		if cv and now - cv.at < CFG.ComboKeepTime and attacker:FindFirstChild("HumanoidRootPart") and dist <= CFG.ComboKeepRange * (plan.reach or 1) then
			isThreat, sure = true, true
		end
	end
	if not isThreat then
		if plan.kind == "M2" and CFG.M2Recheck and not plan.rechecked then
			local okR, errR = pcall(SK.m2Recheck, attacker, plan, tag, now)
			if not okR then
				trace("m2Recheck error:", tostring(errR))
			end
		end
		return skip("range")
	end
	reactSure = sure
	if plan.predicted and not sure then
		return skip("predict-unsure") -- cuma nebak kalau attacker beneran ngincer lu
	end

	local lead
	if plan.kind == "M1" then
		lead = plan.lead + corr
	else
		lead = refineLead(plan, dist) + corr
	end

	-- hit bakal mendarat pas lu masih iframe (abis dash) -> nggak perlu
	local iu = char:GetAttribute("IFramesUntil")
	if type(iu) == "number" and iu > workspace:GetServerTimeNow() + lead then
		return skip("iframes")
	end

	-- v10: server ngubah block jadi Hit kalau penyerang ada di belakang lu (BackHit) -> parry/block percuma, tinggal dodge
	if CFG.BackHitGuard and SR.BackHit.Enabled and SK.behind(attacker, hrp, SR.BackHit.Angle) then
		counters.behind += 1
		if CFG.DodgeEnabled and planDodge(attacker, plan, lead, now, rtt, fl, tag, "dari belakang") then
			return
		end
		return skip("behind")
	end

	local isM2 = plan.kind == "M2"
	local ha = holdAfter()

	-- parry masih cooldown pas hit mendarat?
	local parryCd = now + lead < parriedAt + SR.ParryCooldown - 0.02
	local reason = unparry and "unparryable" or (parryCd and "parrycd" or nil)

	-- kapan paling cepat Block ON bisa diterima server
	local glk = gameLock()
	local earliest = math.max(readyAt, lockedUntil, dodgeBlockUntil, glk or -math.huge)
	local wait = earliest - now
	SK.lockWhy = (wait > 0.005) and SK.whyLock(now, earliest) or nil
	local function calc(targetAge, tn)
		local s = lead - targetAge - rtt - fl + tn + (math.random() * 2 - 1) * CFG.Jitter
		local b = false
		if s < wait then
			s = wait
			b = true
		end
		if s < 0 then
			s = 0
		end
		return s, lead - rtt - fl - s, b
	end

	-- bisa diparry?
	local canParry, mode = false, nil
	local sendIn, age, bound = 0, 0, false
	local parryConf = 0 -- v5: peluang parry berhasil (0..1)
	if not reason then
		if blockHeld then
			-- block yang lagi nyala cuma bisa nge-parry kalau umurnya pas hit masih di dalam window
			local heldAge = (now - blockOnAt) + lead - rtt - fl
			if heldAge >= 0 and heldAge <= SR.ParryWindow - 0.04 then
				canParry, mode = true, "held"
				parryConf = confWindow(heldAge, SR.ParryWindow, sigma)
			else
				reason = "heldold"
			end
		else
			sendIn, age, bound = calc(targetAgeFor(isM2), tune[plan.kind])
			if age >= -CFG.LateTolerance then
				canParry, mode = true, "fresh"
				parryConf = confWindow(age, SR.ParryWindow, sigma)
			else
				reason = bound and "locked" or "late"
			end
		end
	end

	------------------------------------------------------------------
	-- M2 (BreaksBlock): cuma parry yang nyelametin, block biasa = GuardBroken -> sisanya DODGE
	------------------------------------------------------------------
	if isM2 then
		local dodgeFirst = CFG.DodgeFirstM2
			or (CFG.DodgeAfterMiss and (m2Miss[attacker] or 0) >= CFG.M2MissNeed and now - (m2MissAt[attacker] or -math.huge) < CFG.M2MissMemory)
		local dodgeWhy = "M2 dodge duluan"
		-- v5: bandingin peluang sukses parry vs dodge, ambil yang lebih tinggi
		if not dodgeFirst and canParry and CFG.SmartMode and CFG.DodgeEnabled and CFG.DodgeForM2 and sure then
			local dOK, _, dAge, _, dd = dodgeProbe(lead, now, rtt, fl)
			if dOK then
				local dc = confWindow(dAge, dd.IFrames, sigma)
				-- M2 multi-hit: parry nge-stun attacker (sisa hit batal), dodge cuma nutup hit pertama -> syarat lebih ketat
				local gap = plan.multi and CFG.DodgeSwitchGap * 2 or CFG.DodgeSwitchGap
				if dc >= CFG.DodgeMinConf and dc - parryConf > gap then
					dodgeFirst = true
					dodgeWhy = ("peluang dodge %.0f%% > parry %.0f%%"):format(dc * 100, parryConf * 100)
				end
			end
		end
		if dodgeFirst and planDodge(attacker, plan, lead, now, rtt, fl, tag, dodgeWhy) then
			return
		end
		if not canParry then
			if planDodge(attacker, plan, lead, now, rtt, fl, tag, reason) then
				return
			end
			-- dodge juga nggak bisa: seenggaknya jangan sampai GuardBroken (lepas block sebelum M2 mendarat)
			if blockHeld and CFG.ReleaseBeforeHeavy then
				releaseBefore(now + lead - rtt - fl - 0.03)
			end
			if reason == "late" or reason == "locked" then
				return lateFallback(plan, tag, lead, rtt, fl, bound, wait)
			end
			return skip(reason == "heldold" and "heldold" or reason)
		end
		if mode == "held" then
			return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "masih di window parry")
		end
		return scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, "parry", bound)
	end

	------------------------------------------------------------------
	-- M1: parry kalau bisa, kalau nggak BLOCK BIASA (ditahan), kalau block juga nggak bisa DODGE
	------------------------------------------------------------------
	if canParry then
		if mode == "held" then
			return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "masih di window parry")
		end
		return scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, "parry", bound)
	end

	if blockHeld and CFG.ChainGuard then
		return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "block biasa (" .. tostring(reason) .. ")")
	end

	if CFG.BlockFallback and not blockHeld then
		local s2, a2, b2 = calc(CFG.BlockOnlyAge, 0)
		if a2 >= -CFG.LateTolerance then
			if CFG.Trace then trace(("%s dari %s: parry nggak mungkin (%s) -> block biasa"):format(tag, attacker.Name, tostring(reason))) end
			return scheduleBlock(attacker, plan, tag, lead, s2, a2, ha, rtt, fl, now, "plain", b2)
		end
		bound = b2
	end

	if planDodge(attacker, plan, lead, now, rtt, fl, tag, "block nggak sempat") then
		return
	end
	return lateFallback(plan, tag, lead, rtt, fl, bound, wait)
end

----------------------------------------------------------------------
-- COMBAT EVENTS
----------------------------------------------------------------------
-- v7: tebak swing M1 berikutnya dalam combo. Server: swing ke-(i+1) mulai (Windup_i + Endlag_i) setelah swing ke-i
-- (HoldToSwing = persis pas busy abis), hit-nya Windup_(i+1) setelahnya. Jadi hit berikutnya = sekarang +
-- (W_i + E_i) * k + W_(i+1) * k, dihitung dari Sound swing sekarang -> block bisa dikirim jauh sebelum Sound berikutnya
-- nyampe (yang lead-nya sering < ping). Dicek ulang pas mau dikirim; kalau swing aslinya nongol, di-dedupe.
local function predictFollowUp(attacker, plan, now)
	if not (alive and CFG.Enabled and CFG.PredictCombo and CFG.BlockFallback) then
		return
	end
	local spec, idx = plan.spec, plan.idx
	if type(spec) ~= "table" or type(idx) ~= "number" then
		return
	end
	local style = styleOf(attacker)
	local swings = style and style.M1 and style.M1.Swings
	if type(swings) ~= "table" or idx >= #swings then
		return -- swing terakhir: abis ini ada ChainCooldown, nggak ditebak
	end
	local nxt = swings[idx + 1]
	if type(nxt) ~= "table" then
		return
	end
	local char, hrp = myState()
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not (char and hrp and ahrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.PredictMaxDist then
		return
	end
	local k1 = timeScale(attacker, style, spec)
	local k2 = timeScale(attacker, style, nxt)
	local key = attacker.Name .. ":" .. (idx + 1)
	local w2 = (nxt.Windup or CFG.DefaultM1Lead) * k2 + (leadCorr[key] or 0)
	-- swing berikutnya masih cukup lead buat di-react biasa -> nggak usah nebak
	if w2 - net.rtt - frameLag() >= CFG.PredictBelow then
		return
	end
	local lead2 = ((spec.Windup or CFG.DefaultM1Lead) + (spec.Endlag or 0.45)) * k1 + (nxt.Windup or CFG.DefaultM1Lead) * k2
	counters.predicted += 1
	react(attacker, {
		kind = "M1",
		lead = lead2,
		reach = reachOf(attacker, style),
		spec = nxt,
		height = nxt.Height or style.M1.Height,
		idx = idx + 1,
		key = key,
		learn = false,
		predicted = true,
	}, "M1*")
end

-- v8: M1 dari attacker barusan nyampe ke lu (kena / ke-block) -> hit combo berikutnya mendarat Endlag_i*k + Windup_(i+1)*k setelah
-- hit itu (swing berikutnya mulai pas busy abis, sama kayak predictFollowUp). Bedanya: dihitung dari event HIT yang beneran nyampe
-- dan dijalanin SETELAH stun/lock ke-update, jadi react nunda Block ON sampai kunci kebuka lalu kirim tepat waktu (parry kalau
-- umur block masuk window, kalau nggak block biasa, kalau block nggak sempat dodge). Gating dilonggarin lewat comboVictim.
local function hitReflex(attacker, now)
	if not (alive and CFG.Enabled and CFG.HitReflex and CFG.BlockFallback) then
		return
	end
	local style = styleOf(attacker)
	local swings = style and style.M1 and style.M1.Swings
	local st = combo[attacker]
	if type(swings) ~= "table" or not st or type(st.idx) ~= "number" then
		return
	end
	local idx = st.idx
	local spec, nxt = swings[idx], swings[idx + 1]
	if type(spec) ~= "table" or type(nxt) ~= "table" then
		return -- swing terakhir: abis ini ada ChainCooldown
	end
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not (ahrp and hrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.ComboKeepRange then
		return
	end
	local k1 = timeScale(attacker, style, spec)
	local k2 = timeScale(attacker, style, nxt)
	counters.reflex += 1
	react(attacker, {
		kind = "M1",
		lead = (spec.Endlag or 0.45) * k1 + (nxt.Windup or CFG.DefaultM1Lead) * k2,
		reach = reachOf(attacker, style),
		spec = nxt,
		height = nxt.Height or style.M1.Height,
		idx = idx + 1,
		key = attacker.Name .. ":" .. (idx + 1),
		learn = false,
		predicted = true,
		reflex = true,
	}, "M1r")
end

-- v10: skill multi-hit (barrage). Skill nggak ngirim Sound/Flash swing yang bisa dibaca, jadi dipandu dari event Hit:
-- hit ke-n nyampe -> hit ke-(n+1) mendarat Interval setelahnya (lead dihitung dari kedatangan event, sama kayak hitReflex).
-- SK.barr[attacker] = { n = hit ke-n barrage ini, at = hit terakhir yang nyampe, spec }; SK.seen = Kind hit yang udah dicatat

function SK.norm(s)
	if type(s) ~= "string" then
		return nil
	end
	return (s:lower():gsub("[%s_]+", ""))
end

function SK.spec(attacker, gap)
	local mine = SK.norm(attacker:GetAttribute("Style"))
	local best, bestE = nil, math.huge
	for _, b in ipairs(Specs.barrages) do
		local bs = SK.norm(b.style)
		if bs == nil or bs == mine then
			local e = gap and math.abs(b.interval - gap) or (bs == mine and 0 or 0.5)
			if e < bestE then
				best, bestE = b, e
			end
		end
	end
	if best then
		return best
	end
	return { name = "?", hits = CFG.BarrageDefaultHits, interval = CFG.BarrageDefaultInterval, breaks = false }
end

function SK.reflex(attacker, now, res)
	if not (alive and CFG.Enabled and CFG.BarrageGuard and CFG.BlockFallback) then
		return
	end
	local b0 = SK.barr[attacker]
	local n, spec
	if b0 and (now - b0.at) <= b0.spec.interval * CFG.BarrageWindow then
		n = b0.n + 1
		spec = (n == 2) and SK.spec(attacker, now - b0.at) or b0.spec
	else
		n, spec = 1, SK.spec(attacker, nil)
	end
	SK.barr[attacker] = { n = n, at = now, spec = spec }

	-- attacker yang lagi nge-barrage lu tetap ancaman walau cek hitbox meleset (sama kayak combo M1)
	local cv = comboVictim[attacker]
	if cv and now - cv.at < CFG.ComboKeepTime then
		cv.n += 1
	else
		cv = { n = 1 }
		comboVictim[attacker] = cv
	end
	cv.at = now

	if n >= spec.hits then
		return -- hit terakhir
	end
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not (ahrp and hrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.ComboKeepRange * 1.5 then
		return
	end
	counters.barrage += 1
	react(attacker, {
		kind = spec.breaks and "M2" or "M1",
		lead = spec.interval,
		reach = numAttr(attacker, "ReachFactor", 1),
		key = "SK:" .. attacker.Name,
		learn = false,
		predicted = true,
		reflex = true,
		nocorr = true,
		skill = true,
	}, "SK")
end

-- v11: abis LU nge-parry attacker. Server ngasih attacker stun (ParryAttackerRecovery 0.75s). Kalau block dilepas sekarang,
-- BlockReadyAt = +0.75s (BlockCooldown); hit lanjutan attacker itu mendarat (stun + windup) setelah sekarang, jadi jendela
-- buat Block ON = stun + windup - BlockCooldown - ping - frame - noise. Return jam client sampai kapan block ditahan,
-- atau nil = lepas sekarang (re-parry masih masuk akal di ping/fps lu dan nggak ada attacker lain yang aktif).
function SK.postParry(attacker, data, now)
	local rtt, fl, sg = net.rtt, frameLag(), sigmaNow()
	local stun = (type(data.AttackerStun) == "number" and data.AttackerStun > 0) and data.AttackerStun or SR.ParryRecovery
	local wind = CFG.DefaultM1Lead
	if typeof(attacker) == "Instance" then
		local style = styleOf(attacker)
		local m1 = style and style.M1
		local sw = type(m1) == "table" and type(m1.Swings) == "table" and m1.Swings[1] or nil
		if type(sw) == "table" and type(sw.Windup) == "number" then
			wind = sw.Windup * timeScale(attacker, style, sw)
		end
	end
	local followAt = now + stun + wind -- paling cepat hit lanjutan attacker yang ke-parry mendarat (jam client)
	local slack = (stun + wind) - SR.BlockCooldown - rtt - fl - 2 * sg - CFG.ReparryPad
	local crowd = false
	local _, hrp = myState()
	if hrp then
		for a, t in pairs(lastSwingSeen) do
			if a ~= attacker and now - t < CFG.HotWindow * 1.5 and typeof(a) == "Instance" and a.Parent then
				local ah = a:FindFirstChild("HumanoidRootPart")
				if ah and (ah.Position - hrp.Position).Magnitude <= CFG.HotRadius then
					crowd = true
					break
				end
			end
		end
	end
	if slack >= CFG.ReparryMinSlack and not crowd then
		return nil
	end
	local lp = SK.lagPad()
	return math.max(
		followAt + CFG.ResultPad + SK.resPad() + holdAfter() + CFG.PostParryTail + lp,
		now + SR.ParryCooldown + holdAfter() + lp
	)
end

-- v11.2: jarak datar attacker ke lu (buat Why)
function SK.flatDist(a)
	if typeof(a) ~= "Instance" then
		return nil
	end
	local _, hrp = myState()
	local ah = a:FindFirstChild("HumanoidRootPart")
	if not (hrp and ah) then
		return nil
	end
	local d = hrp.Position - ah.Position
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

-- v11.2: M2 kena skip "range" pas telegraf. Windup M2 panjang (0.5-0.9s) dan attacker bisa lari / nge-dash nutup jarak, jadi
-- cek ulang pakai posisi terbaru selama sisa lead masih cukup buat parry/dodge. Satu kali recheck per swing.
function SK.m2Recheck(attacker, plan, tag, now)
	if typeof(attacker) ~= "Instance" then
		return
	end
	local need = targetAgeFor(true) + net.rtt + frameLag() + CFG.M2RecheckSafety
	local delay = math.min(plan.lead - need, 0.30)
	if delay < 0.05 then
		return
	end
	local tok = planToken[attacker] or 0
	schedule(now + delay, function()
		if not alive or not CFG.Enabled or (planToken[attacker] or 0) ~= tok then
			return -- EndFlash / parry / plan lain udah nge-reset swing ini
		end
		local p2 = {}
		for k, v in pairs(plan) do
			p2[k] = v
		end
		p2.lead = plan.lead - (os.clock() - now)
		p2.rechecked = true
		react(attacker, p2, tag)
	end)
end

-- v11.1: event Parried nyampe pas block udah keburu lepas (BlockReadyAt = lepas + 0.75s). Jadwalin Block ON se-awal mungkin
-- yang masih diterima server tapi sebelum hit lanjutan attacker mendarat. Kalau hit lanjutan mendarat sebelum block siap -> skip.
function SK.postParryLate(attacker, data, now)
	if not (alive and CFG.Enabled) or typeof(attacker) ~= "Instance" then
		return
	end
	local rtt, fl = net.rtt, frameLag()
	local stun = (type(data.AttackerStun) == "number" and data.AttackerStun > 0) and data.AttackerStun or SR.ParryRecovery
	local wind = CFG.DefaultM1Lead
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local sw = type(m1) == "table" and type(m1.Swings) == "table" and m1.Swings[1] or nil
	if type(sw) == "table" and type(sw.Windup) == "number" then
		wind = sw.Windup * timeScale(attacker, style, sw)
	end
	local followAt = now + stun + wind
	local readyAt = lastOwnOff + SR.BlockCooldown + 0.02 + fl
	local sendAt = math.max(readyAt, followAt - rtt - fl - 0.10)
	if sendAt > followAt - rtt - fl then
		evt("info", "hit lanjutan keburu mendarat sebelum block siap")
		return
	end
	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	schedule(sendAt, function()
		if not alive or not CFG.Enabled or planToken[attacker] ~= tok then
			return
		end
		if blockHeld then
			extendHoldTo(followAt + CFG.PostParryTail + holdAfter())
			return
		end
		if attackerGone(attacker) then
			return
		end
		local _, hrp = myState()
		local ah = attacker:FindFirstChild("HumanoidRootPart")
		if not (hrp and ah) or (ah.Position - hrp.Position).Magnitude > CFG.ComboKeepRange + 6 then
			return
		end
		local hold = math.max(followAt - os.clock(), 0) + CFG.PostParryTail + holdAfter() + SK.lagPad()
		if pressBlock(hold) then
			pressMode = "plain"
			blockFor = nil
			evt("info", "block cadangan abis parry")
		end
	end)
end

-- v11: LU yang ke-parry musuh (stun). 
