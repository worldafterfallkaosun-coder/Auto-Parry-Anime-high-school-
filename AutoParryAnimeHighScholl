----------------------------------------------------------------------
-- SCHEDULER (Heartbeat) + FPS TRACKER
----------------------------------------------------------------------
local queue = {}

local function schedule(at, fn)
	local h = { at = at, fn = fn, dead = false }
	queue[#queue + 1] = h
	return h
end

local function cancel(h)
	if h then
		h.dead = true
	end
end

local frame = { avg = 1 / 60, p90 = 1 / 60, fps = 60 }
local dtRing, dtN, dtIdx, dtTick = {}, 48, 0, 0

local function trackFrame(dt)
	dt = math.clamp(dt, 1 / 240, 0.25)
	dtIdx = dtIdx % dtN + 1
	dtRing[dtIdx] = dt
	frame.avg = frame.avg + (dt - frame.avg) * 0.08
	dtTick += 1
	if dtTick >= 12 then
		dtTick = 0
		local copy = table.clone(dtRing)
		table.sort(copy)
		frame.p90 = copy[math.max(1, math.ceil(#copy * 0.9))]
	end
	frame.fps = 1 / math.max(frame.avg, 0.001)
end

local function frameLag()
	return frame.avg * (CFG.RecvFrame + CFG.SendFrame)
end

----------------------------------------------------------------------
-- PING TRACKER
----------------------------------------------------------------------
local net = { rtt = 0.10, var = 0.012, at = -math.huge }

local function readPing()
	if CFG.PingOverride then
		return CFG.PingOverride
	end
	local ok, ms = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if ok and type(ms) == "number" and ms > 0 then
		return ms / 1000
	end
	local ok2, p = pcall(function()
		return LocalPlayer:GetNetworkPing()
	end)
	if ok2 and type(p) == "number" and p > 0 then
		return p * 2 -- GetNetworkPing = satu arah
	end
	return nil
end

local function sampleNet(now)
	if now - net.at < 0.1 then
		return
	end
	net.at = now
	local s = readPing()
	if not s then
		return
	end
	if CFG.PingOverride then
		net.rtt = s
		net.var = 0.004
		return
	end
	local err = s - net.rtt
	local gain = (err > 0.08) and 0.10 or 0.25 -- lonjakan sesaat jangan langsung dipercaya
	net.rtt += err * gain
	net.var += (math.abs(err) - net.var) * 0.20
	net.var = math.clamp(net.var, 0.002, 0.12)
end

----------------------------------------------------------------------
-- RIWAYAT POSISI LU (server nge-rewind posisi lu, jadi masa lalu juga penting)
----------------------------------------------------------------------
local H_N = 128
local hT, hP, hHead, hCount = {}, {}, 0, 0
local histOwner = nil

local function pushPos(t, p)
	hHead = hHead % H_N + 1
	hT[hHead] = t
	hP[hHead] = p
	if hCount < H_N then
		hCount += 1
	end
end

-- posisi `sec` detik yang lalu (interpolasi), nil kalau belum ada riwayat
local function posAgo(sec)
	if hCount == 0 then
		return nil
	end
	local want = os.clock() - sec
	local prevT, prevP
	for i = 0, hCount - 1 do
		local idx = (hHead - i - 1) % H_N + 1
		local t = hT[idx]
		if t <= want then
			if prevT and prevT > t then
				local a = (want - t) / (prevT - t)
				return hP[idx]:Lerp(prevP, a)
			end
			return hP[idx]
		end
		prevT, prevP = t, hP[idx]
	end
	return prevP
end

local function predictedPos(hrp, t)
	local v = hrp.AssemblyLinearVelocity
	return hrp.Position + Vector3.new(v.X, 0, v.Z) * t
end

-- h > 0 = prediksi ke depan, h < 0 = posisi di masa lalu
local function posAtRel(hrp, h)
	if h >= 0 then
		return predictedPos(hrp, h)
	end
	return posAgo(-h) or hrp.Position
end

----------------------------------------------------------------------
-- STATE GAME SENDIRI (CombatHandler.Local)
----------------------------------------------------------------------
local Game = { handler = nil }

local function getHandler()
	if Game.handler ~= nil then
		return Game.handler or nil
	end
	local ok, mod = pcall(function()
		local m = ReplicatedStorage:FindFirstChild("Modules")
		local sh = m and m:FindFirstChild("Shared")
		local ch = sh and sh:FindFirstChild("CombatHandler")
		return ch and require(ch)
	end)
	if ok and type(mod) == "table" then
		Game.handler = mod
	else
		Game.handler = false
	end
	return Game.handler or nil
end

-- hasil: jam os.clock() paling awal Block ON PASTI diterima server, atau nil kalau nggak tau
local function gameLock()
	if not CFG.UseGameState then
		return nil
	end
	local h = getHandler()
	local L = h and h.Local
	if type(L) ~= "table" then
		return nil
	end
	local ok, res = pcall(function()
		local sn = workspace:GetServerTimeNow()
		local clk = os.clock()
		local latest = -math.huge
		-- Busy / BlockReady di-set client pas lu mencet; server nerima rtt/2 lebih lambat,
		-- paket kita juga nyampe rtt/2 lebih lambat -> saling cancel, pakai nilai client langsung.
		local k1 = L.BusyUntil
		if type(k1) == "number" and k1 > sn then
			latest = math.max(latest, clk + (k1 - sn))
		end
		local k2 = L.BlockReadyAt
		if type(k2) == "number" and k2 > sn then
			latest = math.max(latest, clk + (k2 - sn))
		end
		-- Stun / GuardBreak datang dari server, client tau telat ~rtt/2
		local k3 = L.StunnedUntil
		if type(k3) == "number" and k3 > sn then
			latest = math.max(latest, clk + (k3 - sn) - net.rtt * 0.5)
		end
		local k4 = L.GuardBrokenUntil
		if type(k4) == "number" and k4 > sn then
			latest = math.max(latest, clk + (k4 - sn) - net.rtt * 0.5)
		end
		return latest
	end)
	if ok and res ~= -math.huge then
		return res
	end
	return nil
end

----------------------------------------------------------------------
-- LOAD SPEC STYLE (data murni, aman di-require)
----------------------------------------------------------------------
local function tryRequire(inst)
	if typeof(inst) ~= "Instance" or not inst:IsA("ModuleScript") then
		return nil
	end
	local ok, res = pcall(require, inst)
	if ok and type(res) == "table" then
		return res
	end
	return nil
end

local function loadSpecs()
	local ok, gs = pcall(function()
		local m = ReplicatedStorage:WaitForChild("Modules", 10)
		local sh = m and m:WaitForChild("Shared", 10)
		return sh and sh:WaitForChild("GSettings", 10)
	end)
	if not ok or not gs then
		log("GSettings nggak ketemu -> mode fallback (timing konstanta)")
		return
	end

	local cs = tryRequire(gs:FindFirstChild("CombatSettings"))
	if cs then
		SR.ParryWindow = cs.ParryWindow or SR.ParryWindow
		SR.ParryCooldown = cs.ParryCooldown or SR.ParryCooldown
		SR.BlockCooldown = cs.BlockCooldown or SR.BlockCooldown
		SR.GuardBreak = cs.GuardBreakDuration or SR.GuardBreak
		SR.ParryRecovery = cs.ParryAttackerRecovery or SR.ParryRecovery
		SR.RangeTolerance = cs.RangeTolerance or SR.RangeTolerance
		SR.TargetRadius = cs.TargetRadius or SR.TargetRadius
		SR.HitHeight = cs.DefaultHitHeight or SR.HitHeight
		SR.DefaultStyle = cs.DefaultStyle or SR.DefaultStyle
	end

	local stat = tryRequire(gs:FindFirstChild("StatSettings"))
	if stat and type(stat.ReachInfluence) == "number" then
		Specs.reachInfl = stat.ReachInfluence
	end

	local fs = gs:FindFirstChild("FightingStyles")
	if fs then
		for _, child in ipairs(fs:GetChildren()) do
			local t = tryRequire(child)
			if t then
				Specs.styles[child.Name] = t
				Specs.count += 1
				local m1 = t.M1
				local sw = type(m1) == "table" and m1.Swings
				if type(sw) == "table" then
					for _, s in ipairs(sw) do
						if type(s) == "table" and type(s.Sound) == "string" then
							Specs.swingSound[s.Sound] = true
						end
					end
				end
			end
		end
	end
	log(("spec kebaca: %d style | parryWindow %.2f | blockCooldown %.2f"):format(Specs.count, SR.ParryWindow, SR.BlockCooldown))
end

local function styleOf(char)
	local name = char:GetAttribute("Style")
	if type(name) ~= "string" then
		name = SR.DefaultStyle
	end
	return Specs.styles[name] or Specs.styles[SR.DefaultStyle]
end

