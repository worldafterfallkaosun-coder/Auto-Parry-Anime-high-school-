----------------------------------------------------------------------
-- SCHEDULER (Heartbeat) + FPS TRACKER
----------------------------------------------------------------------
local queue = {}
local frame = { avg = 1 / 60, p90 = 1 / 60, fps = 60, dev = 0.002 }

local function runHandle(h)
	if h.dead or h.ran then
		return
	end
	h.ran = true
	local ok, err = pcall(h.fn)
	if not ok then
		print("[AutoParry] error:", err)
	end
end

local function schedule(at, fn)
	local h = { at = at, fn = fn, dead = false, ran = false }
	-- v6: udah waktunya (atau kurang dari FireEarly frame lagi) -> jalan sekarang, jangan nunggu frame berikutnya
	if CFG.ImmediateFire and at - frame.avg * CFG.FireEarly <= os.clock() then
		runHandle(h)
		return h
	end
	queue[#queue + 1] = h
	return h
end

local function cancel(h)
	if h then
		h.dead = true
	end
end

-- v5: tanpa alokasi. p90 ~= rata-rata + 1.6 * rata-rata simpangan (aproksimasi, nggak perlu sort lagi)
local function trackFrame(dt)
	dt = math.clamp(dt, 1 / 240, 0.25)
	local d = dt - frame.avg
	frame.avg += d * 0.08
	frame.dev += (math.abs(d) - frame.dev) * 0.08
	frame.p90 = frame.avg + frame.dev * 1.6
	frame.fps = 1 / math.max(frame.avg, 0.001)
end

local function frameLag()
	return frame.avg * (CFG.RecvFrame + CFG.SendFrame)
end

----------------------------------------------------------------------
-- PING TRACKER
----------------------------------------------------------------------
local net = { rtt = 0.10, var = 0.012, at = -math.huge }

-- v8: kompensasi jaringan buat timer stun (dihitung dari saat event Hit nyampe). Stun server mulai pas hit mendarat, event nyampe
-- rtt/2 kemudian, dan paket Block kita butuh rtt/2 lagi -> paling cepat dikirim (event + Stun - rtt). v7 cuma ngurangin rtt/2.
-- stunSlack = fraksi rtt yang masih disisakan sebagai pengaman (0.5 = persis v7). Turun pelan kalau block yang dikirim pas unlock
-- terbukti diterima, naik lagi kalau server nolak (BlockRefused).
local function stunComp()
	if not CFG.FastUnlock then
		return net.rtt * 0.5
	end
	return net.rtt * (1 - stunSlack)
end

local pingItem = nil
local pingTryAt = -math.huge -- v9: kapan terakhir nyoba ambil Stats (retry tiap 2 detik kalau gagal)

local function readPing()
	if CFG.PingOverride then
		return CFG.PingOverride
	end
	if not pingItem and os.clock() - pingTryAt > 2 then
		pingTryAt = os.clock()
		local okItem, item = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]
		end)
		pingItem = (okItem and item) or false
	end
	if pingItem then
		local ok, ms = pcall(pingItem.GetValue, pingItem)
		if ok and type(ms) == "number" and ms > 0 then
			return ms / 1000
		end
	end
	local ok2, p = pcall(LocalPlayer.GetNetworkPing, LocalPlayer)
	if ok2 and type(p) == "number" and p > 0 then
		return p * 2 -- GetNetworkPing = satu arah
	end
	return nil
end

local function sampleNet(now)
	if now - net.at < 0.1 then
		return
	end
	net.at = now
	local s = readPing()
	if not s then
		return
	end
	if CFG.PingOverride then
		net.rtt = s
		net.var = 0.004
		return
	end
	local err = s - net.rtt
	local gain = (err > 0.08) and 0.10 or 0.25 -- lonjakan sesaat jangan langsung dipercaya
	net.rtt += err * gain
	net.var += (math.abs(err) - net.var) * 0.20
	net.var = math.clamp(net.var, 0.002, 0.12)
end

----------------------------------------------------------------------
-- RIWAYAT POSISI LU (server nge-rewind posisi lu, jadi masa lalu juga penting)
----------------------------------------------------------------------
local H_N = 128
local hT, hP, hHead, hCount = {}, {}, 0, 0
local histOwner = nil

local function pushPos(t, p)
	hHead = hHead % H_N + 1
	hT[hHead] = t
	hP[hHead] = p
	if hCount < H_N then
		hCount += 1
	end
end

-- posisi `sec` detik yang lalu (interpolasi), nil kalau belum ada riwayat
local function posAgo(sec)
	if hCount == 0 then
		return nil
	end
	local want = os.clock() - sec
	local prevT, prevP
	for i = 0, hCount - 1 do
		local idx = (hHead - i - 1) % H_N + 1
		local t = hT[idx]
		if t <= want then
			if prevT and prevT > t then
				local a = (want - t) / (prevT - t)
				return hP[idx]:Lerp(prevP, a)
			end
			return hP[idx]
		end
		prevT, prevP = t, hP[idx]
	end
	return prevP
end

local function predictedPos(hrp, t)
	local v = hrp.AssemblyLinearVelocity
	return hrp.Position + Vector3.new(v.X, 0, v.Z) * t
end

-- h > 0 = prediksi ke depan, h < 0 = posisi di masa lalu
local function posAtRel(hrp, h)
	if h >= 0 then
		return predictedPos(hrp, h)
	end
	return posAgo(-h) or hrp.Position
end

----------------------------------------------------------------------
-- STATE GAME SENDIRI (CombatHandler.Local)
----------------------------------------------------------------------
local Game = { handler = nil }

local function getHandler()
	-- v7: kalau require gagal (modul belum siap pas script jalan), coba lagi tiap 3 detik, jangan nyerah selamanya
	if Game.handler ~= nil and (Game.handler or os.clock() - (Game.failAt or 0) < 3) then
		return Game.handler or nil
	end
	local ok, mod = pcall(function()
		local m = ReplicatedStorage:FindFirstChild("Modules")
		local sh = m and m:FindFirstChild("Shared")
		local ch = sh and sh:FindFirstChild("CombatHandler")
		return ch and require(ch)
	end)
	if ok and type(mod) == "table" then
		Game.handler = mod
	else
		Game.handler = false
		Game.failAt = os.clock()
	end
	return Game.handler or nil
end

local function lockField(L, key, sn)
	local v = L[key]
	if type(v) == "number" and v > sn then
		return v - sn
	end
	return nil
end

local function readLock(L, sn, clk, halfRtt)
	local latest = -math.huge
	-- Busy / BlockReady di-set client pas lu mencet; server nerima rtt/2 lebih lambat,
	-- paket kita juga nyampe rtt/2 lebih lambat -> saling cancel, pakai nilai client langsung.
	local a = lockField(L, "BusyUntil", sn)
	if a then
		latest = math.max(latest, clk + a)
	end
	local b = lockField(L, "BlockReadyAt", sn)
	if b then
		latest = math.max(latest, clk + b)
	end
	-- Stun / GuardBreak datang dari server, client tau telat ~rtt/2
	local c = lockField(L, "StunnedUntil", sn)
	if c then
		latest = math.max(latest, clk + c - halfRtt)
	end
	local d = lockField(L, "GuardBrokenUntil", sn)
	if d then
		latest = math.max(latest, clk + d - halfRtt)
	end
	return latest
end

-- hasil: jam os.clock() paling awal Block ON PASTI diterima server, atau nil kalau nggak tau
local function gameLock()
	if not CFG.UseGameState then
		return nil
	end
	local h = getHandler()
	local L = h and h.Local
	if type(L) ~= "table" then
		return nil
	end
	local ok, res = pcall(readLock, L, workspace:GetServerTimeNow(), os.clock(), stunComp())
	if ok and res ~= -math.huge and res < os.clock() + 3 then
		return res -- nilai > 3 detik ke depan dianggap bogus
	end
	return nil
end

