----------------------------------------------------------------------
-- BLOCK
----------------------------------------------------------------------
local function sendBlock(on)
	Combat:FireServer({ Info = "Block", On = on })
end

local function scheduleRelease(at)
	releaseAt = at
	cancel(releaseHandle)
	releaseHandle = schedule(at, function()
		if not blockHeld then
			return
		end
		sendBlock(false)
		blockHeld = false
		-- server: BlockReadyAt = waktu Block OFF + BlockCooldown
		readyAt = os.clock() + SR.BlockCooldown
	end)
end

local function pressBlock(hold)
	local now = os.clock()
	if blockHeld or now < readyAt - 0.005 or now < lockedUntil then
		return false
	end
	local gl = gameLock()
	if gl and now < gl - 0.01 then
		return false
	end
	-- lu lagi nahan block manual -> jangan diganggu (OFF kita bakal ngelepas block lu)
	local char = LocalPlayer.Character
	if char and char:GetAttribute("Blocking") == true then
		return false
	end
	blockHeld = true
	blockOnAt = now
	counters.fired += 1
	sendBlock(true)
	scheduleRelease(now + hold)
	return true
end

-- pastikan block yang lagi nyala masih nyala sampai `untilClock`
local function extendHoldTo(untilClock)
	if not blockHeld then
		return false
	end
	local want = math.min(untilClock, blockOnAt + CFG.MaxHold)
	if want > releaseAt then
		scheduleRelease(want)
	end
	return true
end

local function releaseBefore(t)
	if not blockHeld or releaseAt <= t then
		return
	end
	scheduleRelease(math.max(t, os.clock()))
	counters.released += 1
end

-- server udah nolak / matiin block kita -> batalin rencana release, jangan kirim OFF sia-sia
local function dropLocalBlock()
	cancel(releaseHandle)
	blockHeld = false
end

----------------------------------------------------------------------
-- PREDIKSI WAKTU HIT & ANCAMAN
----------------------------------------------------------------------
local function timeScale(char, style, spec)
	local sf = numAttr(char, "SwingFactor", 1)
	local sp = ((style and style.Speed) or 1) * ((spec and spec.SwingSpeed) or 1)
	if sp <= 0 then
		sp = 1
	end
	return sf / sp
end

local function reachOf(char, style)
	local r = numAttr(char, "ReachFactor", 1)
	if style and style.ReachInfluence and Specs.reachInfl and Specs.reachInfl ~= 0 then
		r = 1 + (r - 1) / Specs.reachInfl * style.ReachInfluence
	end
	return r
end

-- tiru NextCombo server: reset ke 1 kalau kelamaan / abis stun, selain itu maju terus
local function nextCombo(char, style, now)
	local swings = style.M1.Swings
	local st = combo[char]
	local idx
	if not st or st.idx <= 0 then
		idx = 1
	else
		local prev = swings[st.idx]
		local window = (style.M1.ComboWindow or 0.8) + ((prev and prev.Endlag) or 0)
		if now - st.at > window then
			idx = 1
		else
			idx = st.idx % #swings + 1
		end
	end
	combo[char] = { idx = idx, at = now }
	return idx
end

local function m1Plan(attacker, now)
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local swings = type(m1) == "table" and m1.Swings
	if type(swings) ~= "table" or #swings == 0 then
		return {
			kind = "M1",
			lead = CFG.DefaultM1Lead * numAttr(attacker, "SwingFactor", 1),
			reach = numAttr(attacker, "ReachFactor", 1),
		}
	end
	local idx = nextCombo(attacker, style, now)
	local spec = swings[idx]
	if type(spec) ~= "table" then
		spec = swings[1]
		idx = 1
	end
	return {
		kind = "M1",
		lead = (spec.Windup or CFG.DefaultM1Lead) * timeScale(attacker, style, spec),
		reach = reachOf(attacker, style),
		spec = spec,
		height = spec.Height or m1.Height,
		idx = idx,
		key = attacker.Name .. ":" .. idx,
		learn = true,
	}
end

-- hold = Hold dari Flash (nil kalau datang dari Sound HeavySwing)
local function m2Plan(attacker, hold)
	local style = styleOf(attacker)
	local spec = style and style.M2
	if type(spec) ~= "table" then
		return {
			kind = "M2",
			lead = math.max(hold or CFG.HeavyMin, CFG.HeavyMin),
			reach = numAttr(attacker, "ReachFactor", 1),
		}
	end

	local k = timeScale(attacker, style, spec)
	local windup = (spec.Windup or hold or CFG.HeavyMin) * k
	local lunge = spec.Lunge
	if type(lunge) == "table" and (lunge.Speed or 0) > 0 and not spec.Sweep then
		local lw = (lunge.Time or 0) + (lunge.Settle or 0)
		if lw > windup then
			windup = lw
		end
	end

	local lead = windup
	local followUps = spec.FollowUps
	if type(followUps) == "table" and #followUps > 0 then
		-- cuma hit PERTAMA yang penting: parry dia = attacker stun = sisanya batal
		for _, f in ipairs(followUps) do
			local at = ((type(f) == "table" and f.At) or 0) * k
			if at < lead then
				lead = at
			end
		end
	elseif hold then
		local fromHold = hold - (spec.FlashTail or 0)
		if math.abs(lead - fromHold) > 0.12 then
			lead = fromHold -- spec nggak nyambung sama yang dikirim server -> percaya server
		end
	end

	return {
		kind = "M2",
		lead = lead,
		reach = reachOf(attacker, style),
		spec = spec,
		height = spec.Height,
		key = attacker.Name .. ":M2",
		-- jarak-dependen (sweep/projectile/throw/dash/teleport) nggak ikut dipelajari
		learn = not (spec.Sweep or spec.Projectile or spec.Throw or spec.Dash or spec.Teleport),
	}
end

-- sweep / projectile / throw: hit pertama tergantung jarak
local function refineLead(plan, dist)
	local spec = plan.spec
	if type(spec) ~= "table" then
		return plan.lead
	end
	local lead = plan.lead
	local reachEff = (spec.Range or 6) * plan.reach + SR.RangeTolerance + SR.TargetRadius

	if type(spec.Sweep) == "table" then
		local first = spec.Sweep.Start or 0
		local l = spec.Lunge
		if type(l) == "table" and (l.Speed or 0) > 0 then
			local t = (l.Delay or 0) + math.max(0, dist - reachEff) / l.Speed
			first = math.max(first, t)
		end
		return first
	end
	if type(spec.Projectile) == "table" and (spec.Projectile.Speed or 0) > 0 then
		return lead + math.max(0, dist - (spec.Projectile.Forward or 0)) / spec.Projectile.Speed
	end
	if type(spec.Throw) == "table" and (spec.Throw.OutTime or 0) > 0 then
		local speed = (spec.Throw.Distance or 24) / spec.Throw.OutTime
		local travel = math.max(0, dist - (spec.Throw.Forward or 0)) / math.max(speed, 1)
		return lead + math.min(travel, spec.Throw.OutTime)
	end
	return lead
end

local function extraReach(spec)
	if type(spec) ~= "table" then
		return 0
	end
	local e = 0
	local l = spec.Lunge
	if type(l) == "table" and (l.Speed or 0) > 0 then
		e = math.max(e, (l.Speed or 0) * (l.Time or 0))
	end
	if type(spec.Pull) == "table" then
		e = math.max(e, spec.Pull.Range or 12)
	end
	if type(spec.Teleport) == "table" then
		e = math.max(e, spec.Teleport.Range or 0)
	end
	if type(spec.Dash) == "table" then
		e = math.max(e, spec.Dash.Distance or 0)
	end
	if type(spec.Projectile) == "table" then
		e = math.max(e, spec.Projectile.Distance or 0)
	end
	if type(spec.Throw) == "table" then
		e = math.max(e, spec.Throw.Distance or 0)
	end
	return e
end

-- tiru InReach server: kotak di depan attacker (Range + toleransi, lebar Radius, tinggi Height)
-- boost = margin ekstra (stud) karena ping
local function inVolume(ahrp, pos, plan, boost)
	local spec, reach = plan.spec, plan.reach or 1
	local d = pos - ahrp.Position
	local flat = Vector3.new(d.X, 0, d.Z)
	local mag = flat.Magnitude

	if not (CFG.UseVolume and type(spec) == "table" and type(spec.Range) == "number") then
		if mag > CFG.FallbackRange * reach + boost then
			return false
		end
		if mag > 0.5 and CFG.FallbackFacingDot > -1 then
			local look = ahrp.CFrame.LookVector
			local fl = Vector3.new(look.X, 0, look.Z)
			if fl.Magnitude > 0 and fl.Unit:Dot(flat.Unit) < CFG.FallbackFacingDot then
				return false
			end
		end
		return true
	end

	local height = (plan.height or SR.HitHeight) + 2
	if math.abs(d.Y) > height then
		return false
	end
	local range = spec.Range * reach + SR.RangeTolerance + SR.TargetRadius + CFG.RangeMargin + boost + extraReach(spec)
	if spec.MinRange and mag < spec.MinRange * reach - 1 then
		return false
	end
	if spec.Radial then
		return mag <= range
	end
	if mag < 0.5 then
		return true
	end
	local look = ahrp.CFrame.LookVector
	local fl = Vector3.new(look.X, 0, look.Z)
	if fl.Magnitude < 0.01 then
		return mag <= range
	end
	fl = fl.Unit
	local fwd = flat:Dot(fl)
	if fwd < -CFG.BackMargin or fwd > range then
		return false
	end
	local lat = (flat - fl * fwd).Magnitude
	local half = (spec.Radius or 2.5)
		+ SR.TargetRadius
		+ CFG.WidthMargin
		+ boost * 0.5
		+ math.min(math.max(fwd, 0), 8) * CFG.ConeSlack
	return lat <= half
end

local OFFS = { 0, -1, 1 }

local function threatens(attacker, myHrp, plan, lead)
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not ahrp then
		return false, 0
	end
	local d = myHrp.Position - ahrp.Position
	local dist = Vector3.new(d.X, 0, d.Z).Magnitude
	local boost = math.clamp(net.rtt * CFG.PingMargin, 0, CFG.MaxPingMargin)

	if inVolume(ahrp, myHrp.Position, plan, boost) then
		return true, dist
	end
	-- server ngecek posisi lu yang di-rewind (bisa di masa lalu) + gerak lu selama windup.
	-- Coba beberapa horizon: kena di salah satu = anggap ancaman.
	local h = lead - CFG.AttackerLag - net.rtt
	for _, o in ipairs(OFFS) do
		local hh = math.clamp(h + o * CFG.LagSpread, -0.5, 0.45)
		if inVolume(ahrp, posAtRel(myHrp, hh), plan, boost) then
			return true, dist
		end
	end
	return false, dist
end

----------------------------------------------------------------------
-- ARBITRASE RENCANA (satu parry per jendela cooldown, M2 menang atas M1)
----------------------------------------------------------------------
local function arbitrate(kind, hitAt, now)
	for i = #pending, 1, -1 do
		local p = pending[i]
		if p.done or p.hit < now - 0.2 then
			table.remove(pending, i)
		end
	end
	for i = #pending, 1, -1 do
		local p = pending[i]
		local gap = math.abs(hitAt - p.hit)
		if gap < CFG.ConflictWindow then
			if kind == "M2" and p.kind == "M1" then
				-- M2 = GuardBroken kalau nggak diparry, M1 cukup ke-Block -> M2 yang diprioritaskan
				cancel(p.handle)
				table.remove(pending, i)
				counters.cancelled += 1
			elseif gap < CFG.DedupeWindow or (kind == "M1" and p.kind == "M2") then
				return "dup"
			end
		end
	end
	return "ok"
end

----------------------------------------------------------------------
-- REACT
----------------------------------------------------------------------
local function corrFor(attacker, plan)
	if plan.key then
		local c = leadCorr[plan.key]
		if c then
			return c
		end
	end
	if plan.kind == "M1" then
		return leadAll[attacker.Name] or 0
	end
	return 0
end

local function react(attacker, plan, tag)
	if not alive or not CFG.Enabled or typeof(attacker) ~= "Instance" then
		return
	end
	local char, hrp = myState()
	if not char or attacker == char then
		return
	end
	local why = cannotAct(char)
	if why then
		return skip(why)
	end
	local ahum = attacker:FindFirstChildOfClass("Humanoid")
	if ahum and ahum.Health <= 0 then
		return
	end
	if plan.spec and plan.spec.Unparryable then
		return skip("unparryable")
	end

	local now = os.clock()
	sampleNet(now)
	local rtt = net.rtt
	local fl = frameLag()
	local corr = corrFor(attacker, plan)

	local isThreat, dist = threatens(attacker, hrp, plan, plan.lead + corr)
	if not isThreat then
		return skip("range")
	end

	local lead
	if plan.kind == "M1" then
		lead = plan.lead + corr
	else
		lead = refineLead(plan, dist) + corr
	end

	-- parry masih cooldown: M2 (BreaksBlock) jadi GuardBroken kalau cuma ke-Block.
	-- Block yang masih nyala dilepas sebelum M2 mendarat -> cuma kena hit biasa.
	if plan.kind == "M2" and now + lead < parriedAt + SR.ParryCooldown - 0.02 then
		if CFG.ReleaseBeforeHeavy then
			releaseBefore(now + lead - rtt - fl - 0.03)
		end
		return skip("parrycd")
	end

	-- hit bakal mendarat pas lu masih iframe (abis dash) -> nggak perlu
	local iu = char:GetAttribute("IFramesUntil")
	if type(iu) == "number" and iu > workspace:GetServerTimeNow() + lead then
		return skip("iframes")
	end

	-- Block yang dikirim sekarang nyampe di server ~rtt/2 lagi, hit nyampe di server lead - rtt/2 - (telat proses event)
	-- dari sekarang, jadi umur block saat hit = lead - rtt - fl - sendIn.
	local targetAge = (plan.kind == "M2") and CFG.TargetAgeM2 or CFG.TargetAgeM1
	local sendIn = lead - targetAge - rtt - fl + tune[plan.kind] + (math.random() * 2 - 1) * CFG.Jitter
	local earliest = math.max(readyAt, lockedUntil, gameLock() or -math.huge)
	local wait = earliest - now
	local bound = false
	if sendIn < wait then
		sendIn = wait
		bound = true
	end
	if sendIn < 0 then
		sendIn = 0
	end
	local age = lead - rtt - fl - sendIn

	if age < -CFG.LateTolerance then
		if bound then
			counters.locked += 1
			skip("locked")
			log(("%s kekunci cooldown block (sisa %.2fs, lead %.3f)"):format(tag, wait, lead))
		else
			counters.late += 1
			skip("late")
			log(("%s terlalu cepat buat di-react (lead %.3f <= rtt %.3f + frame %.3f)"):format(tag, lead, rtt, fl))
		end
		local mode = plan.kind == "M2" and CFG.LateModeM2 or CFG.LateModeM1
		if mode == "block" then
			if not pressBlock(CFG.LateHold) and plan.kind == "M1" and CFG.ChainGuard then
				extendHoldTo(now + CFG.LateHold)
			end
		end
		return
	end

	local hitAt = now + lead
	local verdict = arbitrate(plan.kind, hitAt, now)
	if verdict ~= "ok" then
		return skip(verdict)
	end

	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	local ha = holdAfter()
	local hold = math.max(age, 0) + ha
	local coverTo = now + lead - rtt - fl + ha -- block harus tetap nyala sampai jam ini biar hit ini ketutup
	counters.planned += 1
	if CFG.DebugPlan then
		log(
			("%s plan: lead %.3f rtt %.3f±%.3f fps %.0f sendIn %.3f age %.3f hold %.3f tune %+.3f"):format(
				tag, lead, rtt, net.var, frame.fps, sendIn, age, hold, tune[plan.kind]
			)
		)
	end

	local rec = { kind = plan.kind, hit = hitAt, done = false }
	pending[#pending + 1] = rec
	rec.handle = schedule(now + sendIn, function()
		rec.done = true
		if not alive or not CFG.Enabled then
			return
		end
		if planToken[attacker] ~= tok then
			counters.cancelled += 1
			return
		end
		if not pressBlock(hold) then
			-- block udah nyala (rencana sebelumnya / chain): M1 cukup ditutup pakai perpanjangan hold
			if plan.kind == "M1" and CFG.ChainGuard and extendHoldTo(coverTo) then
				counters.chained += 1
			end
		end
	end)
end

----------------------------------------------------------------------
-- COMBAT EVENTS
----------------------------------------------------------------------
local function resyncCombo(attacker, obs)
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local swings = type(m1) == "table" and m1.Swings
	local st = combo[attacker]
	if type(swings) ~= "table" or not st then
		return
	end
	local bestI, bestE = nil, 0.04
	for i, sp in ipairs(swings) do
		if type(sp) == "table" then
			local e = math.abs((sp.Windup or 0) * timeScale(attacker, style, sp) - obs)
			if e < bestE then
				bestI, bestE = i, e
			end
		end
	end
	if bestI then
		st.idx = bestI
	end
end

local function tuneBy(kind, dir)
	if not CFG.Adaptive then
		return
	end
	local s = streak[kind]
	if s.dir == dir then
		s.n += 1
	else
		s.dir = dir
		s.n = 1
	end
	local step = CFG.TuneStep * math.min(1 + (s.n - 1) * 0.5, 3)
	tune[kind] = math.clamp(tune[kind] + dir * step, -CFG.TuneMax, CFG.TuneMax)
end

-- belajar selisih Sound -> Hit per swing (kedua event kena jalur jaringan yang sama,
-- jadi selisihnya = lead sebenarnya di server, nggak kena ping)
local function learnLead(attacker, kind, now)
	local rec = swingAt[attacker]
	if not rec or rec.kind ~= kind then
		return
	end
	swingAt[attacker] = nil
	local obs = now - rec.t
	if obs < 0.04 or obs > 1.0 then
		return
	end
	local err = obs - rec.lead
	if kind == "M1" and math.abs(err) > 0.06 then
		resyncCombo(attacker, obs) -- kemungkinan salah index combo, jangan dipelajari
		return
	end
	if rec.learn and rec.key then
		local cur = leadCorr[rec.key] or 0
		leadCorr[rec.key] = math.clamp(cur * 0.7 + err * 0.3, -0.08, 0.08)
	end
	if kind == "M1" then
		local cur = leadAll[attacker.Name] or 0
		leadAll[attacker.Name] = math.clamp(cur * 0.8 + err * 0.2, -0.06, 0.06)
	end
end

local function onHit(data)
	local attacker, victim = data.Attacker, data.Victim
	local myChar = LocalPlayer.Character
	local now = os.clock()

	if (data.Kind == "M1" or data.Kind == "M2") and typeof(attacker) == "Instance" then
		learnLead(attacker, data.Kind, now)
	end

	-- gue yang nyerang dan ke-parry -> gue yang stun
	if attacker == myChar and data.Result == "Parried" then
		lockedUntil = math.max(lockedUntil, now + (data.AttackerStun or SR.ParryRecovery) - net.rtt / 2)
		return
	end
	if victim ~= myChar then
		return
	end

	local kind = data.Kind == "M2" and "M2" or "M1"
	local sent = (now - blockOnAt) < 0.6 and lastRefusedAt < blockOnAt
	local res = data.Result
	local inParryCd = (now - parriedAt) < SR.ParryCooldown

	if res == "Parried" then
		counters.parried += 1
		parriedAt = now
		streak[kind].n = 0
		streak[kind].dir = 0
		if typeof(attacker) == "Instance" then
			combo[attacker] = nil -- attacker kena stun -> combo reset di server
			planToken[attacker] = (planToken[attacker] or 0) + 1
		end
		log(("PARRY  (%d parry / %d block / %d gb / %d hit)"):format(counters.parried, counters.blocked, counters.guardbroken, counters.hit))
	elseif res == "Blocked" then
		counters.blocked += 1
		-- ke-Block doang = umur block kegedean (kecepetan) -> kirim lebih lambat
		if sent and not inParryCd then
			tuneBy(kind, 1)
		end
		if CFG.ChainGuard and kind == "M1" then
			extendHoldTo(now + CFG.ChainHold)
		end
		log(("block  %s (tune M1 %+.3f M2 %+.3f%s)"):format(kind, tune.M1, tune.M2, inParryCd and ", parry cooldown" or ""))
	elseif res == "GuardBroken" then
		counters.guardbroken += 1
		dropLocalBlock()
		lockedUntil = math.max(lockedUntil, now + SR.GuardBreak - net.rtt / 2)
		if sent and not inParryCd then
			tuneBy(kind, 1)
		end
		log(("GUARD BREAK %s (tune M1 %+.3f M2 %+.3f%s)"):format(kind, tune.M1, tune.M2, inParryCd and ", parry cooldown" or ""))
	elseif res == "Hit" then
		counters.hit += 1
		if type(data.Stun) == "number" then
			lockedUntil = math.max(lockedUntil, now + data.Stun - net.rtt / 2)
		end
		-- kena padahal block udah dikirim = kelambatan -> kirim lebih cepat
		if sent then
			tuneBy(kind, -1)
		end
		local reason = (now - lastSkip.at) < 1.2 and lastSkip.reason or (sent and "block telat" or "nggak ada rencana")
		log(
			("kena   %s (tune M1 %+.3f M2 %+.3f, rtt %.3f±%.3f, fps %.0f, alasan: %s)"):format(
				kind, tune.M1, tune.M2, net.rtt, net.var, frame.fps, reason
			)
		)
	elseif res == "Dodged" then
		counters.dodged += 1
	end
end

local function onCombat(data)
	if type(data) ~= "table" then
		return
	end
	local info, kind = data.Info, data.Kind

	if info == "Sound" then
		local a = data.Character
		if typeof(a) ~= "Instance" or a == LocalPlayer.Character then
			return
		end
		if kind == "HeavySwing" then
			-- cadangan kalau Flash nggak nyampe (Flash biasanya nyampe duluan, jadi ini di-dedupe)
			local now = os.clock()
			if now - (heavySeen[a] or -math.huge) > 0.25 then
				heavySeen[a] = now
				local plan = m2Plan(a, nil)
				swingAt[a] = { t = now, lead = plan.lead, kind = "M2", key = plan.key, learn = plan.learn }
				react(a, plan, "M2")
			end
		elseif Specs.swingSound[kind] then
			local now = os.clock()
			local plan = m1Plan(a, now)
			swingAt[a] = { t = now, lead = plan.lead, kind = "M1", key = plan.key, learn = plan.learn }
			react(a, plan, "M1")
		end
	elseif info == "Flash" and kind == "Heavy" then
		local a, hold = data.Character, data.Hold
		if typeof(a) == "Instance" and a ~= LocalPlayer.Character and type(hold) == "number" then
			local now = os.clock()
			heavySeen[a] = now
			local plan = m2Plan(a, hold)
			swingAt[a] = { t = now, lead = plan.lead, kind = "M2", key = plan.key, learn = plan.learn }
			react(a, plan, "M2")
		end
	elseif info == "EndFlash" then
		-- heavy attacker dibatalin (kena stun / ke-parry orang lain) -> hit nggak bakal mendarat
		local a = data.Character
		if typeof(a) == "Instance" then
			planToken[a] = (planToken[a] or 0) + 1
			swingAt[a] = nil
		end
	elseif info == "Hit" then
		onHit(data)
	elseif info == "BlockRefused" then
		local untilServer = data.Until
		if type(untilServer) == "number" then
			lockedUntil = math.max(lockedUntil, os.clock() + math.max(0, untilServer - workspace:GetServerTimeNow()))
		end
		lastRefusedAt = os.clock()
		counters.refused += 1
		dropLocalBlock()
		log(("block ditolak server (sisa %.2fs)"):format(math.max(0, lockedUntil - os.clock())))
	end
end

----------------------------------------------------------------------
-- REPORT
----------------------------------------------------------------------
local function report()
	local c, s = {}, {}
	for k, v in pairs(counters) do
		table.insert(c, k .. "=" .. v)
	end
	for k, v in pairs(skips) do
		table.insert(s, k .. "=" .. v)
	end
	table.sort(c)
	table.sort(s)
	local tot = counters.parried + counters.blocked + counters.guardbroken + counters.hit
	local rate = tot > 0 and (counters.parried / tot * 100) or 0
	print("[AutoParry] hitung :", table.concat(c, " "))
	print("[AutoParry] skip   :", #s > 0 and table.concat(s, " ") or "-")
	print(("[AutoParry] parry rate %.0f%% dari %d hit yang nyampe ke lu"):format(rate, tot))
	print(
		("[AutoParry] tune M1 %+.3f | M2 %+.3f | rtt %.3f±%.3f | fps %.0f (p90 frame %.0fms) | style kebaca %d | game state %s"):format(
			tune.M1, tune.M2, net.rtt, net.var, frame.fps, frame.p90 * 1000, Specs.count, gameLock() and "ya" or "nggak"
		)
	)
end

