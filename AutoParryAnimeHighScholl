local parts, partIdx, cursor, culledN = {}, {}, 0, 0

local function addPart(p)
    parts[#parts + 1] = p
    partIdx[p] = #parts
end

local function removePart(p)
    local i = partIdx[p]
    if not i then return end
    local last = parts[#parts]
    parts[i] = last
    partIdx[last] = i
    parts[#parts] = nil
    partIdx[p] = nil
    if culled[p] then culled[p] = nil; culledN -= 1 end
end

local function processPart(p)
    local prot = protection(p)
    -- v13.5: avatar / NPC dicek DULU. Dulu tekstur + material karakter dihapus lebih dulu lalu "dipulihkan" hub tiap 1 detik
    -- (avatar sempat blank). Sekarang karakter cuma kena CastShadow, tampilannya nggak disentuh.
    if state.texture and prot ~= "char" then
        set(p, "Material", Enum.Material.SmoothPlastic)
        set(p, "Reflectance", 0)
        if p:IsA("MeshPart") then
            pset(p, "TextureID", "")
            pset(p, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
    if state.shadow then set(p, "CastShadow", false) end
    if prot == "char" then return end
    -- Hide Leaves: part besar (lantai / tanah / tembok) nggak pernah disentuh, dan collision nggak diubah.
    if state.leaf and isLeafName(p.Name) and p.Size.Magnitude < 40 then
        set(p, "Transparency", 1)
        return
    end
    if state.anchor and not prot and not p.Anchored then set(p, "Anchored", true) end
    if p.Transparency < 1 and not partIdx[p] then addPart(p) end
end

