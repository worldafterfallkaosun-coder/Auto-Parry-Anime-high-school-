-- REACT
----------------------------------------------------------------------
local function corrFor(attacker, plan)
	if plan.nocorr then
		return 0 -- v10: plan skill nggak ikut koreksi lead M1
	end
	if plan.key then
		local c = leadCorr[plan.key]
		-- v12: attacker baru (< 3 sampel) dibantu koreksi hasil belajar style yang sama
		if CFG.StylePrior and plan.skey then
			local own = leadN[plan.key] or 0
			if own < 3 then
				local p = SK.priorFor(plan)
				if p then
					if c then
						local w = own / 3
						return c * w + p * (1 - w)
					end
					return p
				end
			end
		end
		if c then
			return c
		end
	end
	if plan.kind == "M1" then
		return leadAll[attacker.Name] or 0
	end
	return 0
end

-- block yang udah nyala dipertahanin sampai hit ini ketutup (block biasa / chain guard)
local function guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, note)
	local verdict = arbitrate(plan.kind, now + lead, now)
	if verdict ~= "ok" then
		return skip(verdict)
	end
	pending[#pending + 1] = { kind = plan.kind, hit = now + lead, done = false }
	noteExpected(attacker, now + lead, now, plan.kind)
	local rp = CFG.ResultPad + SK.resPad()
	guardSwing(attacker, now, now + lead + rp)
	local coverTo = math.max(now + lead - rtt - fl + ha, now + lead + rp)
	if extendHoldTo(coverTo) then
		counters.chained += 1
		if CFG.Trace then trace(("%s dari %s: block ditahan terus (%s), cover sampai +%.3fs"):format(tag, attacker.Name, note, coverTo - now)) end
	else
		if CFG.Trace then trace(("%s dari %s: block udah lepas, nggak bisa ditahan lagi (%s)"):format(tag, attacker.Name, note)) end
	end
end

-- v7: rencana yang diprediksi (swing berikutnya belum kelihatan) dicek ulang sebelum block dikirim
local function predictedStillValid(attacker, plan, hitAt)
	if not attacker.Parent then
		return false
	end
	local ahum = attacker:FindFirstChildOfClass("Humanoid")
	if ahum and ahum.Health <= 0 then
		return false
	end
	local c, h = myState()
	if not (c and h) then
		return false
	end
	local ok, dist = threatens(attacker, h, plan, math.max(hitAt - os.clock(), 0))
	if ok then
		return true
	end
	-- v8: rencana dari reflex combo: attacker masih di sekitar lu dan combo-nya masih jalan -> tetap kirim
	if plan.reflex and CFG.ComboKeep then
		local cv = comboVictim[attacker]
		if cv and os.clock() - cv.at < CFG.ComboKeepTime + 0.5 and dist <= CFG.ComboKeepRange then
			return true
		end
	end
	return false
end

-- v7: Block ON gagal gara-gara kekunci (stun abis kena hit / busy / cooldown) tapi masih sempat nyampe
-- sebelum hit mendarat -> coba lagi begitu kunci kebuka
local function retryAfterUnlock(attacker, tok, hitAt, rtt, fl, ha, mode)
	if not CFG.RetryAfterUnlock or blockHeld then
		return
	end
	local t = os.clock()
	local gl = gameLock()
	local unlock = math.max(readyAt - 0.005, lockedUntil, dodgeBlockUntil, gl and (gl - 0.01) or -math.huge)
	if unlock <= t or unlock + 0.012 > hitAt - rtt - fl + CFG.LateTolerance then
		return
	end
	counters.retried += 1
	schedule(unlock + 0.012 + frame.avg * CFG.FireEarly, function()
		if not alive or not CFG.Enabled or blockHeld or planToken[attacker] ~= tok then
			return
		end
		if pressBlock(math.max(hitAt - os.clock(), 0) + CFG.ResultPad + ha) then
			pressMode = mode
			blockFor = attacker
		end
	end)
end

-- Block ON baru dijadwalin. mode "parry" = ngincer window parry, "plain" = cukup block nyala pas hit
local function scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, mode, bound)
	local hitAt = now + lead
	local verdict = arbitrate(plan.kind, hitAt, now)
	if verdict ~= "ok" then
		return skip(verdict)
	end

	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	local resultAt = hitAt + CFG.ResultPad + SK.resPad()
	local hold = math.max(age, 0) + ha
	-- v4: hold minimal sampai event hasil hit nyampe, biar Blocked bisa disambung chain guard
	-- (kalau hasilnya Parried, block langsung dilepas lagi di onHit)
	if now + sendIn + hold < resultAt then
		hold = resultAt - (now + sendIn)
	end
	local coverTo = math.max(now + lead - rtt - fl + ha, resultAt) -- block harus tetap nyala sampai jam ini biar hit ini ketutup
	counters.planned += 1
	if CFG.LogEvents then
		pushEv("plan", ("%s %s -> %s lead %.2f kirim +%.2f"):format(tag, nameOf(attacker), mode, lead, sendIn))
	end
	noteExpected(attacker, hitAt, now, plan.kind)
	if CFG.DebugPlan then
		if CFG.Debug then log(
			("%s plan[%s]: lead %.3f rtt %.3f±%.3f fps %.0f sendIn %.3f age %.3f hold %.3f tune %+.3f"):format(
				tag, mode, lead, rtt, net.var, frame.fps, sendIn, age, hold, tune[plan.kind]
			)
		) end
	end

	if CFG.Trace then trace(
		("%s dari %s [%s]: lead %.3f rtt %.3f fps %.0f -> kirim %.3fs lagi (umur block %.3f)"):format(
			tag, attacker.Name, mode, lead, rtt, frame.fps, sendIn, age
		)
	) end
	local rec = { kind = plan.kind, hit = hitAt, done = false }
	pending[#pending + 1] = rec
	guardSwing(attacker, now + sendIn, hitAt)
	-- v6: kalau waktunya ditentuin kunci (cooldown block / busy / stun), jangan kirim lebih awal dari kunci kebuka.
	-- Dulu FireEarly bikin paket keluar setengah frame sebelum kunci kebuka -> ditolak pengecekan sendiri -> hit lolos.
	rec.handle = schedule(now + sendIn + (bound and frame.avg * CFG.FireEarly or 0), function()
		rec.done = true
		if not alive or not CFG.Enabled then
			return
		end
		if planToken[attacker] ~= tok then
			counters.cancelled += 1
			return
		end
		if CFG.RecheckAttacker and attackerGone(attacker) then
			counters.cancelled += 1
			counters.recheck += 1
			skip("attacker-gone")
			return
		end
		if plan.predicted and not predictedStillValid(attacker, plan, hitAt) then
			counters.cancelled += 1
			skip("predict-recheck")
			return
		end
		if pressBlock(hold) then
			pressMode = mode
			blockFor = attacker
		elseif plan.kind == "M1" and CFG.ChainGuard and extendHoldTo(coverTo) then
			-- block udah nyala (rencana sebelumnya / chain): M1 cukup ditutup pakai perpanjangan hold
			counters.chained += 1
		else
			retryAfterUnlock(attacker, tok, hitAt, rtt, fl, ha, mode)
		end
	end)
end

-- terlalu mepet / kekunci: jalur lama v3.1 (LateMode)
local function lateFallback(plan, tag, lead, rtt, fl, bound, wait)
	if bound then
		counters.locked += 1
		skip("locked")
		if CFG.Debug then log(("%s kekunci cooldown block (sisa %.2fs, lead %.3f)"):format(tag, wait, lead)) end
	else
		counters.late += 1
		skip("late")
		if CFG.Debug then log(("%s terlalu cepat buat di-react (lead %.3f <= rtt %.3f + frame %.3f)"):format(tag, lead, rtt, fl)) end
	end
	local mode = plan.kind == "M2" and CFG.LateModeM2 or CFG.LateModeM1
	if mode == "block" then
		if pressBlock(CFG.LateHold) then
			pressMode = "plain"
		elseif plan.kind == "M1" and CFG.ChainGuard then
			extendHoldTo(os.clock() + CFG.LateHold)
		end
	end
end

-- v11.4: sumber kunci block yang lagi paling nahan (buat dump: locked/cd, locked/ke-parry, locked/busy, dst)
function SK.whyLock(now, earliest)
	if earliest == readyAt then
		return "cd" -- BlockCooldown abis Block OFF (block dilepas / ke-lepas)
	elseif earliest == dodgeBlockUntil then
		return "dodge"
	elseif earliest == lockedUntil then
		return (now - (SK.bpAt or -math.huge) < 1.0) and "ke-parry" or "stun"
	end
	local busy = false
	local h = getHandler()
	local L = h and h.Local
	if type(L) == "table" and type(L.BusyUntil) == "number" then
		local okS, sn = pcall(function()
			return workspace:GetServerTimeNow()
		end)
		busy = okS and L.BusyUntil > sn + 0.02
	end
	return busy and "busy" or "game"
end

-- v10: sama persis kayak CombatHandler.FromBehind (server): penyerang di belakang lu = block lu dipecahin + damage penuh
function SK.behind(attacker, hrp, angleDeg)
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not ahrp then
		return false
	end
	local d = (ahrp.Position - hrp.Position) * Vector3.new(1, 0, 1)
	local lk = hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
	if d.Magnitude < 0.001 or lk.Magnitude < 0.001 then
		return false
	end
	return d.Unit:Dot(lk.Unit) < math.cos(math.rad(angleDeg or 100))
end

--[[
	Keputusan per hit (v4):
	  M1: parry (block baru / block lama yang masih di window)
		  -> kalau parry nggak mungkin (parry cd, unparryable, block lama): BLOCK BIASA, ditahan nyambung
		  -> kalau block juga nggak sempat / kekunci: DODGE
	  M2: parry
		  -> kalau parry nggak mungkin (parry cd, unparryable, block lama, kekunci, kecepetan): DODGE
		  -> (opsional) kalau parry M2 dari attacker itu sebelumnya miss: dodge DULUAN
]]
local function react(attacker, plan, tag)
	if not alive or not CFG.Enabled or typeof(attacker) ~= "Instance" then
		return
	end
	local char, hrp = myState()
	if not char or attacker == char then
		return
	end
	local why = cannotAct(char, attacker)
	if why then
		return skip(why)
	end
	local ahum = attacker:FindFirstChildOfClass("Humanoid")
	if ahum and ahum.Health <= 0 then
		return
	end

	local now = os.clock()
	sampleNet(now)
	syncBlock(now, char)
	local rtt = net.rtt
	local fl = frameLag()
	local sigma = sigmaNow()
	local corr = corrFor(attacker, plan)
	local unparry = (plan.spec and plan.spec.Unparryable) and true or false

	-- v7: plan prediksi leadnya jauh (~0.9s) -> cek ancaman pakai horizon pendek, posisi 0.9s ke depan nggak bisa ditebak
	local isThreat, dist, sure =
		threatens(attacker, hrp, plan, plan.predicted and math.min(plan.lead + corr, 0.35) or (plan.lead + corr))
	-- v8: attacker ini lagi nge-combo lu (hit/block barusan) -> tetap ancaman walau cek hitbox meleset (knockback, ping, lunge)
	if (not isThreat or not sure) and plan.kind == "M1" and CFG.ComboKeep then
		local cv = comboVictim[attacker]
		if cv and now - cv.at < CFG.ComboKeepTime and attacker:FindFirstChild("HumanoidRootPart") and dist <= CFG.ComboKeepRange * (plan.reach or 1) then
			isThreat, sure = true, true
		end
	end
	if not isThreat then
		if plan.kind == "M2" and CFG.M2Recheck and not plan.rechecked then
			local okR, errR = pcall(SK.m2Recheck, attacker, plan, tag, now)
			if not okR then
				trace("m2Recheck error:", tostring(errR))
			end
		end
		return skip("range")
	end
	reactSure = sure
	if plan.predicted and not sure then
		return skip("predict-unsure") -- cuma nebak kalau attacker beneran ngincer lu
	end

	local lead
	if plan.kind == "M1" then
		lead = plan.lead + corr
	else
		lead = refineLead(plan, dist) + corr
	end

	-- hit bakal mendarat pas lu masih iframe (abis dash) -> nggak perlu
	local iu = char:GetAttribute("IFramesUntil")
	if type(iu) == "number" and iu > workspace:GetServerTimeNow() + lead then
		return skip("iframes")
	end

	-- v10: server ngubah block jadi Hit kalau penyerang ada di belakang lu (BackHit) -> parry/block percuma, tinggal dodge
	if CFG.BackHitGuard and SR.BackHit.Enabled and SK.behind(attacker, hrp, SR.BackHit.Angle) then
		counters.behind += 1
		if CFG.DodgeEnabled and planDodge(attacker, plan, lead, now, rtt, fl, tag, "dari belakang") then
			return
		end
		return skip("behind")
	end

	local isM2 = plan.kind == "M2"
	local ha = holdAfter()

	-- parry masih cooldown pas hit mendarat?
	local parryCd = now + lead < parriedAt + SR.ParryCooldown - 0.02
	local reason = unparry and "unparryable" or (parryCd and "parrycd" or nil)

	-- kapan paling cepat Block ON bisa diterima server
	local glk = gameLock()
	local earliest = math.max(readyAt, lockedUntil, dodgeBlockUntil, glk or -math.huge)
	local wait = earliest - now
	SK.lockWhy = (wait > 0.005) and SK.whyLock(now, earliest) or nil
	local function calc(targetAge, tn)
		local s = lead - targetAge - rtt - fl + tn + (math.random() * 2 - 1) * CFG.Jitter
		local b = false
		if s < wait then
			s = wait
			b = true
		end
		if s < 0 then
			s = 0
		end
		return s, lead - rtt - fl - s, b
	end

	-- bisa diparry?
	local canParry, mode = false, nil
	local sendIn, age, bound = 0, 0, false
	local parryConf = 0 -- v5: peluang parry berhasil (0..1)
	if not reason then
		if blockHeld then
			-- block yang lagi nyala cuma bisa nge-parry kalau umurnya pas hit masih di dalam window
			local heldAge = (now - blockOnAt) + lead - rtt - fl
			if heldAge >= 0 and heldAge <= SR.ParryWindow - 0.04 then
				canParry, mode = true, "held"
				parryConf = confWindow(heldAge, SR.ParryWindow, sigma)
			else
				reason = "heldold"
			end
		else
			-- v11.5: rencana M1r itu tebakan -> target umur block digeser lebih awal (hit yang datang lebih cepat dari tebakan tetap ketutup)
			local tAge = targetAgeFor(isM2)
			if plan.reflex and plan.idx and not isM2 then
				tAge = math.clamp(math.max(tAge, CFG.ReflexAge), 0.06, SR.ParryWindow - 0.07)
			end
			sendIn, age, bound = calc(tAge, tune[plan.kind])
			if age >= -CFG.LateTolerance then
				canParry, mode = true, "fresh"
				parryConf = confWindow(age, SR.ParryWindow, sigma)
			else
				reason = bound and "locked" or "late"
			end
		end
	end

	------------------------------------------------------------------
	-- M2 (BreaksBlock): cuma parry yang nyelametin, block biasa = GuardBroken -> sisanya DODGE
	------------------------------------------------------------------
	if isM2 then
		local dodgeFirst = CFG.DodgeFirstM2
			or (CFG.DodgeAfterMiss and (m2Miss[attacker] or 0) >= CFG.M2MissNeed and now - (m2MissAt[attacker] or -math.huge) < CFG.M2MissMemory)
		local dodgeWhy = "M2 dodge duluan"
		-- v5: bandingin peluang sukses parry vs dodge, ambil yang lebih tinggi
		if not dodgeFirst and canParry and CFG.SmartMode and CFG.DodgeEnabled and CFG.DodgeForM2 and sure then
			local dOK, _, dAge, _, dd = dodgeProbe(lead, now, rtt, fl)
			if dOK then
				local dc = confWindow(dAge, dd.IFrames, sigma)
				-- v12: statistik hasil M2 style attacker ini (parry vs dodge) ikut ngebobot peluang
				local pb, db = SK.m2Bias(attacker)
				dc = dc * db
				local pcf = parryConf * pb
				-- M2 multi-hit: parry nge-stun attacker (sisa hit batal), dodge cuma nutup hit pertama -> syarat lebih ketat
				local gap = plan.multi and CFG.DodgeSwitchGap * 2 or CFG.DodgeSwitchGap
				if dc >= CFG.DodgeMinConf and dc - pcf > gap then
					dodgeFirst = true
					dodgeWhy = ("peluang dodge %.0f%% > parry %.0f%%"):format(dc * 100, pcf * 100)
				end
			end
		end
		if dodgeFirst and planDodge(attacker, plan, lead, now, rtt, fl, tag, dodgeWhy) then
			return
		end
		if not canParry then
			if planDodge(attacker, plan, lead, now, rtt, fl, tag, reason) then
				return
			end
			-- dodge juga nggak bisa: seenggaknya jangan sampai GuardBroken (lepas block sebelum M2 mendarat)
			if blockHeld and CFG.ReleaseBeforeHeavy then
				releaseBefore(now + lead - rtt - fl - 0.03)
			end
			if reason == "late" or reason == "locked" then
				return lateFallback(plan, tag, lead, rtt, fl, bound, wait)
			end
			return skip(reason == "heldold" and "heldold" or reason)
		end
		if mode == "held" then
			return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "masih di window parry")
		end
		return scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, "parry", bound)
	end

	------------------------------------------------------------------
	-- M1: parry kalau bisa, kalau nggak BLOCK BIASA (ditahan), kalau block juga nggak bisa DODGE
	------------------------------------------------------------------
	if canParry then
		if mode == "held" then
			return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "masih di window parry")
		end
		return scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, "parry", bound)
	end

	if blockHeld and CFG.ChainGuard then
		return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "block biasa (" .. tostring(reason) .. ")")
	end

	if CFG.BlockFallback and not blockHeld then
		local s2, a2, b2 = calc(CFG.BlockOnlyAge, 0)
		if a2 >= -CFG.LateTolerance then
			if CFG.Trace then trace(("%s dari %s: parry nggak mungkin (%s) -> block biasa"):format(tag, attacker.Name, tostring(reason))) end
			return scheduleBlock(attacker, plan, tag, lead, s2, a2, ha, rtt, fl, now, "plain", b2)
		end
		bound = b2
	end

	if planDodge(attacker, plan, lead, now, rtt, fl, tag, "block nggak sempat") then
		return
	end
	return lateFallback(plan, tag, lead, rtt, fl, bound, wait)
end

----------------------------------------------------------------------
-- COMBAT EVENTS
----------------------------------------------------------------------
-- v7: tebak swing M1 berikutnya dalam combo. Server: swing ke-(i+1) mulai (Windup_i + Endlag_i) setelah swing ke-i
-- (HoldToSwing = persis pas busy abis), hit-nya Windup_(i+1) setelahnya. Jadi hit berikutnya = sekarang +
-- (W_i + E_i) * k + W_(i+1) * k, dihitung dari Sound swing sekarang -> block bisa dikirim jauh sebelum Sound berikutnya
-- nyampe (yang lead-nya sering < ping). Dicek ulang pas mau dikirim; kalau swing aslinya nongol, di-dedupe.
local function predictFollowUp(attacker, plan, now)
	if not (alive and CFG.Enabled and CFG.PredictCombo and CFG.BlockFallback) then
		return
	end
	local spec, idx = plan.spec, plan.idx
	if type(spec) ~= "table" or type(idx) ~= "number" then
		return
	end
	local style = styleOf(attacker)
	local swings = style and style.M1 and style.M1.Swings
	if type(swings) ~= "table" or idx >= #swings then
		return -- swing terakhir: abis ini ada ChainCooldown, nggak ditebak
	end
	local nxt = swings[idx + 1]
	if type(nxt) ~= "table" then
		return
	end
	local char, hrp = myState()
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not (char and hrp and ahrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.PredictMaxDist then
		return
	end
	local k1 = timeScale(attacker, style, spec)
	local k2 = timeScale(attacker, style, nxt)
	local key = attacker.Name .. ":" .. (idx + 1)
	local w2 = (nxt.Windup or CFG.DefaultM1Lead) * k2 + (leadCorr[key] or 0)
	-- swing berikutnya masih cukup lead buat di-react biasa -> nggak usah nebak
	if w2 - net.rtt - frameLag() >= CFG.PredictBelow then
		return
	end
	local lead2 = ((spec.Windup or CFG.DefaultM1Lead) + (spec.Endlag or 0.45)) * k1 + (nxt.Windup or CFG.DefaultM1Lead) * k2
	counters.predicted += 1
	react(attacker, {
		kind = "M1",
		lead = lead2,
		reach = reachOf(attacker, style),
		spec = nxt,
		height = nxt.Height or style.M1.Height,
		idx = idx + 1,
		key = key,
		skey = SK.styleName(attacker) .. ":" .. (idx + 1),
		learn = false,
		predicted = true,
	}, "M1*")
end

-- v11.5: belajar interval hit->hit combo. rf = tebakan M1r terakhir per attacker, gapCorr = koreksi sisa per nama attacker.
-- Dihitung dari DUA event Hit yang sama-sama kena delay jaringan, jadi selisihnya = interval asli di server (nggak kena ping).
SK.rf = SK.rf or setmetatable({}, weak)
SK.gapCorr = SK.gapCorr or {}

function SK.gapLearn(attacker, now, kind)
	local rf = SK.rf[attacker]
	if not rf then
		return
	end
	SK.rf[attacker] = nil
	if kind ~= "M1" or not CFG.GapLearn then
		return
	end
	local errTotal = (now - rf.t0) - rf.base
	if math.abs(errTotal) > 0.4 then
		return -- combo putus / hit ini bukan lanjutannya
	end
	-- leadCorr (belajar dari Sound->Hit) udah nanggung sebagian error; yang disimpan di sini cuma sisanya
	local target = errTotal - corrFor(attacker, { key = rf.key, kind = "M1" })
	local cur = SK.gapCorr[attacker.Name] or 0
	SK.gapCorr[attacker.Name] = math.clamp(cur + (target - cur) * 0.4, -0.25, 0.25)
end

-- v11.5: perkiraan hit lanjutan combo dari event hit ini (detik dari sekarang). nil = nggak tau, false = swing terakhir combo
function SK.predLead(attacker)
	local style = styleOf(attacker)
	local swings = style and style.M1 and style.M1.Swings
	local st = combo[attacker]
	if type(swings) ~= "table" or not st or type(st.idx) ~= "number" then
		return nil
	end
	local spec, nxt = swings[st.idx], swings[st.idx + 1]
	if type(spec) ~= "table" then
		return nil
	end
	if type(nxt) ~= "table" then
		return false
	end
	local k1 = timeScale(attacker, style, spec)
	local k2 = timeScale(attacker, style, nxt)
	local base = (spec.Endlag or 0.45) * k1 + (nxt.Windup or CFG.DefaultM1Lead) * k2
	local key = attacker.Name .. ":" .. (st.idx + 1)
	return base + (CFG.GapLearn and SK.gapCorr[attacker.Name] or 0) + corrFor(attacker, { key = key, kind = "M1" })
end

-- v8: M1 dari attacker barusan nyampe ke lu (kena / ke-block) -> hit combo berikutnya mendarat Endlag_i*k + Windup_(i+1)*k setelah
-- hit itu (swing berikutnya mulai pas busy abis, sama kayak predictFollowUp). Bedanya: dihitung dari event HIT yang beneran nyampe
-- dan dijalanin SETELAH stun/lock ke-update, jadi react nunda Block ON sampai kunci kebuka lalu kirim tepat waktu (parry kalau
-- umur block masuk window, kalau nggak block biasa, kalau block nggak sempat dodge). Gating dilonggarin lewat comboVictim.
local function hitReflex(attacker, now)
	if not (alive and CFG.Enabled and CFG.HitReflex and CFG.BlockFallback) then
		return
	end
	local style = styleOf(attacker)
	local swings = style and style.M1 and style.M1.Swings
	local st = combo[attacker]
	if type(swings) ~= "table" or not st or type(st.idx) ~= "number" then
		return
	end
	local idx = st.idx
	local spec, nxt = swings[idx], swings[idx + 1]
	if type(spec) ~= "table" or type(nxt) ~= "table" then
		return -- swing terakhir: abis ini ada ChainCooldown
	end
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not (ahrp and hrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.ComboKeepRange then
		return
	end
	local k1 = timeScale(attacker, style, spec)
	local k2 = timeScale(attacker, style, nxt)
	counters.reflex += 1
	-- v11.5: interval hit->hit yang dipelajari (koreksi sisa di luar leadCorr), dicatat buat belajar di hit berikutnya
	local baseLead = (spec.Endlag or 0.45) * k1 + (nxt.Windup or CFG.DefaultM1Lead) * k2
	if CFG.GapLearn then
		SK.rf[attacker] = { t0 = now, base = baseLead, key = attacker.Name .. ":" .. (idx + 1) }
	end
	react(attacker, {
		kind = "M1",
		lead = baseLead + (CFG.GapLearn and SK.gapCorr[attacker.Name] or 0),
		reach = reachOf(attacker, style),
		spec = nxt,
		height = nxt.Height or style.M1.Height,
		idx = idx + 1,
		key = attacker.Name .. ":" .. (idx + 1),
		skey = SK.styleName(attacker) .. ":" .. (idx + 1),
		learn = false,
		predicted = true,
		reflex = true,
	}, "M1r")
end

-- v10: skill multi-hit (barrage). Skill nggak ngirim Sound/Flash swing yang bisa dibaca, jadi dipandu dari event Hit:
-- hit ke-n nyampe -> hit ke-(n+1) mendarat Interval setelahnya (lead dihitung dari kedatangan event, sama kayak hitReflex).
-- SK.barr[attacker] = { n = hit ke-n barrage ini, at = hit terakhir yang nyampe, spec }; SK.seen = Kind hit yang udah dicatat

function SK.norm(s)
	if type(s) ~= "string" then
		return nil
	end
	return (s:lower():gsub("[%s_]+", ""))
end

function SK.spec(attacker, gap)
	local mine = SK.norm(attacker:GetAttribute("Style"))
	local best, bestE = nil, math.huge
	for _, b in ipairs(Specs.barrages) do
		local bs = SK.norm(b.style)
		if bs == nil or bs == mine then
			local e = gap and math.abs(b.interval - gap) or (bs == mine and 0 or 0.5)
			if e < bestE then
				best, bestE = b, e
			end
		end
	end
	if best then
		return best
	end
	return { name = "?", hits = CFG.BarrageDefaultHits, interval = CFG.BarrageDefaultInterval, breaks = false }
end

function SK.reflex(attacker, now, res)
	if not (alive and CFG.Enabled and CFG.BarrageGuard and CFG.BlockFallback) then
		return
	end
	local b0 = SK.barr[attacker]
	local n, spec
	local gapEst = nil -- v13: rata-rata selisih hit barrage yang beneran nyampe (hit-ke-hit, jalur jaringan sama = akurat)
	if b0 and (now - b0.at) <= b0.spec.interval * CFG.BarrageWindow then
		n = b0.n + 1
		spec = (n == 2) and SK.spec(attacker, now - b0.at) or b0.spec
		if CFG.BarrageGapLearn then
			local g = now - b0.at
			if g >= 0.06 and g <= spec.interval * 1.5 then
				gapEst = b0.gap and (b0.gap * 0.5 + g * 0.5) or g
			else
				gapEst = b0.gap
			end
		end
	else
		n, spec = 1, SK.spec(attacker, nil)
	end
	SK.barr[attacker] = { n = n, at = now, spec = spec, gap = gapEst }

	-- attacker yang lagi nge-barrage lu tetap ancaman walau cek hitbox meleset (sama kayak combo M1)
	local cv = comboVictim[attacker]
	if cv and now - cv.at < CFG.ComboKeepTime then
		cv.n += 1
	else
		cv = { n = 1 }
		comboVictim[attacker] = cv
	end
	cv.at = now

	if n >= spec.hits then
		return -- hit terakhir
	end
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not (ahrp and hrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.ComboKeepRange * 1.5 then
		return
	end
	counters.barrage += 1
	react(attacker, {
		kind = spec.breaks and "M2" or "M1",
		lead = gapEst and math.clamp(gapEst, spec.interval * 0.6, spec.interval * 1.4) or spec.interval,
		reach = numAttr(attacker, "ReachFactor", 1),
		key = "SK:" .. attacker.Name,
		learn = false,
		predicted = true,
		reflex = true,
		nocorr = true,
		skill = true,
	}, "SK")
end

-- v11: abis LU nge-parry attacker. Server ngasih attacker stun (ParryAttackerRecovery 0.75s). Kalau block dilepas sekarang,
-- BlockReadyAt = +0.75s (BlockCooldown); hit lanjutan attacker itu mendarat (stun + windup) setelah sekarang, jadi jendela
-- buat Block ON = stun + windup - BlockCooldown - ping - frame - noise. Return jam client sampai kapan block ditahan,
-- atau nil = lepas sekarang (re-parry masih masuk akal di ping/fps lu dan nggak ada attacker lain yang aktif).
function SK.postParry(attacker, data, now)
	local rtt, fl, sg = net.rtt, frameLag(), sigmaNow()
	local stun = (type(data.AttackerStun) == "number" and data.AttackerStun > 0) and data.AttackerStun or SR.ParryRecovery
	local wind = CFG.DefaultM1Lead
	if typeof(attacker) == "Instance" then
		local style = styleOf(attacker)
		local m1 = style and style.M1
		local sw = type(m1) == "table" and type(m1.Swings) == "table" and m1.Swings[1] or nil
		if type(sw) == "table" and type(sw.Windup) == "number" then
			wind = sw.Windup * timeScale(attacker, style, sw)
		end
	end
	local followAt = now + stun + wind -- paling cepat hit lanjutan attacker yang ke-parry mendarat (jam client)
	local slack = (stun + wind) - SR.BlockCooldown - rtt - fl - 2 * sg - CFG.ReparryPad
	local crowd = false
	local _, hrp = myState()
	if hrp then
		for a, t in pairs(lastSwingSeen) do
			if a ~= attacker and now - t < CFG.HotWindow * 1.5 and typeof(a) == "Instance" and a.Parent then
				local ah = a:FindFirstChild("HumanoidRootPart")
				if ah and (ah.Position - hrp.Position).Magnitude <= CFG.HotRadius then
					crowd = true
					break
				end
			end
		end
	end
	if slack >= CFG.ReparryMinSlack and not crowd then
		return nil
	end
	local lp = SK.lagPad()
	return math.max(
		followAt + CFG.ResultPad + SK.resPad() + holdAfter() + CFG.PostParryTail + lp,
		now + SR.ParryCooldown + holdAfter() + lp
	)
end

-- v11.2: jarak datar attacker ke lu (buat Why)
function SK.flatDist(a)
	if typeof(a) ~= "Instance" then
		return nil
	end
	local _, hrp = myState()
	local ah = a:FindFirstChild("HumanoidRootPart")
	if not (hrp and ah) then
		return nil
	end
	local d = hrp.Position - ah.Position
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

-- v11.2: M2 kena skip "range" pas telegraf. Windup M2 panjang (0.5-0.9s) dan attacker bisa lari / nge-dash nutup jarak, jadi
-- cek ulang pakai posisi terbaru selama sisa lead masih cukup buat parry/dodge. Satu kali recheck per swing.
function SK.m2Recheck(attacker, plan, tag, now)
	if typeof(attacker) ~= "Instance" then
		return
	end
	local need = targetAgeFor(true) + net.rtt + frameLag() + CFG.M2RecheckSafety
	local delay = math.min(plan.lead - need, 0.30)
	if delay < 0.05 then
		return
	end
	local tok = planToken[attacker] or 0
	schedule(now + delay, function()
		if not alive or not CFG.Enabled or (planToken[attacker] or 0) ~= tok then
			return -- EndFlash / parry / plan lain udah nge-reset swing ini
		end
		local p2 = {}
		for k, v in pairs(plan) do
			p2[k] = v
		end
		p2.lead = plan.lead - (os.clock() - now)
		p2.rechecked = true
		react(attacker, p2, tag)
	end)
end

-- v11.1: event Parried nyampe pas block udah keburu lepas (BlockReadyAt = lepas + 0.75s). Jadwalin Block ON se-awal mungkin
-- yang masih diterima server tapi sebelum hit lanjutan attacker mendarat. Kalau hit lanjutan mendarat sebelum block siap -> skip.
function SK.postParryLate(attacker, data, now)
	if not (alive and CFG.Enabled) or typeof(attacker) ~= "Instance" then
		return
	end
	local rtt, fl = net.rtt, frameLag()
	local stun = (type(data.AttackerStun) == "number" and data.AttackerStun > 0) and data.AttackerStun or SR.ParryRecovery
	local wind = CFG.DefaultM1Lead
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local sw = type(m1) == "table" and type(m1.Swings) == "table" and m1.Swings[1] or nil
	if type(sw) == "table" and type(sw.Windup) == "number" then
		wind = sw.Windup * timeScale(attacker, style, sw)
	end
	local followAt = now + stun + wind
	local readyAt = lastOwnOff + SR.BlockCooldown + 0.02 + fl
	local sendAt = math.max(readyAt, followAt - rtt - fl - 0.10)
	if sendAt > followAt - rtt - fl then
		evt("info", "hit lanjutan keburu mendarat sebelum block siap")
		return
	end
	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	schedule(sendAt, function()
		if not alive or not CFG.Enabled or planToken[attacker] ~= tok then
			return
		end
		if blockHeld then
			extendHoldTo(followAt + CFG.PostParryTail + holdAfter())
			return
		end
		if attackerGone(attacker) then
			return
		end
		local _, hrp = myState()
		local ah = attacker:FindFirstChild("HumanoidRootPart")
		if not (hrp and ah) or (ah.Position - hrp.Position).Magnitude > CFG.ComboKeepRange + 6 then
			return
		end
		local hold = math.max(followAt - os.clock(), 0) + CFG.PostParryTail + holdAfter() + SK.lagPad()
		if pressBlock(hold) then
			pressMode = "plain"
			blockFor = nil
			evt("info", "block cadangan abis parry")
		end
	end)
end

-- v11: LU yang ke-parry musuh (stun). Block ON dikirim pas stun lepas kalau musuhnya masih deket: hit lanjutan musuh biasanya
-- mendarat 0.1-0.3s setelah stun lepas = masih di window parry (umur block 0..0.25s), kalau lebih telat tetap ke-block (0 damage).
function SK.parriedGuard(enemy, now, unlockAt)
	if not (alive and CFG.Enabled and CFG.ParriedGuard and typeof(enemy) == "Instance") then
		return
	end
	-- v11.4: token sendiri. Dulu pakai planToken[enemy] -> swing musuh berikutnya (plan apa pun lewat scheduleBlock) ngebatalin guard ini diam-diam
	SK.pgTok = (SK.pgTok or 0) + 1
	local tok = SK.pgTok
	local deadline = now + CFG.ParriedGuardWindow
	local tries = 0
	local attempt
	attempt = function()
		if not alive or not CFG.Enabled or SK.pgTok ~= tok then
			return
		end
		local t = os.clock()
		if blockHeld then
			extendHoldTo(t + CFG.ParriedGuardHold)
			return
		end
		if t > deadline or attackerGone(enemy) then
			return
		end
		local _, hrp = myState()
		local eh = enemy:FindFirstChild("HumanoidRootPart")
		if not (hrp and eh) or (eh.Position - hrp.Position).Magnitude > CFG.ParriedGuardRange then
			return
		end
		if pressBlock(CFG.ParriedGuardHold + holdAfter() + SK.lagPad()) then
			pressMode = "plain" -- waktunya ditentuin stun lepas, bukan lead swing -> jangan ikut ngegeser tune parry
			blockFor = nil
			evt("info", "guard pas stun lepas")
		elseif CFG.ParriedGuardRearm and tries < 40 then
			-- v11.4: masih kekunci (hit counter musuh nambah stun, cooldown, busy) -> coba lagi TEPAT pas kunci kebuka, bukan 3x lalu nyerah
			tries += 1
			local gl = gameLock()
			local at = math.max(lockedUntil, readyAt, dodgeBlockUntil, gl or -math.huge, t) + 0.012
			schedule(math.max(at, t + 0.03) + frame.avg * CFG.FireEarly, attempt)
		end
	end
	SK.pgRe = { tok = tok, key = "pgTok", deadline = deadline, attempt = attempt }
	schedule(unlockAt + 0.012 + frame.avg * CFG.FireEarly, attempt)
end

-- v11.5: LU kena hit (stun) -> Block ON dikirim TEPAT pas stun lepas. Dulu abis kena cuma ada rencana M1r yang nebak waktu hit
-- lanjutan dan ngirim block pas umurnya "pas" -> kalau tebakan meleset sedikit (dump: ~0.14s lebih cepat) block belum nyala = kena lagi.
-- Block yang nyala dari unlock nutup dua kemungkinan: hit mendarat 0..0.25s abis unlock = PARRY, lebih telat = ke-block (0 damage).
-- Rearm sama kayak parriedGuard: kalau masih kekunci (stun nambah, cooldown, busy) dicoba lagi tepat pas kunci kebuka.
function SK.hitGuard(attacker, now, kind, res)
	if not (alive and CFG.Enabled and CFG.HitGuard and CFG.BlockFallback and typeof(attacker) == "Instance") then
		return
	end
	if (kind == "M2" or res == "GuardBroken") and not CFG.HitGuardM2 then
		return
	end
	local _, hrp0 = myState()
	local eh0 = attacker:FindFirstChild("HumanoidRootPart")
	if not (hrp0 and eh0) or (eh0.Position - hrp0.Position).Magnitude > CFG.HitGuardRange then
		return
	end
	local unlock = math.max(lockedUntil, readyAt, now)
	if unlock - now > 2.5 then
		return -- stun gede (knockdown / ragdoll): bukan urusan guard
	end
	-- hit lanjutan diperkirakan kapan? (cuma buat combo M1; M2 / guard break nggak punya pola yang bisa ditebak)
	local hitAbs = nil
	local startAt = unlock
	if kind == "M1" and res == "Hit" then
		local pl = SK.predLead(attacker)
		if pl == false then
			return -- swing terakhir combo: abis ini ada ChainCooldown
		end
		if pl then
			hitAbs = now + pl
			if pl - (unlock - now) > CFG.HitGuardEarly then
				-- hit lanjutan masih jauh abis unlock: block dari unlock cuma kelamaan nyala (umur > window = ke-block doang).
				-- Jaring pengaman: dikirim supaya umurnya ~(window - 0.05) pas hit tebakan mendarat. Rencana M1r yang normalnya
				-- ngurus ini; kalau M1r gagal (ditolak / diganti plan lain / kunci geser) guard ini yang nutup (parry kalau tebakan
				-- akurat, kalau meleset lebih telat tetap ke-block).
				startAt = math.max(unlock, hitAbs - (SR.ParryWindow - 0.05) - net.rtt * 0.5 - frameLag())
			end
		end
	end
	SK.hgTok = (SK.hgTok or 0) + 1
	local tok = SK.hgTok
	local deadline = (hitAbs and math.max(hitAbs + 0.4, unlock) or unlock) + CFG.HitGuardWindow
	local tries = 0
	local attempt
	attempt = function()
		if not alive or not CFG.Enabled or SK.hgTok ~= tok then
			return
		end
		local t = os.clock()
		if blockHeld then
			extendHoldTo(t + CFG.HitGuardHold)
			return
		end
		if t > deadline or attackerGone(attacker) then
			return
		end
		local _, hrp = myState()
		local eh = attacker:FindFirstChild("HumanoidRootPart")
		if not (hrp and eh) or (eh.Position - hrp.Position).Magnitude > CFG.HitGuardRange then
			return
		end
		-- hit lanjutan udah ketebak: cukup tahan sampai dia mendarat + hasilnya nyampe (chain / parry yang nyambungin sisanya)
		local hold = CFG.HitGuardHold
		if hitAbs then
			hold = math.clamp(hitAbs - t + CFG.ResultPad + SK.resPad() + 0.12, 0.25, CFG.HitGuardHold)
		end
		if pressBlock(hold + holdAfter() + SK.lagPad()) then
			pressMode = "plain" -- waktunya ditentuin stun lepas, bukan lead swing -> jangan ikut ngegeser tune parry
			blockFor = nil
			counters.hitguard += 1
			evt("info", "guard abis kena")
		elseif CFG.ParriedGuardRearm and tries < 40 then
			tries += 1
			local gl = gameLock()
			local at = math.max(lockedUntil, readyAt, dodgeBlockUntil, gl or -math.huge, t) + 0.012
			schedule(math.max(at, t + 0.03) + frame.avg * CFG.FireEarly, attempt)
		end
	end
	SK.hgRe = { tok = tok, key = "hgTok", deadline = deadline, attempt = attempt }
	schedule(startAt + 0.012 + frame.avg * CFG.FireEarly, attempt)
end

-- v8: belajar seberapa awal block boleh dikirim pas stun lepas. accepted = block yang dikirim pas unlock diterima server.
local function stunLearn(accepted)
	if not CFG.FastUnlock or os.clock() - stunProbeAt > 1.0 then
		return
	end
	stunProbeAt = -math.huge
	if accepted then
		stunSlack = math.max(CFG.StunSlackMin, stunSlack - 0.06)
	else
		stunSlack = math.min(CFG.StunSlackMax, stunSlack + 0.12)
	end
end

local function resyncCombo(attacker, obs)
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local swings = type(m1) == "table" and m1.Swings
	local st = combo[attacker]
	if type(swings) ~= "table" or not st then
		return
	end
	local bestI, bestE = nil, 0.04
	for i, sp in ipairs(swings) do
		if type(sp) == "table" then
			local e = math.abs((sp.Windup or 0) * timeScale(attacker, style, sp) - obs)
			if e < bestE then
				bestI, bestE = i, e
			end
		end
	end
	if bestI then
		st.idx = bestI
	end
end

-- v13.4: ring buffer hasil (kind / result / kondisi jaringan / tune). Bahan replay offline. Pakai SK biar nggak nambah local (jatah Luau).
SK.ol = { buf = {}, n = 0, max = 200 }

function SK.logOutcome(kind, res, sent, inParryCd, isSK)
	if not CFG.OutcomeLog then
		return
	end
	local o = SK.ol
	o.n += 1
	o.buf[(o.n - 1) % o.max + 1] = {
		t = os.clock(), kind = kind, res = res, sent = sent and true or false, pcd = inParryCd and true or false, sk = isSK and true or false,
		rtt = net.rtt, var = net.var, fps = frame.fps, tM1 = tune.M1, tM2 = tune.M2,
	}
end

function SK.outcomes()
	local o, out = SK.ol, {}
	for i = math.max(o.n - o.max, 0) + 1, o.n do
		out[#out + 1] = o.buf[(i - 1) % o.max + 1]
	end
	return out
end

function SK.outcomesExport()
	if type(writefile) ~= "function" then
		return false
	end
	local okJ, raw = pcall(HttpService.JSONEncode, HttpService, { v = 1, count = SK.ol.n, rows = SK.outcomes() })
	if not okJ then
		return false
	end
	return (pcall(writefile, CFG.OutcomeFile, raw))
end

-- v13.5: baca ring buffer hasil (200 terakhir) -> ringkasan per jenis serangan, per ping, plus saran tuning.
-- Dulu OutcomeLog nyatet tapi nggak ada yang baca. Return teks (juga di-print) biar bisa disalin dari hub.
function SK.analyze()
	local rows = SK.outcomes()
	local out = {}
	local function say(s)
		out[#out + 1] = s
	end
	if #rows < 8 then
		say(("[analisis] data belum cukup (%d hasil, minimal 8). Tarung dulu sebentar, lalu panggil lagi."):format(#rows))
		print(out[1])
		return table.concat(out, "\n")
	end
	local function blank()
		return { n = 0, Parried = 0, Blocked = 0, Dodged = 0, Hit = 0, GuardBroken = 0, sent = 0, ok = 0, early = 0, late = 0, pcd = 0, noPlan = 0 }
	end
	local agg = { M1 = blank(), M2 = blank() }
	local buckets = {
		{ lim = 0.06, n = 0, bad = 0, name = "<60ms" },
		{ lim = 0.12, n = 0, bad = 0, name = "60-120ms" },
		{ lim = 0.20, n = 0, bad = 0, name = "120-200ms" },
		{ lim = math.huge, n = 0, bad = 0, name = ">200ms" },
	}
	local skN, skBad = 0, 0
	for _, r in ipairs(rows) do
		local bad = (r.res == "Hit" or r.res == "GuardBroken")
		if r.sk then
			skN += 1
			if bad then
				skBad += 1
			end
		else
			local a = agg[r.kind]
			if a then
				a.n += 1
				a[r.res] = (a[r.res] or 0) + 1
				if r.pcd then
					a.pcd += 1
				end
				if bad and not r.sent then
					a.noPlan += 1 -- kena padahal nggak ada block parry yang dikirim buat hit ini
				end
				if r.sent then
					a.sent += 1
					if r.res == "Parried" then
						a.ok += 1
					elseif r.res == "Blocked" then
						a.early += 1 -- block nyala kegedean (umur > window) = cuma ke-Block
					elseif bad then
						a.late += 1 -- block kekecilan / telat = kena
					end
				end
			end
			for _, b in ipairs(buckets) do
				if (r.rtt or 0) < b.lim then
					b.n += 1
					if bad then
						b.bad += 1
					end
					break
				end
			end
		end
	end
	say(("[analisis] %d hasil terakhir (tune sekarang M1 %+.3f | M2 %+.3f)"):format(#rows, tune.M1, tune.M2))
	for _, kind in ipairs({ "M1", "M2" }) do
		local a = agg[kind]
		if a.n > 0 then
			say(
				("%s: %d hit | parry %.0f%% block %.0f%% dodge %.0f%% KENA %.0f%% | di parry-cd %d"):format(
					kind, a.n, a.Parried / a.n * 100, a.Blocked / a.n * 100, a.Dodged / a.n * 100,
					(a.Hit + a.GuardBroken) / a.n * 100, a.pcd
				)
			)
			if a.sent > 0 then
				say(
					("   block parry dikirim %d kali: parry %.0f%% | kecepetan %.0f%% | telat %.0f%%"):format(
						a.sent, a.ok / a.sent * 100, a.early / a.sent * 100, a.late / a.sent * 100
					)
				)
			end
			local key = "TargetAge" .. kind
			if a.sent >= 6 then
				if a.early / a.sent > 0.35 and a.late / a.sent < 0.15 then
					say(("   saran: block sering kecepetan -> turunin %s ~0.01 (kirim lebih lambat)"):format(key))
				elseif a.late / a.sent > 0.25 and a.early / a.sent < 0.15 then
					say(("   saran: block sering telat -> naikin %s ~0.01 (kirim lebih cepat)"):format(key))
				else
					say("   timing block parry kelihatan seimbang")
				end
			end
			if a.noPlan > 0 then
				say(("   %d kena tanpa block parry yang dikirim -> lihat alasan skip lewat Doctor() / Why()"):format(a.noPlan))
			end
		end
	end
	if skN > 0 then
		say(("skill lain: %d hit, %d kena (nggak ikut tune)"):format(skN, skBad))
	end
	for _, b in ipairs(buckets) do
		if b.n >= 4 then
			say(("ping %s: %d hit, %.0f%% kena"):format(b.name, b.n, b.bad / b.n * 100))
		end
	end
	for _, s in ipairs(out) do
		print("[AutoParry:analyze] " .. s)
	end
	return table.concat(out, "\n")
end

local function tuneBy(kind, dir)
	if not CFG.Adaptive then
		return
	end
	local s = streak[kind]
	local scale = 1
	if s.dir == dir then
		s.n += 1
	elseif CFG.TuneHysteresis and s.n >= 3 then
		-- v13.4: streak panjang lalu 1 hasil berlawanan = kemungkinan noise (spike ping / lag sesaat). Geser kecil aja, jangan balik arah
		s.n -= 2
		scale = 0.35
	else
		s.dir = dir
		s.n = 1
	end
	local step = CFG.TuneStep * math.min(1 + (s.n - 1) * 0.5, 3) * scale
	tune[kind] = math.clamp(tune[kind] + dir * step, -CFG.TuneMax, CFG.TuneMax)
end

-- belajar selisih Sound -> Hit per swing (kedua event kena jalur jaringan yang sama,
-- jadi selisihnya = lead sebenarnya di server, nggak kena ping)
local function learnLead(attacker, kind, now)
	local rec = swingAt[attacker]
	if not rec or rec.kind ~= kind then
		return
	end
	swingAt[attacker] = nil
	local obs = now - rec.t
	if obs < 0.04 or obs > 1.0 then
		return
	end
	if kind == "M1" and rec.learn then
		pcall(SK.iqHitObs, attacker, obs) -- v12: bukti buat StyleIQ
	end
	local err = obs - rec.lead
	if kind == "M1" and math.abs(err) > 0.06 then
		resyncCombo(attacker, obs) -- kemungkinan salah index combo, jangan dipelajari
		return
	end
	if rec.learn and rec.key then
		local n = leadN[rec.key] or 0
		local g = math.max(0.3, 1 / (n + 1.5)) -- sampel awal gain gede, lama-lama stabil di 0.3
		local cur = leadCorr[rec.key] or 0
		leadCorr[rec.key] = math.clamp(cur * (1 - g) + err * g, -0.1, 0.1)
		leadN[rec.key] = n + 1
	end
	if CFG.StylePrior and rec.learn and rec.skey then
		local n2 = SK.sPriorN[rec.skey] or 0
		local g2 = math.max(0.12, 1 / (n2 + 3))
		local cur2 = SK.sPrior[rec.skey] or 0
		SK.sPrior[rec.skey] = math.clamp(cur2 * (1 - g2) + err * g2, -0.08, 0.08)
		SK.sPriorN[rec.skey] = n2 + 1
	end
	if kind == "M1" then
		local cur = leadAll[attacker.Name] or 0
		leadAll[attacker.Name] = math.clamp(cur * 0.8 + err * 0.2, -0.06, 0.06)
	end
end

-- v12: statistik hasil M2 ke lu per style (parry vs dodge). Dipakai SK.m2Bias di react buat ngebobot peluang.
function SK.m2Record(attacker, res, sent, now)
	local key = SK.styleName(attacker)
	local s = SK.m2s[key]
	if not s then
		s = { pOk = 0, pN = 0, dOk = 0, dN = 0 }
		SK.m2s[key] = s
	end
	local dodgeRecent = (now - dodgeSentAt) < 0.9
	if res == "Dodged" then
		s.dOk += 1
		s.dN += 1
	elseif res == "Parried" then
		s.pOk += 1
		s.pN += 1
	elseif dodgeRecent and (res == "Hit" or res == "GuardBroken") then
		s.dN += 1
	elseif sent and (res == "Hit" or res == "GuardBroken") then
		s.pN += 1
	end
	if s.pN > 30 then
		s.pOk, s.pN = s.pOk / 2, s.pN / 2
	end
	if s.dN > 30 then
		s.dOk, s.dN = s.dOk / 2, s.dN / 2
	end
end

-- pengali peluang (parry, dodge) dari statistik style attacker. 1 = netral
function SK.m2Bias(attacker)
	if not CFG.M2Learn then
		return 1, 1
	end
	local s = SK.m2s[SK.styleName(attacker)]
	if not s then
		return 1, 1
	end
	local lim = CFG.M2BiasMax
	local pr = (s.pOk + 3) / (s.pN + 4)
	local dr = (s.dOk + 3) / (s.dN + 4)
	return math.clamp(pr / 0.75, 1 - lim, 1 + lim * 0.5), math.clamp(dr / 0.75, 1 - lim, 1 + lim * 0.5)
end

local function onHit(data)
	local attacker, victim = data.Attacker, data.Victim
	local myChar = LocalPlayer.Character
	local now = os.clock()

	if (data.Kind == "M1" or data.Kind == "M2") and typeof(attacker) == "Instance" then
		learnLead(attacker, data.Kind, now)
	end

	-- gue yang nyerang dan ke-parry -> gue yang stun
	if attacker == myChar and data.Result == "Parried" then
		local stunLen = (type(data.AttackerStun) == "number" and data.AttackerStun > 0) and data.AttackerStun or SR.ParryRecovery
		-- v11: unlock stun pakai kompensasi hasil belajar (stunComp), bukan rtt/2 yang kekonservatif
		local unlockAt = now + stunLen - (CFG.ParriedGuard and stunComp() or net.rtt / 2)
		lockedUntil = math.max(lockedUntil, unlockAt)
		SK.bpAt = now
		if CFG.ParriedGuard then
			stunSrcUntil = unlockAt -- block pas-unlock jadi bahan belajar stunSlack juga
			stunUntil = math.max(stunUntil, now + stunLen - net.rtt / 2)
			local okG, errG = pcall(SK.parriedGuard, data.Victim, now, unlockAt)
			if not okG then
				trace("parriedGuard error:", tostring(errG))
			end
		end
		return
	end
	if victim ~= myChar then
		return
	end

	local kind = data.Kind == "M2" and "M2" or "M1"
	-- v10: Kind selain M1/M2 = hit skill (barrage dll). Dulu ikut dihitung M1 -> ngerusak tune, combo, dan hitReflex
	local isSK = CFG.SkillAware and data.Kind ~= "M1" and data.Kind ~= "M2"
	if isSK and type(data.Kind) == "string" and not SK.seen[data.Kind] then
		SK.seen[data.Kind] = true
		evt("info", "Hit Kind lain: " .. data.Kind)
	end
	-- v13: TeleLearn belajar dari hit ini (event apa yang ngedahuluin, selisih waktunya berapa)
	if CFG.TeleLearn and not SK.tl.off then
		SK.tlSafe(SK.tlHit, data, attacker, isSK, now)
	end
	-- v11.5: hit ini lanjutan combo yang ditebak M1r terakhir? -> pelajari selisih interval aslinya
	if not isSK and typeof(attacker) == "Instance" then
		local okG, errG = pcall(SK.gapLearn, attacker, now, kind)
		if not okG then
			trace("gapLearn error:", tostring(errG))
		end
	end
	local sent = (now - blockOnAt) < 0.6 and lastRefusedAt < blockOnAt and pressMode == "parry" and (now - dodgeSentAt) > 0.8
		and (not CFG.TuneByAttacker or blockFor == attacker) and not isSK
	local res = data.Result
	local inParryCd = (now - parriedAt) < SR.ParryCooldown
	if CFG.OutcomeLog then
		SK.logOutcome(kind, res, sent, inParryCd, isSK)
	end

	-- v8: lacak combo: attacker yang barusan kena/ke-block M1 ke lu lagi nge-combo, parry/dodge = combo putus
	if kind == "M1" and not isSK and typeof(attacker) == "Instance" then
		if res == "Hit" or res == "Blocked" or res == "GuardBroken" then
			local cv = comboVictim[attacker]
			if cv and now - cv.at < CFG.ComboKeepTime then
				cv.n += 1
			else
				cv = { n = 1 }
				comboVictim[attacker] = cv
			end
			cv.at = now
		elseif res == "Parried" or res == "Dodged" then
			comboVictim[attacker] = nil
		end
	end

	-- v12: statistik hasil M2 per style (parry vs dodge)
	if kind == "M2" and CFG.M2Learn and not isSK and typeof(attacker) == "Instance" then
		local okM, errM = pcall(SK.m2Record, attacker, res, sent, now)
		if not okM then
			trace("m2Record error:", tostring(errM))
		end
	end

	-- v4: parry M2 miss -> M2 berikutnya dari attacker ini dodge duluan
	if kind == "M2" and typeof(attacker) == "Instance" then
		if res == "Parried" then
			m2Miss[attacker] = nil
		elseif (res == "GuardBroken" or res == "Hit") and sent then
			-- v11.4: cuma dihitung kalau parry M2 beneran dikirim buat attacker ini. Dulu dodge yang gagal / M2 tanpa rencana
			-- ikut dihitung -> semua M2 attacker itu di-dodge terus (dodge cd 2.25s) padahal parry-nya nggak pernah dicoba.
			m2Miss[attacker] = (m2Miss[attacker] or 0) + 1
				m2MissAt[attacker] = now
			trace("parry M2 miss dari", attacker.Name, "x" .. m2Miss[attacker], "-> M2 berikutnya dodge duluan")
		end
	end

	if res == "Parried" then
		counters.parried += 1
		if stunProbeAt == blockOnAt and lastRefusedAt < blockOnAt then
			stunLearn(true)
		end
		evt("parry", "PARRY " .. kind .. " · " .. nameOf(attacker))
		parriedAt = now
		if not isSK then
			streak[kind].n = 0
			streak[kind].dir = 0
		end
		if typeof(attacker) == "Instance" then
			combo[attacker] = nil -- attacker kena stun -> combo reset di server
			clearGuards(attacker) -- v7: abis parry lu bebas nyerang balik
			planToken[attacker] = (planToken[attacker] or 0) + 1
		end
		-- v4: abis parry, lepas block biar cooldown-nya (0.75s) cepet beres buat parry berikutnya,
		-- kecuali ada hit lain yang lagi ditunggu dalam <0.9s
		-- v11: block ditahan lewat jendela hit lanjutan (lihat SK.postParry); nil = lepas kayak v10
		local ppHold = nil
		if CFG.PostParryHold and blockHeld then
			local okP, rP = pcall(SK.postParry, attacker, data, now)
			if okP then
				ppHold = rP
			else
				trace("postParry error:", tostring(rP))
			end
		end
		if ppHold then
			extendHoldTo(ppHold)
			evt("info", ("block ditahan %.2fs abis parry"):format(math.max(ppHold - now, 0)))
		elseif CFG.ReleaseOnParry and blockHeld then
			local keep, lastAt = false, 0
			for _, e in ipairs(expected) do
				if e.kind ~= "DODGE" and e.atk ~= attacker and e.at > now + 0.12 and e.at < now + 0.9 then
					keep = true
					lastAt = math.max(lastAt, e.at)
				end
			end
			-- v6: attacker LAIN yang baru ngayun di deket lu -> tahan block sampai parry cooldown lewat
			if not keep and CFG.CrowdGuard then
				local _, myHrp = myState()
				if myHrp then
					for a, t in pairs(lastSwingSeen) do
						if a ~= attacker and now - t < CFG.CrowdWindow and a.Parent then
							local ah = a:FindFirstChild("HumanoidRootPart")
							if ah and (ah.Position - myHrp.Position).Magnitude <= CFG.CrowdRadius then
								keep = true
								lastAt = math.max(lastAt, now + SR.ParryCooldown - 0.05)
							end
						end
					end
				end
			end
			if not keep then
				releaseBefore(now)
			else
				-- v5: ada hit lain yang lagi ditunggu -> block tetap nyala sampai hit itu ketutup
				extendHoldTo(lastAt + CFG.ResultPad + holdAfter())
			end
		end
		if CFG.PostParryHold and not blockHeld and not ppHold then
			evt("info", ("parry masuk tapi block udah lepas %.0fms lalu"):format(math.max(now - lastOwnOff, 0) * 1000))
			local okL, errL = pcall(SK.postParryLate, attacker, data, now)
			if not okL then
				trace("postParryLate error:", tostring(errL))
			end
		end
		if CFG.Debug then log(("PARRY  (%d parry / %d block / %d gb / %d hit)"):format(counters.parried, counters.blocked, counters.guardbroken, counters.hit)) end
	elseif res == "Blocked" then
		counters.blocked += 1
		if stunProbeAt == blockOnAt and lastRefusedAt < blockOnAt then
			stunLearn(true)
		end
		evt("block", "block " .. kind .. " · " .. nameOf(attacker))
		-- ke-Block doang = umur block kegedean (kecepetan) -> kirim lebih lambat
		if sent and not inParryCd then
			tuneBy(kind, 1)
		end
		if CFG.ChainGuard and kind == "M1" then
			extendHoldTo(now + CFG.ChainHold + SK.lagPad())
		end
		if CFG.Debug then log(("block  %s (tune M1 %+.3f M2 %+.3f%s)"):format(kind, tune.M1, tune.M2, inParryCd and ", parry cooldown" or "")) end
	elseif res == "GuardBroken" then
		counters.guardbroken += 1
		evt("gb", "GUARD BREAK " .. kind .. " · " .. nameOf(attacker))
		dropLocalBlock()
		lockedUntil = math.max(lockedUntil, now + SR.GuardBreak - net.rtt / 2)
		if sent and not inParryCd then
			tuneBy(kind, 1)
		end
		if CFG.Debug then log(("GUARD BREAK %s (tune M1 %+.3f M2 %+.3f%s)"):format(kind, tune.M1, tune.M2, inParryCd and ", parry cooldown" or "")) end
	elseif res == "Hit" then
		counters.hit += 1
		local lockBefore = math.max(lockedUntil - now, 0) -- v8: kondisi kunci SEBELUM stun hit ini masuk
		evt("hit", "KENA " .. kind .. " · " .. nameOf(attacker))
		if (now - dodgeSentAt) < 0.9 then
			counters.dodgemiss += 1
			if CFG.Trace then trace(("dodge nggak nutup hit ini (dodge dikirim %.2fs lalu)"):format(now - dodgeSentAt)) end
		end
		if type(data.Stun) == "number" then
			-- v8: unlock stun dihitung pakai stunComp() (dipelajari); dodge tetap konservatif (iframe nggak boleh nyasar)
			local su = now + data.Stun - stunComp()
			lockedUntil = math.max(lockedUntil, su)
			stunUntil = math.max(stunUntil, now + data.Stun - net.rtt / 2)
			stunSrcUntil = su
		end
		-- kena padahal block udah dikirim = kelambatan -> kirim lebih cepat
		if sent then
			tuneBy(kind, -1)
		end
		local reason = (now - lastSkip.at) < 1.2 and lastSkip.reason or (sent and "block telat" or "nggak ada rencana")
		if reason == "locked" and lastSkip.src then
			reason = "locked/" .. lastSkip.src -- v11.4: cd / stun / ke-parry / dodge / busy / game
		end
		if CFG.WhyHit then
			local cvw = typeof(attacker) == "Instance" and comboVictim[attacker]
			whyLog[#whyLog + 1] = {
				t = now, kind = kind, who = nameOf(attacker), why = reason, rtt = net.rtt, fps = frame.fps,
				held = blockHeld, locked = lockBefore, stun = type(data.Stun) == "number" and data.Stun or 0,
				sent = sent and true or false, slack = stunSlack, combo = cvw and cvw.n or 1,
				pa = now - parriedAt, bp = now - (SK.bpAt or -math.huge),
				st = SK.styleTag(attacker),
				dist = SK.flatDist(attacker),
				sw = (typeof(attacker) == "Instance" and lastSwingSeen[attacker]) and (now - lastSwingSeen[attacker]) or nil,
			}
			if #whyLog > 20 then
				table.remove(whyLog, 1)
			end
		end
		if CFG.Debug then log(
			("kena   %s (tune M1 %+.3f M2 %+.3f, rtt %.3f±%.3f, fps %.0f, alasan: %s)"):format(
				kind, tune.M1, tune.M2, net.rtt, net.var, frame.fps, reason
			)
		) end
	elseif res == "Dodged" then
		counters.dodged += 1
		evt("dodge", "DODGE " .. kind .. " · " .. nameOf(attacker))
		if CFG.Debug then log(("DODGE sukses %s (%d dodge)"):format(kind, counters.dodged)) end
	end

	-- v11.5: abis KENA (stun / guard break) -> guard tepat pas stun lepas (stun/lock udah ke-update di atas)
	if (res == "Hit" or res == "GuardBroken") and not isSK and typeof(attacker) == "Instance" then
		local okH, errH = pcall(SK.hitGuard, attacker, now, kind, res)
		if not okH then
			trace("hitGuard error:", tostring(errH))
		end
	end
	-- v8: abis kena / ke-block M1 -> langsung rencanain hit combo berikutnya (stun/lock udah ke-update di atas)
	if isSK and typeof(attacker) == "Instance" then
		if res == "Parried" then
			SK.barr[attacker] = nil -- barrage dibatalin server (MoveHandler:Cancel "Parried")
		else
			local okB, errB = pcall(SK.reflex, attacker, now, res)
			if not okB then
				trace("barrageReflex error:", tostring(errB))
			end
		end
	elseif (res == "Hit" or res == "Blocked") and kind == "M1" and typeof(attacker) == "Instance" then
		local okR, errR = pcall(hitReflex, attacker, now)
		if not okR then
			trace("hitReflex error:", tostring(errR))
		end
	end
end

-- v5: swing dari attacker yang jauh banget nggak perlu diproses
local function isFar(a)
	local ahrp = a:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not ahrp or not hrp then
		return false
	end
	return (ahrp.Position - hrp.Position).Magnitude > CFG.MaxTrackDist
end

-- v5: block ditolak server (lagi busy/cooldown) tapi masih ada M1 yang bakal dateng -> coba lagi begitu kunci kebuka
local retryHandle = nil
local lastRetryAt, retryWindowAt, retryCount = -math.huge, -math.huge, 0
local function retryGuard()
	if not (alive and CFG.Enabled and CFG.BlockFallback) then
		return
	end
	local now = os.clock()
	local target = nil
	for _, e in ipairs(expected) do
		if e.kind == "M1" and e.at > now + CFG.RetryNear and e.at < now + 1.0 and (not target or e.at > target) then
			target = e.at
		end
	end
	if not target then
		return
	end
	-- v6: batasin retry (server nolak terus -> dulu bisa spam remote tiap 10ms)
	if now - lastRetryAt < CFG.RetryMinGap then
		return
	end
	if now - retryWindowAt > 1.0 then
		retryWindowAt, retryCount = now, 0
	end
	if retryCount >= CFG.RetryMax then
		return
	end
	retryCount += 1
	lastRetryAt = now
	local at = math.max(lockedUntil, readyAt, now) + 0.01 + frame.avg * CFG.FireEarly
	if at >= target then
		return
	end
	cancel(retryHandle)
	retryHandle = schedule(at, function()
		if not alive or not CFG.Enabled or blockHeld then
			return
		end
		local hold = math.max(target - os.clock(), 0) + CFG.ResultPad + holdAfter()
		if pressBlock(hold) then
			pressMode = "plain"
			counters.chained += 1
			trace("block dicoba lagi abis ditolak")
		end
	end)
end

----------------------------------------------------------------------
-- v13: TELELEARN -- belajar sendiri telegraf serangan yang belum dikenal script
-- v12 cuma ngerti Sound swing M1 + Flash Heavy M2. Skill / move lain yang ngirim event lain (Sound / Flash / Info baru)
-- dulu diabaikan (cuma kelihatan di log "Hit Kind lain"), jadi hit pertamanya selalu lolos.
-- Sekarang tiap event yang belum dikenal dari attacker dicatat. Pas hit ke lu nyampe, selisih waktunya dihitung per jenis event.
-- Kalau satu jenis event konsisten ngedahuluin hit (>= TeleMinN sampel, simpangan kecil, sering diikuti hit ke lu),
-- event itu dianggap telegraf dan langsung dipakai buat parry / block / dodge lewat react() yang sama.
-- Semua lewat pcall (SK.tlSafe): kalau error berulang, TeleLearn mati sendiri dan jalur v12 tetap jalan.
----------------------------------------------------------------------
SK.tl = {
	keys = {},
	nkeys = 0,
	learned = 0,
	acted = 0,
	errs = 0,
	off = false,
	recent = setmetatable({}, weak), -- [attacker] = daftar sinyal event terakhir { key, t, dist, hold, used }
	lastAct = setmetatable({}, weak),
}

function SK.fin(x)
	return type(x) == "number" and x == x and x > -1e9 and x < 1e9
end

function SK.tlSafe(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		local T = SK.tl
		T.errs += 1
		if T.errs <= 3 then
			print("[AutoParry] TeleLearn error:", tostring(err))
		end
		if T.errs >= 12 then
			T.off = true
			print("[AutoParry] TeleLearn dimatiin: error berulang")
		end
	end
end

-- (attacker menghadap lu?, jarak datar attacker -> lu)
function SK.tlFacing(a)
	local _, hrp = myState()
	local ah = a:FindFirstChild("HumanoidRootPart")
	if not (hrp and ah) then
		return false, math.huge
	end
	local d = (hrp.Position - ah.Position) * Vector3.new(1, 0, 1)
	local m = d.Magnitude
	if m < 0.5 then
		return true, m
	end
	local lk = ah.CFrame.LookVector * Vector3.new(1, 0, 1)
	if lk.Magnitude < 0.01 then
		return true, m
	end
	return lk.Unit:Dot(d.Unit) > 0.2, m
end

-- block biasa nggak nyelametin (GuardBroken / hit Kind M2 mendominasi) -> perlakukan kayak M2 (parry atau dodge)
function SK.tlBreaks(e)
	return (e.nG >= 1 and e.nB == 0) or e.k2 * 2 > e.hits
end

function SK.tlMature(e)
	if e.n < CFG.TeleMinN then
		return false
	end
	local lim = math.min(math.max(CFG.TeleMaxStd, net.var * 1.2), 0.06)
	if math.sqrt(e.var) > lim then
		return false
	end
	return e.hits / math.max(e.occ, e.hits, 1) >= CFG.TeleMinRatio
end

-- dipanggil dari onCombat buat SETIAP event. Event yang udah dipahami v12 (swing M1, Flash Heavy) dan event hasil (Hit dll) dilewat.
function SK.tlEvent(data, info, kind)
	if info == nil or info == "Hit" or info == "BlockRefused" or info == "EndFlash" then
		return
	end
	local a = data.Character
	if typeof(a) ~= "Instance" or a == LocalPlayer.Character then
		return
	end
	if (info == "Sound" and (kind == "HeavySwing" or Specs.swingSound[kind])) or (info == "Flash" and kind == "Heavy") then
		return -- udah ditangani jalur v12
	end
	if isFar(a) then
		return
	end
	local T = SK.tl
	local now = os.clock()
	local key = "E:" .. tostring(info) .. ":" .. tostring(kind)
	local e = T.keys[key]
	if not e then
		if T.nkeys >= CFG.TeleMaxKeys then
			return
		end
		e = { n = 0, mean = 0, var = 0.0016, occ = 0, hits = 0, dmax = 0, nB = 0, nG = 0, nP = 0, nH = 0, nD = 0, k2 = 0 }
		T.keys[key] = e
		T.nkeys += 1
	end
	local facing, dist = SK.tlFacing(a)
	if facing and dist <= CFG.TeleOccRange then
		e.occ += 1
		if e.hits == 0 and e.occ >= CFG.TeleNoiseOcc then
			T.keys[key] = nil -- sering muncul di deket lu tapi nggak pernah diikuti hit = bukan telegraf serangan
			T.nkeys -= 1
			return
		end
		if e.occ > 90 then
			e.occ, e.hits = e.occ * 0.5, e.hits * 0.5
		end
	end
	-- Flash biasanya bawa Hold (lama windup). Yang dipelajari selisih (delay - Hold), jadi skill yang Hold-nya berubah-ubah tetap kebaca.
	local hold = (type(data.Hold) == "number" and data.Hold >= 0 and data.Hold < 4) and data.Hold or 0
	local list = T.recent[a]
	if not list then
		list = {}
		T.recent[a] = list
	end
	for i = #list, 1, -1 do
		if now - list[i].t > 2.5 + list[i].hold then
			table.remove(list, i)
		end
	end
	if #list >= 10 then
		table.remove(list, 1)
	end
	list[#list + 1] = { key = key, t = now, dist = dist, hold = hold, used = false }

	if CFG.Enabled and dist <= CFG.TeleActRange and SK.tlMature(e) and e.mean + hold >= CFG.TeleMinLead then
		if now - (T.lastAct[a] or -math.huge) >= 0.12 then
			T.lastAct[a] = now
			lastSwingSeen[a] = now
			T.acted += 1
			counters.tele = (counters.tele or 0) + 1
			local breaks = SK.tlBreaks(e)
			react(a, {
				kind = breaks and "M2" or "M1",
				lead = e.mean + hold,
				reach = math.clamp(((e.dmax > 0 and e.dmax or CFG.FallbackRange) + 2) / CFG.FallbackRange, 0.7, 3),
				learn = false,
				nocorr = true,
				tele = key,
			}, breaks and "M2" or "M1")
		end
	end
end

-- dipanggil dari onHit (hit yang kena ke lu): hitung selisih tiap sinyal event terbaru -> hit ini
function SK.tlHit(data, attacker, isSK, now)
	if typeof(attacker) ~= "Instance" then
		return
	end
	local T = SK.tl
	local list = T.recent[attacker]
	if not list or #list == 0 then
		return
	end
	-- M1/M2 yang telegrafnya udah dikenal script dipelajari jalur v12 (learnLead), bukan di sini
	if not isSK and now - (lastSwingSeen[attacker] or -math.huge) < 1.2 then
		return
	end
	local res = data.Result
	local isM2 = data.Kind == "M2"
	local seen = {}
	for i = #list, 1, -1 do
		local s = list[i]
		local d = now - s.t
		if not s.used and d >= 0.04 and d <= CFG.TeleMaxDelay + s.hold then
			s.used = true
			local r = d - s.hold
			local e = T.keys[s.key]
			if e and not seen[s.key] and r >= -0.4 and r <= CFG.TeleMaxDelay then
				seen[s.key] = true
				local n = e.n
				if n == 0 then
					e.mean = r
				else
					local g = math.max(0.12, 1 / (n + 1))
					local diff = r - e.mean
					e.mean += diff * g
					e.var = (1 - g) * (e.var + g * diff * diff)
				end
				e.n = n + 1
				e.hits += 1
				if isM2 then
					e.k2 += 1
				end
				if res == "GuardBroken" then
					e.nG += 1
				elseif res == "Blocked" then
					e.nB += 1
				elseif res == "Parried" then
					e.nP += 1
				elseif res == "Dodged" then
					e.nD += 1
				elseif res == "Hit" then
					e.nH += 1
				end
				local _, dist = SK.tlFacing(attacker)
				if dist < 200 then
					e.dmax = math.max(dist, e.dmax * 0.96)
				end
				T.learned += 1
			end
		end
	end
end

-- getgenv().__NyxAutoParry.TeleLearn(): telegraf baru yang lagi dipelajari / udah aktif
function SK.tlReport()
	local T = SK.tl
	local rows = {}
	for key, e in pairs(T.keys) do
		if e.n > 0 then
			rows[#rows + 1] = { key, e }
		end
	end
	table.sort(rows, function(x, y)
		return x[2].n > y[2].n
	end)
	if #rows == 0 then
		print("[AutoParry:tele] belum ada telegraf baru yang kebaca (butuh hit dari skill / move yang script belum kenal)")
	end
	for i = 1, math.min(#rows, 25) do
		local key, e = rows[i][1], rows[i][2]
		print(("[AutoParry:tele] %s | n %.0f | lead %.3fs +-%.3f | muncul %.0f, kena %.0f | jarak maks %.0f | %s | %s"):format(
			key, e.n, e.mean, math.sqrt(e.var), e.occ, e.hits, e.dmax,
			SK.tlBreaks(e) and "break-block" or "block-able", SK.tlMature(e) and "AKTIF" or "belajar"
		))
	end
	print(("[AutoParry:tele] aksi %.0f | sampel %.0f | jenis event %.0f | error %.0f%s"):format(T.acted, T.learned, T.nkeys, T.errs, T.off and " | OFF" or ""))
end

----------------------------------------------------------------------
-- v13: LEARNSTORE -- hasil belajar disimpen ke file, jadi nggak mulai dari nol tiap sesi
-- v12 sengaja nggak nyimpen hasil belajar karena tergantung ping. Sekarang dipisah:
--   * yang tergantung jaringan (tune M1/M2, stunSlack, statistik M2) cuma dimuat kalau ping sekarang mirip ping pas disimpan,
--     itupun dikecilin (70%) biar masih adaptif;
--   * yang nggak tergantung ping (prior per style, telegraf TeleLearn) dimuat selalu, jumlah sampel dibatasi biar tetap adaptif;
--   * semuanya dibuang otomatis kalau sidik jari spec game (windup / style) beda = game di-update.
----------------------------------------------------------------------
SK.ls = { at = -math.huge, fp = "", ready = false }

function SK.lsSig()
	if Specs.count == 0 then
		return nil
	end
	local names = {}
	for name in pairs(Specs.styles) do
		names[#names + 1] = name
	end
	table.sort(names)
	local parts = {}
	for _, name in ipairs(names) do
		local def = Specs.styles[name]
		parts[#parts + 1] = name
		local sw = type(def.M1) == "table" and def.M1.Swings
		if type(sw) == "table" then
			for _, s in ipairs(sw) do
				if type(s) == "table" then
					parts[#parts + 1] = ("%.3f/%.3f"):format(s.Windup or 0, s.Endlag or 0)
				end
			end
		end
		if type(def.M2) == "table" then
			parts[#parts + 1] = ("m%.3f"):format(def.M2.Windup or 0)
		end
	end
	local s = table.concat(parts, "|")
	local h = 5381
	for i = 1, #s do
		h = (h * 33 + string.byte(s, i)) % 4294967291
	end
	return Specs.count .. ":" .. #s .. ":" .. tostring(h)
end

function SK.lsFp()
	return ("%.4f|%.4f|%.3f|%.0f|%.0f"):format(tune.M1, tune.M2, stunSlack, SK.tl.learned, counters.parried + counters.blocked + counters.dodged)
end

function SK.lsSave()
	if not (CFG.LearnStore and SK.ls.ready and type(writefile) == "function") then
		return false
	end
	local okS, sig = pcall(SK.lsSig)
	if not (okS and sig) then
		return false
	end
	local d = {
		v = 13,
		sig = sig,
		rtt = net.rtt,
		tune = { M1 = tune.M1, M2 = tune.M2 },
		stunSlack = stunSlack,
		sPrior = {},
		sPriorN = {},
		m2s = {},
		tele = {},
	}
	for k, v in pairs(SK.sPrior) do
		if type(k) == "string" and SK.fin(v) then
			d.sPrior[k] = v
			d.sPriorN[k] = SK.fin(SK.sPriorN[k]) and SK.sPriorN[k] or 0
		end
	end
	for k, s in pairs(SK.m2s) do
		if type(k) == "string" and SK.fin(s.pOk) and SK.fin(s.pN) and SK.fin(s.dOk) and SK.fin(s.dN) then
			d.m2s[k] = { pOk = s.pOk, pN = s.pN, dOk = s.dOk, dN = s.dN }
		end
	end
	local cnt = 0
	for key, e in pairs(SK.tl.keys) do
		if e.n >= 3 and e.hits >= 3 and cnt < 60 and SK.fin(e.mean) and SK.fin(e.var) then
			cnt += 1
			d.tele[key] = { n = e.n, mean = e.mean, var = e.var, occ = e.occ, hits = e.hits, dmax = e.dmax, nB = e.nB, nG = e.nG, nP = e.nP, nH = e.nH, nD = e.nD, k2 = e.k2 }
		end
	end
	-- v13.4: simpan tune/stunSlack per bucket ping (40ms) biar ganti jaringan nggak buang hasil belajar
	local buckets = {}
	if type(isfile) == "function" and type(readfile) == "function" then
		local okE, ex = pcall(isfile, CFG.LearnFile)
		if okE and ex then
			local okR, rawOld = pcall(readfile, CFG.LearnFile)
			if okR and type(rawOld) == "string" then
				local okD, old = pcall(HttpService.JSONDecode, HttpService, rawOld)
				if okD and type(old) == "table" and old.sig == sig and type(old.buckets) == "table" then
					buckets = old.buckets
				end
			end
		end
	end
	buckets[tostring(math.floor(net.rtt * 1000 / 40))] = { rtt = net.rtt, tune = { M1 = tune.M1, M2 = tune.M2 }, stunSlack = stunSlack }
	d.buckets = buckets
	local okJ, raw = pcall(HttpService.JSONEncode, HttpService, d)
	if not okJ then
		return false
	end
	local ok = pcall(writefile, CFG.LearnFile, raw)
	if ok then
		SK.ls.at = os.clock()
		SK.ls.fp = SK.lsFp()
	end
	return ok
end

function SK.lsLoad()
	if not (CFG.LearnStore and type(isfile) == "function" and type(readfile) == "function") then
		return false
	end
	local okE, exists = pcall(isfile, CFG.LearnFile)
	if not (okE and exists) then
		return false
	end
	local okR, raw = pcall(readfile, CFG.LearnFile)
	if not okR or type(raw) ~= "string" then
		return false
	end
	local okD, d = pcall(HttpService.JSONDecode, HttpService, raw)
	if not okD or type(d) ~= "table" or d.v ~= 13 then
		return false
	end
	local okS, sig = pcall(SK.lsSig)
	if not (okS and sig) or d.sig ~= sig then
		evt("info", "hasil belajar lama dibuang (spec game beda)")
		return false
	end
	local cur = readPing() or net.rtt
	local same = SK.fin(d.rtt) and math.abs(d.rtt - cur) <= math.max(0.04, d.rtt * 0.35)
	-- v13.4: cari bucket ping terdekat (tune / stunSlack per kondisi jaringan); kalau nggak ada, pakai catatan lama kalau ping mirip
	local src = same and d or nil
	if type(d.buckets) == "table" then
		local bestDiff = math.huge
		for _, b in pairs(d.buckets) do
			if type(b) == "table" and SK.fin(b.rtt) and type(b.tune) == "table" then
				local diff = math.abs(b.rtt - cur)
				if diff <= math.max(0.03, b.rtt * 0.3) and diff < bestDiff then
					bestDiff = diff
					src = b
				end
			end
		end
	end
	if src then
		local w = 0.7
		if type(src.tune) == "table" then
			if SK.fin(src.tune.M1) then
				tune.M1 = math.clamp(src.tune.M1 * w, -CFG.TuneMax, CFG.TuneMax)
			end
			if SK.fin(src.tune.M2) then
				tune.M2 = math.clamp(src.tune.M2 * w, -CFG.TuneMax, CFG.TuneMax)
			end
		end
		if SK.fin(src.stunSlack) then
			stunSlack = math.clamp(CFG.StunSlackStart * (1 - w) + src.stunSlack * w, CFG.StunSlackMin, CFG.StunSlackMax)
		end
	end
	if same then
		if type(d.m2s) == "table" then
			for k, s in pairs(d.m2s) do
				if type(k) == "string" and Specs.styles[k] and type(s) == "table" and SK.fin(s.pOk) and SK.fin(s.pN) and SK.fin(s.dOk) and SK.fin(s.dN) then
					SK.m2s[k] = { pOk = s.pOk * 0.5, pN = s.pN * 0.5, dOk = s.dOk * 0.5, dN = s.dN * 0.5 }
				end
			end
		end
	end
	if type(d.sPrior) == "table" then
		for k, v in pairs(d.sPrior) do
			if type(k) == "string" and SK.fin(v) then
				SK.sPrior[k] = math.clamp(v, -0.08, 0.08)
				local pn = type(d.sPriorN) == "table" and d.sPriorN[k] or 0
				SK.sPriorN[k] = math.min(SK.fin(pn) and pn or 0, 6)
			end
		end
	end
	if type(d.tele) == "table" then
		local T = SK.tl
		for key, s in pairs(d.tele) do
			if type(key) == "string" and type(s) == "table" and not T.keys[key] and T.nkeys < CFG.TeleMaxKeys
				and SK.fin(s.mean) and SK.fin(s.var) and SK.fin(s.n) and SK.fin(s.hits) and SK.fin(s.occ) then
				local cap = math.min(s.n, 6) / math.max(s.n, 1)
				T.keys[key] = {
					n = math.min(s.n, 6),
					mean = s.mean,
					var = math.clamp(s.var, 1e-6, 0.01),
					occ = s.occ * cap,
					hits = s.hits * cap,
					dmax = SK.fin(s.dmax) and s.dmax or 0,
					nB = SK.fin(s.nB) and s.nB or 0,
					nG = SK.fin(s.nG) and s.nG or 0,
					nP = SK.fin(s.nP) and s.nP or 0,
					nH = SK.fin(s.nH) and s.nH or 0,
					nD = SK.fin(s.nD) and s.nD or 0,
					k2 = SK.fin(s.k2) and s.k2 or 0,
				}
				T.nkeys += 1
			end
		end
	end
	return true
end

-- jalan di thread sendiri: tunggu spec ke-load, muat hasil belajar, terus simpan berkala pas lagi nggak tarung
function SK.lsStart()
	if not CFG.LearnStore then
		return
	end
	for _ = 1, 80 do
		if not alive then
			return
		end
		if Specs.count > 0 then
			break
		end
		task.wait(0.5)
	end
	if not alive or Specs.count == 0 then
		return
	end
	local okL, loaded = pcall(SK.lsLoad)
	if okL and loaded then
		evt("info", "hasil belajar sesi lalu dimuat")
	end
	SK.ls.ready = true
	SK.ls.fp = SK.lsFp()
	while alive do
		task.wait(10)
		if not alive then
			break
		end
		local now = os.clock()
		if CFG.LearnStore and now - SK.ls.at > CFG.LearnSaveEvery and not SK.hot(now) and SK.lsFp() ~= SK.ls.fp then
			pcall(SK.lsSave)
		end
	end
end

