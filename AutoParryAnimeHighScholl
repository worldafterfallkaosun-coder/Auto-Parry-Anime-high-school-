-- arah gerak lu sekarang (datar, unit) atau nil kalau lagi diem
function SK.ddInput(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local mv = hum and hum.MoveDirection
	if mv then
		local f = Vector3.new(mv.X, 0, mv.Z)
		if f.Magnitude > 0.1 then
			return f.Unit
		end
	end
	return nil
end

-- penalti jalur dash: tembok di depan + nggak ada tanah di ujung (jurang)
function SK.ddSafety(v, mp, params)
	local travel = CFG.DodgeTravel
	local pen = 0
	local run = travel
	local hit = workspace:Raycast(mp + Vector3.new(0, 0.5, 0), v * travel, params)
	if hit then
		run = hit.Distance
		pen += (1 - run / travel) * 1.8
		if run < 3 then
			pen += 1.2
		end
	end
	local endPos = mp + v * math.max(run - 1, 0)
	local down = workspace:Raycast(endPos + Vector3.new(0, 2, 0), Vector3.new(0, -(CFG.DodgeSafeDrop + 6), 0), params)
	if not down then
		pen += 3.5
	end
	return pen
end

-- sumbu "maju" & "kanan" yang dipakai game buat nentuin arah dodge (datar)
function SK.ddFrame()
	local look, right
	if CFG.DodgeFrame == "Character" then
		local ch = LocalPlayer.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp then
			look, right = hrp.CFrame.LookVector, hrp.CFrame.RightVector
		end
	end
	if not look then
		local cam = workspace.CurrentCamera
		if cam then
			look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
		end
	end
	if not look then
		return Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
	end
	look, right = Vector3.new(look.X, 0, look.Z), Vector3.new(right.X, 0, right.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	right = right.Magnitude > 0.01 and right.Unit or Vector3.new(1, 0, 0)
	return look, right
end

-- bungkus arah dunia v jadi pilihan: vektor, nama arah 4-way, vektor ControlModule, tabel tombol
function SK.ddMake(v, why)
	local look, right = SK.ddFrame()
	local fwd, rgt = v:Dot(look), v:Dot(right)
	local rel
	if math.abs(fwd) >= math.abs(rgt) then
		rel = fwd >= 0 and "F" or "B"
	else
		rel = rgt >= 0 and "R" or "L"
	end
	local names = { F = CFG.DodgeNameF, B = CFG.DodgeNameB, L = CFG.DodgeNameL, R = CFG.DodgeNameR }
	local t = 0.38
	local K = Enum.KeyCode
	local w, s, d, a = fwd > t, fwd < -t, rgt > t, rgt < -t
	return {
		vec = v,
		rel = rel,
		relName = names[rel],
		why = why,
		cmVec = Vector3.new(rgt, 0, -fwd),
		keys = { [K.W] = w, [K.Up] = w, [K.S] = s, [K.Down] = s, [K.D] = d, [K.Right] = d, [K.A] = a, [K.Left] = a },
	}
end

-- pilih arah dodge. nil = biarin game yang nentuin
function SK.ddPick(attacker, plan, char)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	local mode = CFG.DodgeDirMode
	local mp = hrp.Position
	local iv = (CFG.DodgeFollowInput or mode == "Input") and SK.ddInput(char) or nil
	if mode == "Input" and not iv then
		return nil -- lagi diem: biarin game
	end
	-- sumbu serangan: dari lu ke attacker (datar)
	local axis = nil
	local ahrp = typeof(attacker) == "Instance" and attacker:FindFirstChild("HumanoidRootPart") or nil
	if ahrp then
		local d = ahrp.Position - mp
		d = Vector3.new(d.X, 0, d.Z)
		if d.Magnitude > 0.5 then
			axis = d.Unit
		end
	end
	if not axis then
		local lv = hrp.CFrame.LookVector
		lv = Vector3.new(lv.X, 0, lv.Z)
		axis = lv.Magnitude > 0.01 and lv.Unit or Vector3.new(0, 0, -1)
	end
	local side = Vector3.new(-axis.Z, 0, axis.X)
	local kind = SK.atkKind(plan)
	local W = (mode == "Away" and SK.ddW.away) or SK.ddW[kind] or SK.ddW.heavy
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	params.RespectCanCollide = true
	local best, bestSc, bestCat = nil, -math.huge, "back"
	local cands = SK.ddCands
	for i = 1, #cands do
		local c = cands[i]
		local v = axis * c.a + side * c.s
		local sc = W[c.cat] - SK.ddSafety(v, mp, params)
		if iv then
			local dt = v:Dot(iv)
			sc += CFG.DodgeInputWeight * (dt > 0 and dt or dt * 0.5)
		end
		if sc > bestSc then
			best, bestSc, bestCat = v, sc, c.cat
		end
	end
	if not best then
		return nil
	end
	if iv and best:Dot(iv) > 0.85 then
		return SK.ddMake(iv, "ikut arah gerak")
	end
	return SK.ddMake(best, kind .. "/" .. bestCat)
end

-- isi fungsi f: nama konstanta yang disebut (butuh getconstants dari executor) -> set, atau nil
function SK.ddProbe(f)
	local getc = (type(debug) == "table" and debug.getconstants) or getconstants
	if type(getc) ~= "function" or type(f) ~= "function" then
		return nil
	end
	local ok, consts = pcall(getc, f)
	if not ok or type(consts) ~= "table" then
		return nil
	end
	local set = {}
	for _, c in pairs(consts) do
		if type(c) == "string" then
			set[c] = true
		end
	end
	return set
end

-- pasang lapis pemaksa arah (sekali, pas dodge pertama). return true kalau ada minimal satu lapis
function SK.ddInstall()
	local dd = SK.dd
	if dd.installed then
		return dd.any
	end
	dd.installed = true
	local info = dd.info
	dd.seen[CFG.DodgeDirection] = (dd.seen[CFG.DodgeDirection] or 0) + 1 -- nama dari dump game
	local H = genv.__NyxAPHooks -- hook nggak numpuk kalau script dieksekusi ulang: hook dipasang sekali, isinya lewat slot
	if type(H) ~= "table" then
		H = {}
		genv.__NyxAPHooks = H
	end
	dd.H = H
	local hnd = getHandler()
	local set = hnd and SK.ddProbe(hnd.TryDodge) or nil
	info.consts = set

	-- L1: ControlModule:GetMoveVector (relatif kamera, maju = -Z)
	pcall(function()
		local ps = LocalPlayer:FindFirstChild("PlayerScripts")
		local pm = ps and ps:FindFirstChild("PlayerModule")
		local mod = pm and require(pm)
		local controls = mod and mod:GetControls()
		if controls and type(controls.GetMoveVector) == "function" then
			local orig = controls.GetMoveVector
			dd.cm, dd.cmOwn = controls, rawget(controls, "GetMoveVector")
			controls.GetMoveVector = function(self, ...)
				if alive and dd.cmVec and os.clock() <= dd.untilAt then
					return dd.cmVec
				end
				return orig(self, ...)
			end
			info.cm = true
		end
	end)

	local canHook = type(hookfunction) == "function" and type(newcclosure) == "function"
	if canHook then
		-- L2: UserInputService:IsKeyDown
		if not H.kd then
			pcall(function()
				local oldKD
				oldKD = hookfunction(UserInputService.IsKeyDown, newcclosure(function(self, key)
					local s = H.kdSlot
					if s then
						local r = s(key)
						if r ~= nil then
							return r
						end
					end
					return oldKD(self, key)
				end))
				H.kd = oldKD
			end)
		end
		if H.kd then
			H.kdSlot = function(key)
				if alive and dd.keys and os.clock() <= dd.untilAt then
					return dd.keys[key]
				end
				return nil
			end
			info.keys = true
		end

		-- L4: pantau remote Combat (nama arah yang dikirim game + verifikasi)
		if not H.fs then
			pcall(function()
				local oldFS
				oldFS = hookfunction(Combat.FireServer, newcclosure(function(self, ...)
					local s = H.fsSlot
					-- v13.5: cuma remote Combat yang diproses (hook ini kena SEMUA RemoteEvent:FireServer di game)
					if s and self == Combat then
						pcall(s, self, (...))
					end
					return oldFS(self, ...)
				end))
				H.fs = oldFS
			end)
		end
		if H.fs then
			H.fsSlot = function(self, a1)
				if not alive or self ~= Combat or type(a1) ~= "table" or a1.Info ~= "Dodge" then
					return
				end
				local d = a1.Direction
				if os.clock() <= dd.untilAt and dd.relName then
					if type(d) == "string" then
						dd.nat = d
						if string.lower(string.sub(d, 1, 1)) == string.lower(string.sub(dd.relName, 1, 1)) then
							dd.okN += 1
						else
							dd.missN += 1
							evt("info", ("dodge arah: script pilih %s tapi game kirim %s"):format(dd.relName, d))
						end
					end
					if CFG.DodgeRewriteRemote and dd.seen[dd.relName] then
						a1.Direction = dd.relName
						dd.rewrote += 1
					end
				elseif type(d) == "string" then
					dd.seen[d] = (dd.seen[d] or 0) + 1
				end
			end
			info.fire = true
		end

		-- L3: Humanoid.MoveDirection (hook __index global -> cuma kalau TryDodge kebaca nyebut MoveDirection)
		if CFG.DodgeHookIndex and set and set.MoveDirection and type(hookmetamethod) == "function" then
			if not H.idx then
				pcall(function()
					local oldIdx
					oldIdx = hookmetamethod(game, "__index", newcclosure(function(self, k)
						if k == "MoveDirection" then
							local s = H.idxSlot
							if s then
								local r = s(self)
								if r ~= nil then
									return r
								end
							end
						end
						return oldIdx(self, k)
					end))
					H.idx = oldIdx
				end)
			end
			if H.idx then
				H.idxSlot = function(self)
					if alive and dd.vec and os.clock() <= dd.untilAt and self == dd.hum then
						return dd.vec
					end
					return nil
				end
				info.idx = true
			end
		end
	end

	dd.any = (info.cm or info.keys or info.idx) and true or false
	return dd.any
end

function SK.ddUninstall()
	local dd = SK.dd
	if dd.cm then
		pcall(function()
			dd.cm.GetMoveVector = dd.cmOwn
		end)
		dd.cm = nil
	end
	local H = dd.H
	if H then
		H.kdSlot, H.idxSlot, H.fsSlot = nil, nil, nil
	end
	dd.installed, dd.any = false, false
	dd.info = {}
end

-- panggil f(...) (TryDodge) dengan arah pilihan aktif. return pcall(f, ...)
function SK.ddCall(choice, f, ...)
	local dd = SK.dd
	if not (choice and CFG.DodgeDir) then
		return pcall(f, ...)
	end
	local okI, any = pcall(SK.ddInstall)
	if not (okI and any) then
		return pcall(f, ...)
	end
	local char = LocalPlayer.Character
	dd.hum = char and char:FindFirstChildOfClass("Humanoid") or nil
	dd.vec, dd.cmVec, dd.keys, dd.relName = choice.vec, choice.cmVec, choice.keys, choice.relName
	dd.untilAt = os.clock() + CFG.DodgeSpoofHold
	dd.nat = nil
	dd.n += 1
	dd.last = { name = choice.relName, why = choice.why, at = os.clock() }
	return pcall(f, ...)
end

-- getgenv().__NyxAutoParry.DodgeInfo(): lapis yang aktif, apa yang kebaca dari TryDodge, hasil verifikasi arah
