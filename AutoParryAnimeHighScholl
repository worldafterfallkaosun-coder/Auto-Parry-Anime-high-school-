-- REPORT
----------------------------------------------------------------------
local function report()
	local c, s = {}, {}
	for k, v in pairs(counters) do
		table.insert(c, k .. "=" .. v)
	end
	for k, v in pairs(skips) do
		table.insert(s, k .. "=" .. v)
	end
	table.sort(c)
	table.sort(s)
	print("[AutoParry] hitung :", table.concat(c, " "))
	print("[AutoParry] skip   :", #s > 0 and table.concat(s, " ") or "-")
	print(("[AutoParry] tune M1 %+.3f | M2 %+.3f | rtt %.3f | style kebaca %d"):format(tune.M1, tune.M2, rtt, Specs.count))
end

