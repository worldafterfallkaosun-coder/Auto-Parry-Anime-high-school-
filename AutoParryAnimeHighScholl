function K.hookParry()
    local ui = AP and AP.UI
    if type(ui) ~= "table" then return end
    -- toast ON/OFF dari tombol toggle (P) tampil di UI hub
    ui.toast = function(msg, kind) toast(msg, (kind == "bad") and "err" or kind) end
    ui.refresh = function() end
end

function K.pollPar()
    local m = MOD.par
    local api = env.__NyxAutoParry
    if m.state ~= "ready" then
        if m.state ~= "loading" then return end
        if type(api) == "table" and type(api.CFG) == "table" and type(api.Counters) == "table" then
            AP, CFG13 = api, api.CFG
            m.state, m.err = "ready", nil
            K.hookParry()
            log("Auto parry v" .. tostring(api.Version) .. " terhubung", "ok")
        elseif os.clock() - m.t0 > m.wait then
            m.state = "missing"
        end
        return
    end
    if env.__NyxAutoParry ~= AP then
        m.state, m.err = "missing", "Auto parry dihentikan atau diganti instance lain"
        return
    end
    local c, net = AP.Counters, AP.Net or {}
    local v = V.par
    v.on = CFG13.Enabled == true
    local okS, st = pcall(AP.State)
    v.block = (okS and type(st) == "table" and st.blockHeld) and true or false
    v.rtt = (tonumber(net.rtt) or 0) * 1000
    v.parried, v.blocked, v.dodged = c.parried or 0, c.blocked or 0, c.dodged or 0
    v.hit, v.gb = c.hit or 0, c.guardbroken or 0
    local landed = v.parried + v.blocked + v.gb + v.hit
    local all = landed + v.dodged
    v.rate = all > 0 and math.floor((v.parried + v.blocked + v.dodged) / all * 100 + 0.5) or 100
    -- v13.5: tanda lagi tarung (hitungan hasil berubah / block nyala) buat mode hemat efek
    if all ~= v.lastAll or v.block then v.lastAct = os.clock() end
    v.lastAll = all
    -- v13.5: perubahan opsi yang cuma lewat Store.touch (preset / reset / hotkey) ikut disimpan
    local stt = AP.Store
    if type(stt) == "table" and stt.dirtyAt then K.saveSoon() end
end

