    return true
end
function K.sweepStop()
    SW.running = false
    if SW.conn then pcall(function() SW.conn:Disconnect() end); SW.conn = nil end
    for obj, props in pairs(SW.orig) do
        for p, v in pairs(props) do pcall(function() obj[p] = v end) end
