function K.conList(sig)
    local out = {}
    if not CAP.getconnections then return out end
    local ok, list = pcall(getconnections, sig)
    if not ok or type(list) ~= "table" then return out end
    for _, c in ipairs(list) do
        local f
        pcall(function() f = c.Function end)
        out[#out + 1] = { c = c, f = f }
    end
    return out
end
function K.snap(sig)
    local t = {}
    for _, it in ipairs(K.conList(sig)) do if it.f then t[it.f] = true end end
    return t
end
function K.diff(sig, before)
    local out = {}
    for _, it in ipairs(K.conList(sig)) do
        if it.f and not before[it.f] then out[#out + 1] = it.c end
    end
    return out
end
function K.srcOf(f)
    if not CAP.debuginfo or not f then return nil end
    local ok, s = pcall(debug.info, f, "s")
    if ok and type(s) == "string" then return s end
    return nil
end
-- redam handler UIS.InputBegan milik modul tertentu (dikenali dari chunkname SIFB_<key>)
function K.muteKeys(key)
    if not S.mute or not CAP.getconnections then return 0 end
    local n = 0
    for _, it in ipairs(K.conList(UIS.InputBegan)) do
        local s = K.srcOf(it.f)
        if s and s:find("SIFB_" .. key, 1, true) then
            local c = it.c
            if pcall(function() c:Disable() end) then MUTED[#MUTED + 1] = c; n = n + 1 end
        end
    end
    if n > 0 then log("Hotkey bawaan " .. MOD[key].label .. " diredam (" .. n .. ")", "ok") end
    return n
end
function K.unmuteAll()
    for _, c in ipairs(MUTED) do pcall(function() c:Enable() end) end
    MUTED = {}
end

function K.getUps(f)
    local out = {}
    if not CAP.upvalues or type(f) ~= "function" then return out end
    if type(debug.getupvalues) == "function" then
        local ok, t = pcall(debug.getupvalues, f)
        if ok and type(t) == "table" then
            for _, v in pairs(t) do out[#out + 1] = v end
            return out
        end
    end
    if type(debug.getupvalue) == "function" then
        for i = 1, 60 do
            local ok, a, b = pcall(debug.getupvalue, f, i)
            if not ok or (a == nil and b == nil) then break end
            if type(a) == "string" and b ~= nil then out[#out + 1] = b else out[#out + 1] = a end
        end
    end
    return out
end

-- cari tabel CFG milik Nono (LOD aksesori) lewat getgc
function K.scanAsync()
    if SCAN.busy or not CAP.getgc then return end
    SCAN.busy = true
    task.spawn(function()
        local ok, list = pcall(getgc, true)
        if ok and type(list) == "table" then
            for i = 1, #list do
                local t = list[i]
                if type(t) == "table" then
                    pcall(function()
                        if not CFGT.lagcfg and rawget(t, "playerLODDist") ~= nil and rawget(t, "fpsLowThreshold") ~= nil then
                            CFGT.lagcfg = t
                        end
                    end)
                end
                if i % 4000 == 0 then task.wait() end
            end
        end
        SCAN.busy, SCAN.last = false, os.clock()
    end)
end

