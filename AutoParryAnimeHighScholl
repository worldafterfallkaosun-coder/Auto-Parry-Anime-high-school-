local function summaryText()
    local c = counters
    local landed = c.parried + c.blocked + c.guardbroken + c.hit
    local all = landed + c.dodged
    local rate = all > 0 and (c.parried + c.blocked + c.dodged) / all * 100 or 100
    local parryRate = landed > 0 and c.parried / landed * 100 or 0
    return table.concat({
        ("AutoParry v13.6 | parry %d  block %d  dodge %d  kena %d  gb %d | aman %.0f%% | parry-rate %.0f%%"):format(
            c.parried, c.blocked, c.dodged, c.hit, c.guardbroken, rate, parryRate
        ),
        ("rtt %.0fms (±%.0f) | fps %.0f (p90 %.0fms, spike %d) | cpu %.0fus/frame (max %.0fus)"):format(
            net.rtt * 1000, net.var * 1000, frame.fps, frame.p90 * 1000, frame.spikes, frame.cpu * 1e6, frame.cpuMax * 1e6
        ),
        ("tune M1 %+.3f M2 %+.3f | stunSlack %.2f | refused %d late %d locked %d | respawn %d healed %d recheck %d | hitguard %d"):format(
            tune.M1, tune.M2, stunSlack, c.refused, c.late, c.locked, c.respawns, c.healed, c.recheck, c.hitguard or 0
        ),
    }, "\n")
end

