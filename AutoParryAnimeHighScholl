local expected = {} -- { atk, at }: hit yang lagi diantisipasi (buat nentuin perlu nahan block abis parry atau nggak)

local function noteExpected(atk, at, now, kind)
	for i = #expected, 1, -1 do
		if expected[i].at < now - 0.3 then
			table.remove(expected, i)
		end
	end
	expected[#expected + 1] = { atk = atk, at = at, kind = kind }
end

