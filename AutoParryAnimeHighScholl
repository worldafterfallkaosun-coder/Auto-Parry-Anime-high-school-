				local y = (ap.Y + SIZE + 6 + PH > vs.Y - 4) and -(PH + 6) or (SIZE + 6)
				panel.Position = UDim2.fromOffset(x, y)
				panel.Visible = true
				UI.refresh()
			else
				panel.Visible = false
			end
		end
