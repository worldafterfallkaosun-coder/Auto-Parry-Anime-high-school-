local Maint = { g = { ping = {}, fps = {}, cpu = {}, head = 0, count = 0 }, nextHeal = 0, nextGraph = 0 }
local G_N = 60

local function resetCombatState(why)
	for i = 1, #queue do
		queue[i].dead = true
	end
	table.clear(queue)
	cancel(releaseHandle)
	cancel(retryHandle)
	releaseHandle, retryHandle = nil, nil
	blockHeld, rawOn, blockAttrSeen = false, false, false
	blockFor = nil
	readyAt, lockedUntil = 0, 0
	parriedAt, lastRefusedAt, lastOwnOff, blockOnAt = -math.huge, -math.huge, -math.huge, -math.huge
	dodgeReadyAt, dodgeBusyUntil, dodgePlannedUntil, dodgeBlockUntil, dodgeSentAt = 0, 0, 0, 0, -math.huge
	stunUntil, stunSrcUntil, stunProbeAt = 0, -math.huge, -math.huge
	pressMode = "parry"
	table.clear(pending)
	table.clear(expected)
	table.clear(swingGuards)
	table.clear(swingAt)
	table.clear(combo)
	table.clear(planToken)
	table.clear(heavySeen)
	table.clear(lastSwingSeen)
	table.clear(comboVictim)
	table.clear(SK.barr)
	SK.pgTok = (SK.pgTok or 0) + 1 -- v11.4: guard abis ke-parry yang lagi nunggu dibatalin
	SK.pgRe = nil
	SK.hgTok = (SK.hgTok or 0) + 1 -- v11.5: guard abis kena
	SK.hgRe = nil
	table.clear(SK.rf)
	hCount, histOwner = 0, nil
	lastRetryAt, retryWindowAt, retryCount = -math.huge, -math.huge, 0
	-- Local.Blocking milik game jangan nyangkut true: SetLocalBlocking(true) berikutnya jadi no-op (nggak ngirim paket apa-apa)
	if CFG.UseGameBlock then
		local h = getHandler()
		if h and type(h.Local) == "table" and h.Local.Blocking == true and type(h.DropLocalGuard) == "function" then
			pcall(h.DropLocalGuard, h, workspace:GetServerTimeNow())
		end
	end
	trace("state direset:", why)
end

-- timer yang nilainya mustahil (bug / data bogus dari server) dirapihin. Nilai normal nggak disentuh.
local function selfHeal(now)
	local fixed = false
	if lockedUntil > now + 3 then
		lockedUntil, fixed = now + 3, true
	end
	if readyAt > now + 3 then
		readyAt, fixed = now + SR.BlockCooldown, true
	end
	if dodgeReadyAt > now + 8 then
		dodgeReadyAt, fixed = now + SR.Dash.Cooldown, true
	end
	if dodgeBusyUntil > now + 3 then
		dodgeBusyUntil, fixed = now, true
	end
	if dodgePlannedUntil > now + 8 then
		dodgePlannedUntil, fixed = 0, true
	end
	if dodgeBlockUntil > now + 3 then
		dodgeBlockUntil, fixed = 0, true
	end
	if stunUntil > now + 3 then
		stunUntil, fixed = now, true
	end
	-- cadangan watchdog Heartbeat: block nyala jauh melewati jadwal lepasnya
	if blockHeld and now > releaseAt + 1.0 then
		pcall(sendBlock, false)
		blockHeld = false
		readyAt = now + SR.BlockCooldown
		fixed = true
	end
	for i = #expected, 1, -1 do
		if expected[i].at < now - 1 then
			table.remove(expected, i)
		end
	end
	for i = #pending, 1, -1 do
		if pending[i].hit < now - 1 then
			table.remove(pending, i)
		end
	end
	for i = #swingGuards, 1, -1 do
		if swingGuards[i].to < now - 1 then
			table.remove(swingGuards, i)
		end
	end
	for i = #queue, 1, -1 do
		local q = queue[i]
		if q.dead or q.ran then
			table.remove(queue, i)
		end
	end
	if fixed then
		counters.healed += 1
		trace("self-heal: ada timer yang nggak masuk akal, dirapihin")
	end
end

function Maint.tick(now)
	if CFG.SelfHeal and now >= Maint.nextHeal then
		Maint.nextHeal = now + 0.5
		selfHeal(now)
	end
	if now >= Maint.nextGraph then
		Maint.nextGraph = now + 1
		local g = Maint.g
		g.head = g.head % G_N + 1
		g.ping[g.head] = net.rtt * 1000
		g.fps[g.head] = frame.fps
		g.cpu[g.head] = frame.cpu * 1e6
		g.count = math.min(g.count + 1, G_N)
		frame.cpuMax = math.max(frame.cpu, frame.cpuMax * 0.8)
	end
end

