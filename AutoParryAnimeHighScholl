function SK.doctor()
	local c = counters
	local P, B, D, H, G = c.parried, c.blocked, c.dodged, c.hit, c.guardbroken
	local all = P + B + D + H + G
	local out = {}
	local function say(s)
		out[#out + 1] = s
		print("[AutoParry:doctor] " .. s)
	end
	if all < 10 then
		say(("data belum cukup (%.0f hit tercatat, butuh minimal 10). Lawan dulu sebentar, terus panggil Doctor() lagi."):format(all))
		return out
	end
	local bad = H + G
	say(("hasil: parry %.0f%% | block %.0f%% | dodge %.0f%% | KENA %.0f%% (%.0f dari %.0f hit)"):format(
		P / all * 100, B / all * 100, D / all * 100, bad / all * 100, bad, all
	))
	local rows = {}
	for k, v in pairs(skips) do
		if k ~= "dup" and k ~= "iframes" and k ~= "locked" then
			rows[#rows + 1] = { k, v }
		end
	end
	table.sort(rows, function(x, y)
		return x[2] > y[2]
	end)
	local pingMs = ("%.0f"):format(net.rtt * 1000)
	for i = 1, math.min(#rows, 4) do
		local k, v = rows[i][1], rows[i][2]
		local tip = nil
		if k == "late" then
			tip = "ping " .. pingMs .. "ms + frame lebih gede dari windup serangan, jadi hit pertama emang nggak sempat di-react. Yang bisa: turunin ping / pindah server, jaga LateModeM1 = \"block\", dan biarin HitGuard + TeleLearn nutup hit lanjutan."
		elseif k == "locked/cd" then
			tip = "block kekunci cooldown 0.75s abis block lepas. Jangan lepas block manual pas ada musuh aktif; naikin MaxHoldActive atau PostParryTail."
		elseif k == "locked/busy" then
			tip = "lu lagi nyerang (busy) pas hit dateng. Pastiin GuardPriority = true, dan jangan spam klik pas lawan baru ngayun."
			if CFG.GuardPriority and (counters.swingheld or 0) == 0 and (v or 0) >= 5 then
				tip = tip .. " Catatan: swing yang ditahan = 0, hook TrySwing kemungkinan nggak kepasang (game manggil lewat upvalue). Cek Report() baris 'hook swing'."
			end
		elseif k == "locked/stun" or k == "locked/ke-parry" then
			tip = "block kekunci stun. Pastiin HitGuard dan ParriedGuard true; naikin HitGuardRange kalau lawan agak jauh."
		elseif k == "locked/dodge" then
			tip = "block ketahan dodge (Busy 0.4s). Matiin DodgeForM1 atau set DodgeFirstM2 = false kalau dodge kebanyakan."
		elseif k == "locked/game" then
			tip = "state game (CombatHandler.Local) yang nahan block. Kalau block kerasa telat, coba UseGameState = false."
		elseif k == "range" then
			tip = "banyak ancaman dibuang karena dianggap di luar jangkauan. Naikin RangeMargin (+0.5), WidthMargin atau CloseAlways (+2)."
		elseif k == "heldold" then
			tip = "block yang udah nyala kelamaan buat nge-parry (wajar kalau lagi chain). Kalau sering, kecilin ChainHold."
		elseif k == "parrycd" then
			tip = "parry masih cooldown (0.7s) pas hit dateng, normal di combo cepat. Pastiin BlockFallback = true."
		elseif k == "dodge-late" or k == "dodge-early" or k == "dodge-recheck" or k == "dodge-unsure" then
			tip = "dodge nggak sempat / kebuang. Cek DodgeInfo(); coba naikin DodgeLateBias."
		elseif k == "notincombat" then
			tip = "flag InCombat lu false pas ada serangan. Nyalain stance (T) lebih awal."
		end
		if tip then
			say(("#%d skip \"%s\" x%.0f: %s"):format(i, k, v, tip))
		else
			say(("#%d skip \"%s\" x%.0f"):format(i, k, v))
		end
	end
	if math.abs(tune.M1) >= CFG.TuneMax * 0.9 then
		say(("tune M1 mentok (%+.3f). Geser TargetAgeM1 (+/-0.02) ke arah yang sama."):format(tune.M1))
	end
	if math.abs(tune.M2) >= CFG.TuneMax * 0.9 then
		say(("tune M2 mentok (%+.3f). Geser TargetAgeM2 (+/-0.02) ke arah yang sama."):format(tune.M2))
	end
	if frame.fps < 40 then
		say(("fps rendah (%.0f): timing jadi kasar. Turunin grafik, atau set UI = false."):format(frame.fps))
	end
	if net.var > 0.04 then
		say(("ping goyang (+-%.0fms): jaga LagAdaptive = true."):format(net.var * 1000))
	end
	local mature, learning = 0, 0
	for _, e in pairs(SK.tl.keys) do
		if e.n > 0 then
			if SK.tlMature(e) then
				mature = mature + 1
			else
				learning = learning + 1
			end
		end
	end
	local kinds = {}
	for k in pairs(SK.seen) do
		kinds[#kinds + 1] = tostring(k)
	end
	table.sort(kinds)
	if #kinds > 0 then
		say("skill yang pernah kena ke lu: " .. table.concat(kinds, ", ") .. (mature == 0 and " (belum ada telegrafnya yang kebelajar; makin sering kena, makin cepat TeleLearn nangkep)" or ""))
	end
	say(("TeleLearn: %.0f telegraf aktif, %.0f lagi dipelajari (detail: TeleLearn())"):format(mature, learning))
	return out
end

local seenKind = {}

local function onCombat(data)
	if type(data) ~= "table" then
		return
	end
	local info, kind = data.Info, data.Kind
	-- v13: TeleLearn nyatet semua event yang belum dikenal (dan jalanin telegraf yang udah kebelajar)
	if CFG.TeleLearn and not SK.tl.off and info ~= "Hit" then
		SK.tlSafe(SK.tlEvent, data, info, kind)
	end
	if not CFG.Enabled and (info == "Sound" or info == "Flash") then
		return
	end

	if info == "Sound" then
		local a = data.Character
		if typeof(a) ~= "Instance" or a == LocalPlayer.Character then
			return
		end
		if isFar(a) then
			return
		end
		if kind == "HeavySwing" then
			-- cadangan kalau Flash nggak nyampe (Flash biasanya nyampe duluan, jadi ini di-dedupe)
			local now = os.clock()
			if now - (heavySeen[a] or -math.huge) > 0.25 then
				heavySeen[a] = now
				local plan = m2Plan(a, nil)
				swingAt[a] = { t = now, lead = plan.lead, kind = "M2", key = plan.key, skey = plan.skey, learn = plan.learn }
				lastSwingSeen[a] = now
				react(a, plan, "M2")
			end
		elseif Specs.swingSound[kind] then
			local now = os.clock()
			trace("swing M1 kebaca dari", a.Name, "sound:", tostring(kind))
			pcall(SK.iqSoundObs, a, kind) -- v12: bukti style dari nama Sound
			local plan = m1Plan(a, now)
			swingAt[a] = { t = now, lead = plan.lead, kind = "M1", key = plan.key, skey = plan.skey, learn = plan.learn }
			lastSwingSeen[a] = now
			react(a, plan, "M1")
			predictFollowUp(a, plan, now)
		elseif CFG.Trace and not seenKind[tostring(kind)] then
			seenKind[tostring(kind)] = true
			trace("sound lain (nggak dianggap swing):", tostring(kind))
		end
	elseif info == "Flash" and kind == "Heavy" then
		local a, hold = data.Character, data.Hold
		if typeof(a) == "Instance" and a ~= LocalPlayer.Character and type(hold) == "number" and not isFar(a) then
			local now = os.clock()
			trace("heavy M2 kebaca dari", a.Name, "hold:", hold)
			heavySeen[a] = now
			pcall(SK.iqHeavyObs, a, hold) -- v12: bukti style dari Hold Flash Heavy
			local plan = m2Plan(a, hold)
			swingAt[a] = { t = now, lead = plan.lead, kind = "M2", key = plan.key, skey = plan.skey, learn = plan.learn }
			lastSwingSeen[a] = now
			react(a, plan, "M2")
		end
	elseif info == "EndFlash" then
		-- heavy attacker dibatalin (kena stun / ke-parry orang lain) -> hit nggak bakal mendarat
		local a = data.Character
		if typeof(a) == "Instance" then
			planToken[a] = (planToken[a] or 0) + 1
			clearGuards(a)
			swingAt[a] = nil
		end
	elseif info == "Hit" then
		onHit(data)
	elseif info == "BlockRefused" then
		local untilServer = data.Until
		if type(untilServer) == "number" then
			lockedUntil = math.max(lockedUntil, os.clock() + math.max(0, untilServer - workspace:GetServerTimeNow()))
		end
		if stunProbeAt == blockOnAt and os.clock() - blockOnAt < net.rtt + 0.4 then
			stunLearn(false) -- v8: block pas-unlock ditolak -> kita kemaleman? bukan, kecepetan -> pengaman dinaikin
		end
		lastRefusedAt = os.clock()
		counters.refused += 1
		dropLocalBlock()
		if CFG.Debug then log(("block ditolak server (sisa %.2fs)"):format(math.max(0, lockedUntil - os.clock()))) end
		if CFG.GuardRetryOnRefuse then
			retryGuard()
		end
		evt("info", ("block ditolak server (sisa %.2fs)"):format(math.max(lockedUntil - os.clock(), 0)))
		-- v11.4/v11.5: guard abis ke-parry / abis kena ditolak server (stun hit nambah dll) -> coba lagi begitu kunci beneran kebuka
		if CFG.ParriedGuardRearm then
			for _, pr in ipairs({ SK.pgRe or false, SK.hgRe or false }) do
				if pr and pr.tok == SK[pr.key] and os.clock() < pr.deadline then
					local tNow = os.clock()
					local gl2 = gameLock()
					local at2 = math.max(lockedUntil, readyAt, gl2 or -math.huge, tNow) + 0.012
					schedule(math.max(at2, tNow + 0.03) + frame.avg * CFG.FireEarly, pr.attempt)
				end
			end
		end
	end
end

