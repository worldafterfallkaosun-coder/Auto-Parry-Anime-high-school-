			if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
				return
			end
			dragging, moved = true, false
			dragStart, startPos = input.Position, root.Position
			if UI.dragConn then
				UI.dragConn:Disconnect()
			end
			UI.dragConn = UserInputService.InputChanged:Connect(function(i)
				if not dragging then
					return
				end
				local tt = i.UserInputType
				if tt == Enum.UserInputType.MouseMovement or tt == Enum.UserInputType.Touch then
					local d = i.Position - dragStart
					if not moved and d.Magnitude > 6 then
						moved = true
					end
					if moved then
						root.Position =
							UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
					end
				end
			end)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if UI.dragConn then
						UI.dragConn:Disconnect()
						UI.dragConn = nil
					end
					if not moved then
						UI.togglePanel()
					end
				end
			end)
		end)

