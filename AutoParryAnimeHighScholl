--[[
    AutoParry v13.6
    Game    : Roblox fighting game (ReplicatedStorage.Remotes.Combat, M1/M2/Block/Parry/Dodge)
    Runtime : Luau, client-side (jalanin lewat executor lu)
    Toggle  : P (CFG.ToggleKey)  |  UI: CFG.UIKey (orb geser = pindah, tap = buka/tutup, tahan = ON/OFF)
    UI: hub Skill issue final boss (By Duke), lihat blok hub di file ini (tab Opsi = cari semua opsi CFG)
    Diag    : getgenv().__NyxAutoParry.{ Summary, Why, Doctor, State, StyleIQ, DodgeInfo, TeleLearn, Report }()
    Riwayat : lihat CHANGELOG.md (v3 -> v13.2). Semua fitur tambahan bisa dimatiin lewat CFG.

    Aturan server (dari dump CombatHandler / CombatSettings):
      - Parry  = Block ON dengan umur 0..ParryWindow(0.25s) pas hit mendarat di server,
                 DAN udah >= ParryCooldown(0.7s) sejak parry terakhir.
      - Umur block diukur di SERVER (BlockStartedAt = waktu paket Block ON nyampe).
        Jadi yang penting = kapan paket lu NYAMPE, bukan kapan lu kirim.
      - M1 mendarat Windup detik setelah Sound swing disiarkan server.
      - M2 mendarat Windup detik setelah Flash "Heavy". M2 BreaksBlock -> cuma parry yang nyelametin.
      - Block ON ditolak kalau: stun, guard break, BusyUntil (lagi nyerang/dash), atau
        belum lewat BlockCooldown(0.75s) sejak Block OFF.

    Batas fisik: M1 yang lead-nya <= ping lu (mis. windup 0.2s, ping 220ms) nggak bisa di-react,
    paketnya nyampe setelah hit. Buat itu cuma ada prediksi combo + chain cover.
]]

local genv = (getgenv and getgenv()) or _G
if genv.__NyxAutoParry then
	pcall(genv.__NyxAutoParry.Stop)
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local Combat
do
	local Remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
	Combat = Remotes and Remotes:WaitForChild("Combat", 15)
end
if not Combat then
	local msg = "Remotes.Combat nggak ketemu (15s). Game update / nama remote berubah, script nggak dijalanin."
	warn("[AutoParry] " .. msg)
	pcall(function()
		StarterGui:SetCore("SendNotification", { Title = "AutoParry", Text = msg, Duration = 6 })
	end)
	return
end

