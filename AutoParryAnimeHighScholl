local Store = { dirtyAt = nil, defaults = {}, active = nil }
local SAVE_KEYS, SAVE_SET = {}, {}
do
	-- Enabled sengaja nggak disimpan (script jangan nyala OFF diam-diam); Debug/Trace nggak disimpan biar print massal nggak nyala sendiri
	local skipKeys = { UI = true, ConfigFile = true, LearnFile = true, Enabled = true, Debug = true, Trace = true, DebugPlan = true }
	for k, v in pairs(CFG) do
		local t = typeof(v)
		if not skipKeys[k] and (t == "number" or t == "boolean" or t == "string" or t == "EnumItem") then
			SAVE_KEYS[#SAVE_KEYS + 1] = k
		end
	end
	SAVE_KEYS[#SAVE_KEYS + 1] = "PingOverride" -- nil di CFG bawaan, tapi boleh diisi dari UI
	table.sort(SAVE_KEYS)
	for _, k in ipairs(SAVE_KEYS) do
		SAVE_SET[k] = true
		Store.defaults[k] = CFG[k]
	end
end

