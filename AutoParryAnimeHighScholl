				Size = UDim2.new(1, 0, 0, 22),
			}, track)

			local function paint()
				local v = CFG[def.key]
				if type(v) ~= "number" then
					v = def.min
				end
				local a = math.clamp((v - def.min) / (def.max - def.min), 0, 1)
				fill.Size = UDim2.fromScale(a, 1)
				knob.Position = UDim2.fromScale(a, 0.5)
				if def.unit == "ms" then
					setText(val, ("%d ms"):format(math.floor(v * 1000 + 0.5)))
				else
					setText(val, ("%.1f st"):format(v))
				end
			end

			local dragging = false
			local function setFrom(x)
				local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				local v = def.min + rel * (def.max - def.min)
				v = math.floor(v / def.step + 0.5) * def.step
				CFG[def.key] = math.clamp(v, def.min, def.max)
				paint()
			end
			hit.InputBegan:Connect(function(input)
				local t = input.UserInputType
				if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
					dragging = true
					setFrom(input.Position.X)
				end
			end)
