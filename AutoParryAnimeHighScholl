function K.abTick()
    if S.ab.mode == 0 then return end
    if AB.needApply and MOD.lag.state == "ready" and not V.lag.running then
        AB.needApply = false
        K.lagApply()
    end
    local st = K.fpsStats()
    if not st then return end
    local maxStage = (S.ab.mode == 1) and 2 or 4
    AB.low = (st.avg < S.ab.target * 0.85) and (AB.low + 1) or 0
    local now = os.clock()
    if AB.low >= 8 and now >= AB.cool and AB.stage < maxStage then
        AB.stage, AB.cool, AB.low = AB.stage + 1, now + 14, 0
        AB_STAGES[AB.stage][2]()
        AB.needApply = true
        say("warn", "Auto boost naik: tahap " .. AB.stage .. " (" .. AB_STAGES[AB.stage][1] .. ")")
    end
end
