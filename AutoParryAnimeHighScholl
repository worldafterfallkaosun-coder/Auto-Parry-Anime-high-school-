function W.slider(parent, title, mn, mx, step, unit, get, set)
    W.divider(parent)
    local row = new("Frame", { Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1, LayoutOrder = nextLO() }, parent)
    label(row, title, 13, TH.bone, FB, { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, -112, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd })
    local function stepBtn(txt, xoff)
        local b = new("TextButton", { Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, xoff, 0, 7),
            BackgroundColor3 = Color3.fromRGB(40, 36, 62), BackgroundTransparency = 0.2, Text = txt, TextSize = 14, Font = FD, TextColor3 = TH.bone,
            AutoButtonColor = false, BorderSizePixel = 0 }, row)
        corner(b, 7)
        b.MouseButton1Down:Connect(function() tw(b, 0.07, { BackgroundTransparency = 0.6 }) end)
        b.MouseButton1Up:Connect(function() tw(b, 0.12, { BackgroundTransparency = 0.2 }) end)
        return b
    end
    local plus, minus = stepBtn("+", 0), stepBtn("-", -80)
    local vl = label(row, "--", 12, TH.amb, MONO, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 8),
        Size = UDim2.fromOffset(54, 20), TextXAlignment = Enum.TextXAlignment.Center })
    local trk = new("Frame", { Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = WHITE, BackgroundTransparency = 0.86, BorderSizePixel = 0 }, row)
    corner(trk, 3)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, BackgroundColor3 = WHITE }, trk)
    corner(fill, 3)
    local fg = new("UIGradient", {}, fill)
    onTheme(function() fg.Color = ColorSequence.new(TH.brand, TH.brand2) end)
    local halo = new("Frame", { Size = UDim2.fromOffset(28, 28), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = TH.brand, BackgroundTransparency = 0.8, BorderSizePixel = 0 }, trk)
    corner(halo, 14); onTheme(function() halo.BackgroundColor3 = TH.brand end)
    local thumb = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3 }, trk)
    corner(thumb, 8)
    local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 31), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, ZIndex = 4 }, row)
    local dec = step >= 1 and 0 or #(tostring(step):match("%.(%d+)") or "")
    local fmt = "%." .. dec .. "f"
    local dragging, lastV = false, nil
    local function paint(v)
        local pct = math.clamp((v - mn) / (mx - mn), 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        thumb.Position = UDim2.new(pct, 0, 0.5, 0)
        halo.Position = UDim2.new(pct, 0, 0.5, 0)
        vl.Text = string.format(fmt, v) .. unit
    end
    local function fromX(x)
        local w = math.max(trk.AbsoluteSize.X, 1)
        local pct = math.clamp((x - trk.AbsolutePosition.X) / w, 0, 1)
        local v = mn + math.floor(pct * (mx - mn) / step + 0.5) * step
        return tonumber(string.format(fmt, math.clamp(v, mn, mx)))
    end
    local function nudge(dir)
        local v = get()
        if not v then toast("Modul belum siap atau opsi tidak tersedia", "warn"); return end
        local nv = tonumber(string.format(fmt, math.clamp(v + dir * step, mn, mx)))
        paint(nv); set(nv, true)
    end
    plus.Activated:Connect(function() nudge(1) end)
    minus.Activated:Connect(function() nudge(-1) end)
    hit.InputBegan:Connect(function(i)
        if not isPtr(i) then return end
        local pane = row:FindFirstAncestorOfClass("ScrollingFrame")
        if pane then pane.ScrollingEnabled = false end
        dragging = true
        halo.BackgroundTransparency = 0.6
        lastV = fromX(i.Position.X); paint(lastV); set(lastV, false)
        DRAG = {
            move = function(p) lastV = fromX(p.X); paint(lastV); set(lastV, false) end,
            stop = function()
                dragging = false
                halo.BackgroundTransparency = 0.8
                if pane then pane.ScrollingEnabled = true end
                set(lastV, true)
            end,
        }
    end)
    reg(function()
        if dragging then return end
        local v = get()
        if v then paint(v) else vl.Text = "--"; fill.Size = UDim2.new(0, 0, 1, 0); thumb.Position = UDim2.new(0, 0, 0.5, 0); halo.Position = UDim2.new(0, 0, 0.5, 0) end
    end)
end

