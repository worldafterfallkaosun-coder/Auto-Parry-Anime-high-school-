-- LOAD SPEC STYLE (data murni, aman di-require)
----------------------------------------------------------------------
local function tryRequire(inst)
	if typeof(inst) ~= "Instance" or not inst:IsA("ModuleScript") then
		return nil
	end
	local ok, res = pcall(require, inst)
	if ok and type(res) == "table" then
		return res
	end
	return nil
end

local function loadSpecs()
	local ok, gs = pcall(function()
		local m = ReplicatedStorage:WaitForChild("Modules", 10)
		local sh = m and m:WaitForChild("Shared", 10)
		return sh and sh:WaitForChild("GSettings", 10)
	end)
	if not ok or not gs then
		log("GSettings nggak ketemu -> mode fallback (timing konstanta)")
		return
	end

	local cs = tryRequire(gs:FindFirstChild("CombatSettings"))
	if cs then
		SR.ParryWindow = cs.ParryWindow or SR.ParryWindow
		SR.ParryCooldown = cs.ParryCooldown or SR.ParryCooldown
		SR.BlockCooldown = cs.BlockCooldown or SR.BlockCooldown
		SR.GuardBreak = cs.GuardBreakDuration or SR.GuardBreak
		SR.ParryRecovery = cs.ParryAttackerRecovery or SR.ParryRecovery
		SR.RangeTolerance = cs.RangeTolerance or SR.RangeTolerance
		SR.TargetRadius = cs.TargetRadius or SR.TargetRadius
		SR.HitHeight = cs.DefaultHitHeight or SR.HitHeight
		SR.DefaultStyle = cs.DefaultStyle or SR.DefaultStyle
		if type(cs.Dash) == "table" then
			SR.Dash.IFrames = type(cs.Dash.IFrames) == "number" and cs.Dash.IFrames or SR.Dash.IFrames
			SR.Dash.Duration = type(cs.Dash.Duration) == "number" and cs.Dash.Duration or SR.Dash.Duration
			SR.Dash.Cooldown = type(cs.Dash.Cooldown) == "number" and cs.Dash.Cooldown or SR.Dash.Cooldown
		end
	end

	local stat = tryRequire(gs:FindFirstChild("StatSettings"))
	if stat and type(stat.ReachInfluence) == "number" then
		Specs.reachInfl = stat.ReachInfluence
	end

	local fs = gs:FindFirstChild("FightingStyles")
	if fs then
		for _, child in ipairs(fs:GetChildren()) do
			local t = tryRequire(child)
			if t then
				Specs.styles[child.Name] = t
				Specs.count += 1
				local m1 = t.M1
				local sw = type(m1) == "table" and m1.Swings
				if type(sw) == "table" then
					for _, s in ipairs(sw) do
						if type(s) == "table" and type(s.Sound) == "string" then
							Specs.swingSound[s.Sound] = true
						end
					end
				end
			end
		end
	end
	if CFG.Debug then log(("spec kebaca: %d style | parryWindow %.2f | blockCooldown %.2f"):format(Specs.count, SR.ParryWindow, SR.BlockCooldown)) end
end

local function styleOf(char)
	local name = char:GetAttribute("Style")
	if type(name) ~= "string" then
		name = SR.DefaultStyle
	end
	return Specs.styles[name] or Specs.styles[SR.DefaultStyle]
end

