function K.loadMod(key)
    local m = MOD[key]
    m.state, m.t0, m.err = "loading", os.clock(), nil
    if key == "par" then
        pcall(function() if env.__NyxAutoParry and env.__NyxAutoParry.Stop then env.__NyxAutoParry.Stop() end end)
        env.__NyxAutoParry = nil
        AP, CFG13 = nil, nil
        task.spawn(function()
            local ok, e = pcall(__startParry)
            if not ok then m.state, m.err = "missing", tostring(e) end
        end)
        return
    end
    local ld = loadstring or load
    if not ld then m.state, m.err = "missing", "executor tidak punya loadstring"; return end
    local fn, err = ld(SRC[key], "=SIFB_" .. key)
    if not fn then m.state, m.err = "missing", tostring(err); return end
    local before = K.snap(UIS.InputEnded)
    local ok, e = pcall(fn)
    if not ok then m.state, m.err = "missing", tostring(e); return end
    m.ended = K.diff(UIS.InputEnded, before)
end

function K.reattach(key)
    local m = MOD[key]
    m.state, m.t0, m.err = "loading", os.clock(), nil
    if key == "par" then AP, CFG13 = nil, nil
    else LG = { sl = {}, tg = {} }; CFGT.lagcfg = nil end
    log(m.label .. ": menghubungkan ulang…", "warn")
end

function K.revive(key)
    K.reattach(key)
    K.loadMod(key)
end

