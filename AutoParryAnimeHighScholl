            armed = 0; b.Text = text; onYes()
        else
            armed = os.clock() + 3; b.Text = "Yakin? Tekan lagi"
            task.delay(3.05, function()
                if b.Parent and armed ~= 0 and os.clock() >= armed then armed = 0; b.Text = text end
            end)
        end
    end, props)
    return b
end

function W.btnRow(parent, specs)
    local f = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, LayoutOrder = nextLO() }, parent)
    hlist(f, 8)
    local n, total = #specs, 0
    for _, s in ipairs(specs) do total = total + (s[4] or 1) end
    for i, s in ipairs(specs) do
        local w = (s[4] or 1) / total
        local props = { Size = UDim2.new(w, -8 * (n - 1) * w, 1, 0), LayoutOrder = i, TextSize = 12 }
        if s[5] then W.confirm(f, s[1], s[3], props) else W.btn(f, s[1], s[2], s[3], props) end
    end
end

