function W.spark(parent, hist, maxv, colorFn, title, unit)
    local c = W.card(parent)
    local box = new("Frame", { Size = UDim2.new(1, 0, 0, 82), BackgroundTransparency = 1, LayoutOrder = nextLO() }, c)
    label(box, title, 11, TH.mute, FS, { Position = UDim2.fromOffset(0, 9), Size = UDim2.new(0.7, 0, 0, 14) })
    local vl = label(box, "--", 12, TH.bone, FD, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 8), Size = UDim2.new(0.3, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Right })
    local area = new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1 }, box)
    local N, bars = #hist, {}
    for i = 1, N do
        bars[i] = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / N, 0, 1, 0), Size = UDim2.new(1 / N, -1, 0, 2),
            BorderSizePixel = 0, BackgroundColor3 = TH.on }, area)
        corner(bars[i], 1)
    end
    reg(function()
        local last = 0
        for i = 1, N do
            local v = hist[i] or 0
            bars[i].Size = UDim2.new(1 / N, -1, math.clamp(v / maxv, 0.05, 1), 0)
            bars[i].BackgroundColor3 = colorFn(v)
            last = v
        end
        vl.Text = tostring(last) .. unit
    end)
end

