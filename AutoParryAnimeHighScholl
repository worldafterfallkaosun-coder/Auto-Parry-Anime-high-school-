    if cls == "Humanoid" then
        if obj.Parent ~= lp.Character and not touchedHum[obj] then
            touchedHum[obj] = true
            for _, s in ipairs(HUM_STATES) do obj:SetStateEnabled(s, false) end
        end
        return
    end
    if state.texture and (cls == "SpecialMesh" or cls == "SurfaceAppearance" or DECAL[cls]) then
        -- v13.5: tekstur / decal / baju milik karakter (wajah, aksesori, SurfaceAppearance) nggak disentuh
        if protection(obj) == "char" then return end
        if cls == "SpecialMesh" then return pset(obj, "TextureId", "") end
        if cls == "SurfaceAppearance" then return stash(obj) end
        return pset(obj, "Transparency", 1)
    end
    if state.shadow and LIGHT[cls] then return pset(obj, "Enabled", false) end
    if state.fx then
        if FX[cls] then return pset(obj, "Enabled", false) end
        if cls == "SurfaceGui" and protection(obj) ~= "char" then
            return pset(obj, "Enabled", false)
        end
    end
    if state.aggr and (CONSTR[cls] or MOVER[cls] or SELECT[cls] or cls == "ClickDetector")
        and not protection(obj) then
        if CONSTR[cls] then return pset(obj, "Enabled", false) end
        if cls == "ClickDetector" then return pset(obj, "MaxActivationDistance", 0) end
        return stash(obj)
    end
end

