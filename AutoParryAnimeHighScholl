function K.capWatch()
    if not S.bst.unlock then BOOST.capSince, BOOST.capNote = nil, nil; return end
    local target = CAPS[S.bst.cap] or 120
    if target ~= 0 and target <= 60 then BOOST.capNote = "Target 60"; return end
    BOOST.capSince = BOOST.capSince or os.clock()
    local st = K.fpsStats()
    if not st or os.clock() - BOOST.capSince < 8 then return end
    if st.hi <= 64 then
        BOOST.capNote = "Tertahan ~60"
        if not BOOST.capWarned then
            BOOST.capWarned = true
            toast("FPS masih tertahan 60. Kemungkinan dibatasi perangkat atau Roblox, lihat Diagnostik.", "warn")
        end
    else
        BOOST.capNote = "Terbuka ~" .. math.floor(st.hi)
    end
end

