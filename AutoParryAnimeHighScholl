local LOGS = {}
local function hex(c)
    return string.format("#%02x%02x%02x", math.floor(c.R * 255 + .5), math.floor(c.G * 255 + .5), math.floor(c.B * 255 + .5))
end
local function esc(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
local function renderLog()
    if not UI.log then return end
    local out = {}
    for i = 1, math.min(#LOGS, 6) do
        local l = LOGS[i]
        local c = (l.k == "ok" and TH.on) or (l.k == "warn" and TH.amb) or (l.k == "err" and TH.err) or TH.mute
        out[i] = '<font color="' .. hex(c) .. '">' .. l.t .. '</font>  ' .. esc(l.m)
    end
    UI.log.Text = table.concat(out, "\n")
end
local function log(m, kind)
    table.insert(LOGS, 1, { t = os.date("%H:%M:%S"), m = tostring(m), k = kind or "info" })
    while #LOGS > 40 do table.remove(LOGS) end
    renderLog()
end

