    if not OPEN then return end
    UI.bgrad.Rotation = (t * 40) % 360
    UI.tgrad.Offset = Vector2.new(((t * 0.35) % 2.4) - 1.2, 0)
    for _, b in ipairs(UI.blobs) do
        b.f.Position = UDim2.new(0.5 + 0.38 * math.sin(t * b.sp + b.ph), 0, 0.5 + 0.4 * math.cos(t * b.sp * 0.8 + b.ph), 0)
    end
    for i, p in ipairs(UI.parts) do
        p.y = p.y - p.v * dt
        if p.y < -0.03 then p.y = 1.03; p.x = math.random() end
        p.f.Position = UDim2.new(p.x + 0.012 * math.sin(t + i), 0, p.y, 0)
    end
    UI.scan.Position = UDim2.new(0, 0, ((t * 0.18) % 1.5) - 0.25, 0)
    if now > FXT.glitch then
        FXT.glitch = now + 5 + math.random() * 5
