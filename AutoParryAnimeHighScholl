    local api = K.nono()
    if api then
        if name == "FPS Cap (bypass)" then return api.GetCap() end
        if name == "Render Distance" then return api.GetDist() end
        return nil
    end
    local s = LG.sl and LG.sl[name]
    if not s or not s.val then return nil end
    return tonumber(s.val.Text)
