        if SW.running then pcall(swProcess, o) end
    end))
    task.spawn(function()
        local list = workspace:GetDescendants()
        for i = 1, #list do
            if not SW.running then return end
            pcall(swProcess, list[i])
            if i % 400 == 0 then task.wait() end
        end
