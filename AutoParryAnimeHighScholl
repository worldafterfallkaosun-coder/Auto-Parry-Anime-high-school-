    elseif m == "fflag" then
        if not CAP.fflag then return false end
        local ok = pcall(setfflag, "DFIntTaskSchedulerTargetFps", tostring(v))
        pcall(setfflag, "FFlagTaskSchedulerLimitTargetFpsTo2402", "False")
