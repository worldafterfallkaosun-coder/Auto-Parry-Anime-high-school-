function K.capText()
    local r = BOOST.capRes
    if not r then return "belum dipakai" end
    local t = {}
    if r.setfpscap then t[#t + 1] = "setfpscap" end
    if r.fflag then t[#t + 1] = "fflag" end
    if r.usersettings then t[#t + 1] = "setelan" end
    return #t > 0 and table.concat(t, "+") or "tidak ada"
end
